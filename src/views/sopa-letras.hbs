<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/sopa-letras.css" />
  <title>Sopa de Letras Multijugador</title>
  <style>  
  </style>
</head>
<body>
  <!-- El resto del código HTML permanece igual -->
  <div class="page">
    <div class="header">
      <div class="title">🧩 Sopa de Letras Multijugador</div>
      <div class="pill">
        Jugador: <strong>{{#if user}}{{user.username}}{{else}}Invitado{{/if}}</strong>
      </div>
      <button onclick="location.href='/minijuegos'"> ← Regresar</button>
    </div>

    <div class="layout">
      <section class="game card">
        <!-- Contenedor para modo normal -->
        <div id="normal-mode">
          <div class="status panel">
            <div>
              <div class="small">Progreso</div>
              <div id="progressText"><strong>0</strong>/<strong id="totalWords">0</strong> palabras</div>
            </div>
            <div class="badge" id="errorsBadge">0 / 4</div>
          </div>
          
          <div class="controls">
            <label for="categoria-select">Categoría:</label>
            <select id="categoria-select">
              <option>Cargando categorías...</option>
            </select>
            <button id="btnClear">Limpiar selección</button>
            <button id="btnRestart" class="primary">Reiniciar</button>
          </div>
          
          <div id="board" class="board" aria-label="Tablero de sopa de letras"></div>
          <div id="gameMessage" class="message" role="status" aria-live="polite"></div>
        </div>

        <div id="confrontation-mode" style="display: none;">
          <div id="voting-panel" class="panel" style="display: none; text-align: center; margin-bottom: 20px;">
          <h4>Elige la Categoría para el Enfrentamiento</h4>
          <div class="controls" style="justify-content: center;">
            <select id="confrontation-categoria-select">
              <option>Cargando...</option>
            </select>
            <button id="propose-category-btn" class="primary">Proponer</button>
          </div>
        </div>
          <div class="timer-container" id="confrontation-timer">00:00</div>
          <div class="confrontation-boards-container">

            <div class="player-board" id="my-board">
              <div class="player-header">
                <div class="player-name" id="my-name">Tú</div>
                <div class="player-stats">
                  <div class="stat">
                    <div class="stat-value" id="my-words">0</div> <div class="stat-label">Palabras</div>
                  </div>
                  <div class="stat">
                    <div class="stat-value" id="my-errors">0</div> <div class="stat-label">Errores</div>
                  </div>
                </div>
              </div>
              <div id="my-board-grid" class="board"></div>
            </div>
            
            <div class="player-board" id="opponent-board">
              <div class="player-header">
                <div class="player-name" id="opponent-name">Rival</div>
                <div class="player-stats">
                  <div class="stat">
                    <div class="stat-value" id="opponent-words">0</div> <div class="stat-label">Palabras</div>
                  </div>
                  <div class="stat">
                    <div class="stat-value" id="opponent-errors">0</div> <div class="stat-label">Errores</div>
                  </div>
                </div>
              </div>
              <div id="opponent-board-grid" class="board"></div>
            </div>
          </div>
          
          <div id="confrontation-message" class="message" role="status" aria-live="polite"></div>
        </div>

        <aside>
          <div class="panel">
            <h3>Palabras a encontrar</h3>
            <ul id="clues" class="clues"></ul>
          </div>
          <div class="panel">
            <h3>Instrucciones</h3>
            <div class="small">
              • Arrastra el mouse en recta horizontal o vertical.<br>
              • Si no coincide con ninguna palabra, cuenta como error.<br>
              • Con <strong>4 errores</strong> pierdes y el juego se reinicia.
            </div>
          </div>
        </aside>
      </section>

      <aside class="side">
        <div class="panel card" id="jugadores-panel">
          <h3>🟢 Jugadores activos</h3>
          <ul id="lista-jugadores"></ul>
        </div>

        <div class="panel card" id="chat-panel">
          <h3>💬 Chat</h3>
          <div id="chatBox"></div>
          <div class="chat-input">
            <input id="chatInput" type="text" placeholder="Escribe un mensaje…">
            <button id="chatBtn" class="chat-send">Enviar</button>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- Pantalla de resultados (oculta inicialmente) -->
  <div id="results-screen" class="results-screen" style="display: none;">
    <div class="results-content">
      <h2 class="results-title" id="results-title">Resultados del Enfrentamiento</h2>
      <div class="results-stats">
        <div class="result-player" id="result-player1">
          <h3 id="result-name1">Jugador 1</h3>
          <div class="stat">
            <div class="stat-value" id="result-words1">0</div>
            <div class="stat-label">Palabras encontradas</div>
          </div>
          <div class="stat">
            <div class="stat-value" id="result-errors1">0</div>
            <div class="stat-label">Errores</div>
          </div>
        </div>
        <div class="result-player" id="result-player2">
          <h3 id="result-name2">Jugador 2</h3>
          <div class="stat">
            <div class="stat-value" id="result-words2">0</div>
            <div class="stat-label">Palabras encontradas</div>
          </div>
          <div class="stat">
            <div class="stat-value" id="result-errors2">0</div>
            <div class="stat-label">Errores</div>
          </div>
        </div>
        <button id="back-to-lobby" class="primary">Volver al Lobby</button>
        <div id="rematch-controls">
          <button id="rematch-btn" class="primary">⚔️ Revancha</button>
          <button id="back-to-lobby-btn">Ir al Lobby</button>
        </div>
        <div id="rematch-status" style="display: none; margin-top: 15px;"></div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    // El código JavaScript permanece igual
    // ================== CONFIGURACIÓN INICIAL ==================
    const ROWS = 14;
    const COLS = 14;
    const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    const MAX_ERRORS = 4;
    let WORDS = []; // Se cargarán dinámicamente según categoría
    
    // Variables de estado del juego
    let grid = [];
    let cellEls = [];
    let foundWords = new Set();
    let errors = 0;
    let isDragging = false;
    let start = null;
    let dir = null;
    let dragPath = [];
    // AÑADE ESTAS DOS LÍNEAS
    let myCellEls = []; // Guardará solo las celdas de TU tablero para que sea interactivo
    let confrontationMode = false; // Nos dirá si estamos en modo enfrentamiento

    // Variables para el modo enfrentamiento
    let confrontationData = null;
    let timerInterval = null;
    const votingPanel = document.getElementById('voting-panel');
    const confrontationCategoriaSelect = document.getElementById('confrontation-categoria-select');
    const proposeCategoryBtn = document.getElementById('propose-category-btn');

    // Elementos del DOM
    const boardEl = document.getElementById('board');
    const cluesEl = document.getElementById('clues');
    const errorsBadge = document.getElementById('errorsBadge');
    const gameMessage = document.getElementById('gameMessage');
    const btnClear = document.getElementById('btnClear');
    const btnRestart = document.getElementById('btnRestart');
    const totalWords = document.getElementById('totalWords');
    const progressText = document.getElementById('progressText');
    const categoriaSelect = document.getElementById('categoria-select');

    // Elementos del modo enfrentamiento
    const normalModeEl = document.getElementById('normal-mode');
    const confrontationModeEl = document.getElementById('confrontation-mode');
    const timerEl = document.getElementById('confrontation-timer');
    const player1NameEl = document.getElementById('player1-name');
    const player2NameEl = document.getElementById('player2-name');
    const player1WordsEl = document.getElementById('player1-words');
    const player2WordsEl = document.getElementById('player2-words');
    const player1ErrorsEl = document.getElementById('player1-errors');
    const player2ErrorsEl = document.getElementById('player2-errors');
    const boardPlayer1El = document.getElementById('board-player1');
    const boardPlayer2El = document.getElementById('board-player2');
    const confrontationMessageEl = document.getElementById('confrontation-message');
    const resultsScreenEl = document.getElementById('results-screen');
    const backToLobbyBtn = document.getElementById('back-to-lobby');

    // ================== SISTEMA DE CHAT Y SALA ==================
    const socket = io();
    const salaId = "{{salaId}}";
    const usuario = {{{json user}}};
    const chatBox = document.getElementById('chatBox');
    const chatInput = document.getElementById('chatInput');
    const chatBtn = document.getElementById('chatBtn');
    const listaJugadoresEl = document.getElementById('lista-jugadores');

    // Función para mostrar mensajes en el chat
    function mostrarMensaje(user, msg) {
      const msgDiv = document.createElement('div');
      msgDiv.className = 'msg';
      msgDiv.innerHTML = `<span class="u">${user}:</span> <span>${msg}</span>`;
      chatBox.appendChild(msgDiv);
      chatBox.scrollTop = chatBox.scrollHeight;
    }

    // Función para enviar mensajes
    function enviarMensaje() {
      const mensaje = chatInput.value.trim();
      if (mensaje && salaId) {
        socket.emit('mensajeChat', { salaId, mensaje, usuario: usuario.username });
        chatInput.value = '';
      }
    }

    // Event listeners para el chat
    chatBtn.addEventListener('click', enviarMensaje);
    chatInput.addEventListener('keypress', (e) => e.key === 'Enter' && enviarMensaje());

    // Manejo de mensajes entrantes del socket
    socket.on('nuevoMensaje', (data) => {
      if (data.usuario && data.mensaje) mostrarMensaje(data.usuario, data.mensaje);
    });

    // ================== SISTEMA DE INVITACIONES ==================
    async function cargarJugadoresActivos() {
      try {
        const res = await fetch('/competitivo');
        const jugadores = await res.json();
        listaJugadoresEl.innerHTML = '';
        
        jugadores.forEach(jugador => {
          if (jugador.id === usuario.id_usuario) return;
          const item = document.createElement('li');
          item.innerHTML = `
            <span>${jugador.username}</span>
            <div class="actions">
              <button class="btn-invite" data-id="${jugador.id}">Invitar 🤝</button>
              <button class="btn-challenge" data-id="${jugador.id}">Enfrentar ⚔️</button>
            </div>
          `;
          listaJugadoresEl.appendChild(item);
        });
      } catch (error) { 
        console.error('Error al cargar jugadores:', error);
        mostrarMensaje('Sistema', 'Error al cargar lista de jugadores');
      }
    }

    // Manejo de clics en botones de invitación
    // Dentro del <script> de sopa-letras.hbs

// ...

// Manejo de clics en botones de invitación
    listaJugadoresEl.addEventListener('click', async (e) => {
        const target = e.target;
        const idJugador = target.dataset.id;
        if (!idJugador) return;

        try {
            // --- BOTÓN DE INVITAR (a la sala actual) ---
            if (target.classList.contains('btn-invite')) {
                const response = await fetch(`/invitar/${idJugador}`, { // Ruta genérica
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        salaId: salaId, 
                        juego: 'Sopa' // Especificamos el juego
                    })
                });
                const data = await response.json();
                mostrarMensaje('Sistema', data.message || 'Invitación enviada');

            // --- BOTÓN DE ENFRENTAR (crea una sala nueva) ---
            } else if (target.classList.contains('btn-challenge')) {
                const response = await fetch(`/enfrentar/${idJugador}`, { // Ruta genérica
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        juego: 'Sopa' // Especificamos el juego
                    })
                });
                const data = await response.json();
                if (data.salaId) {
                    mostrarMensaje('Sistema', '¡Desafío enviado! Redirigiendo...');
                    setTimeout(() => {
                        window.location.href = `/sopa/${data.salaId}?modo=enfrentamiento`; 
                    }, 1500);
                } else {
                    mostrarMensaje('Sistema', data.message || 'Error al desafiar');
                }
            }
        } catch (error) {
            console.error('Error en acción de jugador:', error);
            mostrarMensaje('Sistema', 'Error al procesar la solicitud');
        }
    });

    // ================== LÓGICA DEL JUEGO ==================
    // Funciones utilitarias
    const inBounds = (r,c) => r>=0 && c>=0 && r<ROWS && c<COLS;
    const randInt = n => Math.floor(Math.random()*n);
    
    const directions = [
      { dr: 0,  dc: 1 },    // →
      { dr: 0,  dc: -1 },   // ←
      { dr: 1,  dc: 0 },    // ↓
      { dr: -1, dc: 0 },    // ↑
      { dr: 1,  dc: 1 },    // diagonal ↓→
      { dr: 1,  dc: -1 },   // diagonal ↓←
      { dr: -1, dc: 1 },    // diagonal ↑→
      { dr: -1, dc: -1 },   // diagonal ↑←
    ];

    function emptyGrid() {
      grid = Array.from({length: ROWS}, () => Array(COLS).fill(""));
    }

    function canPlace(word, r, c, dr, dc) {
      for (let i=0; i<word.length; i++){
        const rr = r + dr*i, cc = c + dc*i;
        if (!inBounds(rr,cc)) return false;
        const cell = grid[rr][cc];
        if (cell !== "" && cell !== word[i]) return false;
      }
      return true;
    }

    function placeWord(word) {
      const tries = 300;
      for (let t=0; t<tries; t++){
        const {dr,dc} = directions[randInt(directions.length)];
        const startR = randInt(ROWS);
        const startC = randInt(COLS);
        if (canPlace(word, startR, startC, dr, dc)) {
          for (let i=0; i<word.length; i++){
            grid[startR + dr*i][startC + dc*i] = word[i];
          }
          return true;
        }
      }
      return false;
    }

    function fillRandom() {
      for (let r=0; r<ROWS; r++){
        for (let c=0; c<COLS; c++){
          if (grid[r][c]==="") grid[r][c] = ALPHABET[randInt(ALPHABET.length)];
        }
      }
    }

    // REEMPLAZA TU FUNCIÓN renderBoard CON ESTA
  function renderBoard(boardElement, gridData, isInteractive) {
    boardElement.innerHTML = "";
    // Usaremos un array temporal para guardar las celdas de este tablero específico
    const currentCellElements = Array.from({ length: ROWS }, () => Array(COLS));

    for (let r = 0; r < ROWS; r++) {
        for (let c = 0; c < COLS; c++) {
            const d = document.createElement('div');
            d.className = 'cell';
            d.textContent = gridData[r][c];
            d.dataset.r = r;
            d.dataset.c = c;

            // SOLO si isInteractive es true, añadimos los eventos para jugar
            if (isInteractive) {
                d.addEventListener('mousedown', (e) => {
                    e.preventDefault();
                    startDrag(r, c);
                });
                d.addEventListener('mouseenter', () => continueDrag(r, c));
            }
            
            boardElement.appendChild(d);
            // Guardamos la referencia a la celda en nuestro array temporal
            currentCellElements[r][c] = d;
        }
    }

    if (isInteractive) {
        // Asignamos las celdas interactivas a la variable global 'myCellEls'
        // para que las funciones de drag and drop funcionen con ellas.
        myCellEls = currentCellElements;
        document.addEventListener('mouseup', endDrag);
        boardElement.addEventListener('dragstart', e => e.preventDefault());
    }
}
    function renderClues() {
      cluesEl.innerHTML = "";
      WORDS.forEach(({word, hint}) => {
        const li = document.createElement('li');
        li.id = `clue-${word}`;
        li.innerHTML = `<div class="word">${word}</div><div class="hint">${hint}</div>`;
        cluesEl.appendChild(li);
      });
      updateClues();
    }

    function updateClues() {
      WORDS.forEach(({word}) => {
        const li = document.getElementById(`clue-${word}`);
        if (li) li.classList.toggle('done', foundWords.has(word));
      });
      progressText.innerHTML = `<strong>${foundWords.size}</strong>/<strong>${WORDS.length}</strong> palabras`;
    }

    function setErrors(n) {
      errors = n;
      errorsBadge.textContent = `${errors} / ${MAX_ERRORS}`;
      errorsBadge.style.background = errors ? '#fee2e2' : '#e5e7eb';
    }

    function message(text, kind='') {
      gameMessage.className = `message ${kind}`;
      gameMessage.textContent = text;
    }

    function clearPathVisual(dragPath) {
        if (dragPath) {
            dragPath.forEach(p => p.el.classList.remove('selected'));
        }
    }

    function startDrag(r, c) {
        if (isDragging) return;
        isDragging = true;
        start = { r, c };
        dir = null;
        clearPathVisual(dragPath);
        dragPath = [];

        const el = myCellEls[r][c];
        if (el.classList.contains('found')) {
            isDragging = false;
            return;
        }
        el.classList.add('selected');
        dragPath.push({ r, c, el, letter: el.textContent });
        if (!confrontationMode) message("");
    }

    function continueDrag(r, c) {
        if (!isDragging || !start) return;

        const drRaw = r - start.r;
        const dcRaw = c - start.c;

        if (drRaw === 0 && dcRaw === 0) return;

        if (!dir) {
            const stepR = drRaw === 0 ? 0 : drRaw / Math.abs(drRaw);
            const stepC = dcRaw === 0 ? 0 : dcRaw / Math.abs(dcRaw);
            dir = { dr: stepR, dc: stepC };
        }

        const expectedSteps = Math.max(
            dir.dr !== 0 ? Math.abs((r - start.r) / dir.dr) : 0,
            dir.dc !== 0 ? Math.abs((c - start.c) / dir.dc) : 0
        );

        if ( (r - start.r) !== (expectedSteps * dir.dr) && (c - start.c) !== (expectedSteps * dir.dc) ) {
            if(Math.abs(drRaw) !== Math.abs(dcRaw) && drRaw !== 0 && dcRaw !== 0) return;
        }

        const length = expectedSteps + 1;
        const maxLen = Math.max(...WORDS.map(w => w.word.length));
        const cappedLen = Math.min(length, maxLen);

        const newPath = [];
        for (let i = 0; i < cappedLen; i++) {
            const rr = start.r + dir.dr * i;
            const cc = start.c + dir.dc * i;
            if (!inBounds(rr, cc)) break;
            
            const el = myCellEls[rr][cc];
            if (el.classList.contains('found')) break;
            newPath.push({ r: rr, c: cc, el, letter: el.textContent });
        }

        clearPathVisual(dragPath);
        dragPath = newPath;
        dragPath.forEach(p => p.el.classList.add('selected'));
    }

    function endDrag() {
        if (!isDragging) return;
        isDragging = false;
        validateDrag();
        start = null;
        dir = null;
    }

    function validateDrag() {
      if (!dragPath || dragPath.length === 0) return;
      
      const text = dragPath.map(p => p.letter).join("");
      const reversedText = [...text].reverse().join("");
      
      // Limpiamos la selección visual inmediatamente
      clearPathVisual(dragPath);

      const palabraEncontrada = WORDS.find(w => w.word === text || w.word === reversedText);

      // Si la palabra seleccionada es una de las palabras del juego
      if (palabraEncontrada) {
          // Verificamos si YA la habíamos encontrado antes para no volver a enviarla
          if (!foundWords.has(palabraEncontrada.word)) {
              // Marcamos visualmente la palabra correcta
              dragPath.forEach(p => p.el.classList.add('found'));
              
              if (confrontationMode) {
                  // Notificamos al servidor del ACIERTO
                  socket.emit('sopa:palabraEncontradaEnfrentamiento', { salaId, usuario, palabra: palabraEncontrada.word });
              } else {
                  // Lógica de modo individual
                  foundWords.add(palabraEncontrada.word);
                  updateClues();
                  message(`¡Encontraste "${palabraEncontrada.word}"! 🎉`, 'win');
                  if (foundWords.size === WORDS.length) {
                      message("🥳 ¡Ganaste! Has encontrado todas las palabras.", 'win');
                  }
              }
          }
      } else {
          // Si la palabra seleccionada NO es correcta
          if (confrontationMode) {
              // Notificamos al servidor del ERROR
              socket.emit('sopa:errorEnfrentamiento', { salaId, usuario });
              // Agregamos un efecto visual de error
              dragPath.forEach(p => p.el.classList.add('error'));
              setTimeout(() => {
                  dragPath.forEach(p => p.el.classList.remove('error'));
              }, 500);

          } else {
              // Lógica de modo individual
              setErrors(errors + 1);
              message(`❌ Selección incorrecta. Te quedan ${MAX_ERRORS - errors} intentos.`, 'lose');
              if (errors >= MAX_ERRORS) {
                  message("💥 ¡Perdiste! Reiniciando la sopa…", 'lose');
                  setTimeout(initGame, 1100);
              }
          }
      }
      dragPath = []; // Reiniciamos el camino al final
  }
    // ================== MODO ENFRENTAMIENTO ==================
    function iniciarEnfrentamiento(data) {
    confrontationMode = true;
    confrontationData = data;

    normalModeEl.style.display = 'none';
    confrontationModeEl.style.display = 'block';
    document.querySelector('.confrontation-boards-container').style.display = 'grid';    
    votingPanel.style.display = 'none'; 
    WORDS = data.palabras;
    renderClues();

    const yoSoyPlayer1 = data.player1.id === usuario.id_usuario;
    const miData = yoSoyPlayer1 ? data.player1 : data.player2;
    const oponenteData = yoSoyPlayer1 ? data.player2 : data.player1;

    // Actualizamos la UI con los nuevos IDs
    document.getElementById('my-name').textContent = miData.username;
    document.getElementById('opponent-name').textContent = oponenteData.username;
    
    const myBoardEl = document.getElementById('my-board-grid');
    const opponentBoardEl = document.getElementById('opponent-board-grid');
    renderBoard(myBoardEl, miData.tablero, true);
    renderBoard(opponentBoardEl, oponenteData.tablero, false);

    document.getElementById('my-board').classList.add('my-turn');
    document.getElementById('opponent-board').classList.add('opponent-turn');
    
    confrontationMessageEl.textContent = "¡Que comience la partida!";
   }


    /**
    * Muestra la pantalla de resultados al final del juego.
    * Ya no necesita lógica compleja, solo recibe los datos y los muestra.
    */
    /**
    * Muestra la pantalla de resultados al final del juego.
    */
    function mostrarResultados(data) {
        document.removeEventListener('mouseup', endDrag); // Desactivamos el drag
        resultsScreenEl.style.display = 'flex';

        // Rellenar datos del Jugador 1
        document.getElementById('result-name1').textContent = data.player1.username;
        document.getElementById('result-words1').textContent = data.player1.palabrasEncontradas.length;
        document.getElementById('result-errors1').textContent = data.player1.errores;
        document.getElementById('result-player1').classList.remove('winner');

        // Rellenar datos del Jugador 2
        document.getElementById('result-name2').textContent = data.player2.username;
        document.getElementById('result-words2').textContent = data.player2.palabrasEncontradas.length;
        document.getElementById('result-errors2').textContent = data.player2.errores;
        document.getElementById('result-player2').classList.remove('winner');

        // Determinar y mostrar al ganador
        const tituloResultados = document.getElementById('results-title');
        tituloResultados.textContent = data.razon || "Resultados del Enfrentamiento";
        
        if (data.ganador) {
            if (data.ganador.id === data.player1.id) {
                document.getElementById('result-player1').classList.add('winner');
            } else {
                document.getElementById('result-player2').classList.add('winner');
            }
        }
    }
        
    
    // Event listener para volver al lobby
    backToLobbyBtn.addEventListener('click', () => {
      window.location.href = '/minijuegos';
    });

    // ================== CONTROL DEL JUEGO ==================
    async function cargarCategorias() {
      try {
        const response = await fetch('/sopa/materias');
        if (!response.ok) throw new Error('No se pudieron cargar categorías');
        const materias = await response.json();
        
        categoriaSelect.innerHTML = '';
        materias.forEach(materia => {
          const option = document.createElement('option');
          option.value = materia.id_materia;
          option.textContent = materia.descripcion;
          categoriaSelect.appendChild(option);
        });
      } catch (error) {
        console.error("Error al cargar categorías:", error);
        categoriaSelect.innerHTML = '<option>Error al cargar categorías</option>';
      }
    }

    async function cargarPalabrasPorCategoria(idMateria) {
      try {
        const response = await fetch(`/sopa/palabras/${idMateria}`);
        if (!response.ok) throw new Error('Error al cargar palabras');
        return await response.json();
      } catch (error) {
        console.error("Error al cargar palabras:", error);
        return [];
      }
    }

    async function initGame() {
      const idMateria = categoriaSelect.value || 1;
      WORDS = await cargarPalabrasPorCategoria(idMateria);
      
      if (WORDS.length === 0) {
        WORDS = [
          { word: "ERROR", hint: "No se pudieron cargar palabras" },
          { word: "CARGA", hint: "Intenta recargar la página" }
        ];
      }

      message("");
      setErrors(0);
      foundWords.clear();
      dragPath = [];
      start = null; dir = null;
      totalWords.textContent = WORDS.length;

      // Generar tablero
      for (let safety=0; safety<60; safety++){
        emptyGrid();
        let ok = true;
        for (const {word} of WORDS) {
          if (!placeWord(word)) { ok = false; break; }
        }
        if (ok) break;
      }
      fillRandom();
      // CAMBIA LA ÚLTIMA LÍNEA DE initGame
      renderBoard(boardEl, grid, true);
      renderClues();
    }

    // ================== EVENT LISTENERS ==================
    btnClear.addEventListener('click', () => {
      clearPathVisual(dragPath);
      dragPath = [];
      start = null; dir = null;
      message("");
    });

    btnRestart.addEventListener('click', initGame);
    categoriaSelect.addEventListener('change', initGame);

    // ================== SOCKET EVENT LISTENERS ==================
    // AÑADE ESTE BLOQUE NUEVO
// ================== SOCKET LISTENERS PARA ENFRENTAMIENTO ==================
      socket.on('sopa:mensajeSistema', (mensaje) => {
    confrontationMessageEl.textContent = mensaje;
    });

    // El juego de enfrentamiento inicia
    // El juego de enfrentamiento inicia
    socket.on('sopa:enfrentamientoIniciado', (data) => {
        console.log('¡Enfrentamiento iniciado! Datos recibidos:', data);

        if (!data || !data.player1 || !data.player2 || !data.palabras) {
            console.error("Error: datos del servidor incompletos.");
            confrontationMessageEl.textContent = "Error al recibir datos del servidor.";
            return;
        }

        // La única responsabilidad de este listener es llamar a la función principal.
        iniciarEnfrentamiento(data);
    });
    socket.on('sopa:eresAnfitrion', async (data) => {
        mostrarMensaje('Sistema', 'Eres el anfitrión. Por favor, elige y propón una categoría para la partida.');
        
        // Cargamos las mismas categorías que en el modo individual
        await cargarCategorias(); 
        // Copiamos las opciones al nuevo select
        confrontationCategoriaSelect.innerHTML = categoriaSelect.innerHTML;
        
        // Mostramos el panel de votación
        votingPanel.style.display = 'block'; 
    });

    // Listener para el botón "Proponer"
    proposeCategoryBtn.addEventListener('click', () => {
        const idMateria = confrontationCategoriaSelect.value;
        const materiaTexto = confrontationCategoriaSelect.options[confrontationCategoriaSelect.selectedIndex].text;
        
        // Enviamos la propuesta al servidor
        socket.emit('sopa:proponerCategoria', { salaId, idMateria, materiaTexto });
        votingPanel.style.display = 'none'; // Ocultamos el panel una vez propuesta
    });

    // El servidor envía una propuesta de categoría al chat para que el invitado vote
    socket.on('sopa:propuestaRecibida', ({ proponente, materiaTexto, idMateria }) => {
        const mensajeVotacion = document.createElement('div');
        mensajeVotacion.classList.add('msg');

        // Si yo soy el proponente, solo veo el texto.
        if (proponente.id === usuario.id_usuario) {
            mensajeVotacion.innerHTML = `<span class="u">Sistema:</span> <span>Has propuesto la categoría <strong>${materiaTexto}</strong>. Esperando respuesta del rival...</span>`;
        } else {
            // Si soy el invitado, veo los botones para votar.
            mensajeVotacion.innerHTML = `
                <span class="u">Sistema:</span>
                <span>${proponente.username} ha propuesto jugar en la categoría <strong>${materiaTexto}</strong>. ¿Aceptas?</span>
                <div class="vote-buttons" style="margin-top: 8px; display: flex; gap: 8px;">
                    <button class="btn-vote-yes" data-materia="${idMateria}">Sí, ¡juguemos!</button>
                    <button class="btn-vote-no">No, proponer otra.</button>
                </div>
            `;
        }
        chatBox.appendChild(mensajeVotacion);
        chatBox.scrollTop = chatBox.scrollHeight;
    });

    // Lógica para los clics en los botones de votación (usando delegación de eventos)
    chatBox.addEventListener('click', (e) => {
        if (e.target.classList.contains('btn-vote-yes')) {
            const idMateria = e.target.dataset.materia;
            socket.emit('sopa:votar', { salaId, voto: 'si', idMateria });
            // Deshabilitar botones después de votar
            e.target.parentElement.innerHTML = '<span>¡Voto enviado!</span>';
        }
        if (e.target.classList.contains('btn-vote-no')) {
            socket.emit('sopa:votar', { salaId, voto: 'no' });
            e.target.parentElement.innerHTML = '<span>Has rechazado la categoría.</span>';
        }
    });

    // El servidor informa que el voto fue rechazado
    socket.on('sopa:propuestaRechazada', () => {
        mostrarMensaje('Sistema', 'Tu rival ha rechazado la categoría. Por favor, propón una diferente.');
        // El anfitrión verá el panel de nuevo (el servidor se lo indicará con 'sopa:eresAnfitrion')
    });
    // Actualización del timer
    socket.on('sopa:tick', ({ tiempoRestante }) => {
        const minutos = Math.floor(tiempoRestante / 60);
        const segundos = tiempoRestante % 60;
        timerEl.textContent = `${minutos.toString().padStart(2, '0')}:${segundos.toString().padStart(2, '0')}`;
    });

    // El estado del juego se actualiza (alguien encontró una palabra o cometió un error)
    socket.on('sopa:actualizarEnfrentamiento', (data) => {
    const yoSoyPlayer1 = data.player1.id === usuario.id_usuario;
    const miData = yoSoyPlayer1 ? data.player1 : data.player2;
    const oponenteData = yoSoyPlayer1 ? data.player2 : data.player1;

    // Actualizar mis estadísticas
    document.getElementById('my-words').textContent = miData.palabrasEncontradas.length;
    document.getElementById('my-errors').textContent = miData.errores;

    // Actualizar estadísticas del oponente
    document.getElementById('opponent-words').textContent = oponenteData.palabrasEncontradas.length;
    document.getElementById('opponent-errors').textContent = oponenteData.errores;

    // Actualiza mi lista de palabras tachadas
    foundWords = new Set(miData.palabrasEncontradas);
    updateClues();
    });
    // El juego termina
    socket.on('sopa:enfrentamientoFinalizado', (data) => {
        document.removeEventListener('mouseup', endDrag); // Desactiva el juego
        
        // Actualizamos los datos de la pantalla de resultados
        document.getElementById('result-name1').textContent = data.player1.username;
        document.getElementById('result-words1').textContent = data.player1.palabrasEncontradas.length;
        document.getElementById('result-errors1').textContent = data.player1.errores;

        document.getElementById('result-name2').textContent = data.player2.username;
        document.getElementById('result-words2').textContent = data.player2.palabrasEncontradas.length;
        document.getElementById('result-errors2').textContent = data.player2.errores;
        
        // Mostramos el ganador
        const tituloResultados = document.getElementById('results-title');
        if (data.ganador) {
            tituloResultados.textContent = `¡El ganador es ${data.ganador.username}!`;
            if(data.ganador.id === data.player1.id) {
                document.getElementById('result-player1').classList.add('winner');
            } else {
                document.getElementById('result-player2').classList.add('winner');
            }
        } else {
            tituloResultados.textContent = "¡Es un empate!";
        }
        
        resultsScreenEl.style.display = 'flex';
    });

    // El oponente se desconecta
    socket.on('sopa:oponenteDesconectado', ({ ganador }) => {
        document.removeEventListener('mouseup', endDrag);
        confrontationMessageEl.textContent = `Tu oponente se ha desconectado. ¡Has ganado!`;
        confrontationMessageEl.className = 'message win';
        // Podrías mostrar la pantalla de resultados también si quieres
    });

    // ================== INICIALIZACIÓN ==================
    // ================== INICIALIZACIÓN ==================
    // ================== INICIALIZACIÓN (VERSIÓN FINAL) ==================
    document.addEventListener('DOMContentLoaded', async () => {
    const urlParams = new URLSearchParams(window.location.search);
    const esEnfrentamiento = urlParams.get('modo') === 'enfrentamiento';
    const idMateria = urlParams.get('materia') || 1;
    // EN: sopa-letras.hbs (dentro de DOMContentLoaded)

    // --- LÓGICA DE REVANCHA ---
    const rematchControls = document.getElementById('rematch-controls');
    const rematchBtn = document.getElementById('rematch-btn');
    const rematchStatus = document.getElementById('rematch-status');
    const backToLobbyBtn = document.getElementById('back-to-lobby-btn');

    rematchBtn.addEventListener('click', () => {
        socket.emit('sopa:solicitarRevancha', { salaId, usuario });
        rematchControls.style.display = 'none';
        rematchStatus.style.display = 'block';
        rematchStatus.textContent = 'Solicitud de revancha enviada. Esperando al oponente...';
    });

    backToLobbyBtn.addEventListener('click', () => {
        window.location.href = '/minijuegos';
    });

    // Listener para cuando el OTRO jugador pide revancha
    socket.on('sopa:revanchaSolicitada', ({ solicitante }) => {
        rematchControls.style.display = 'none';
        rematchStatus.style.display = 'block';

        if (solicitante.id !== usuario.id_usuario) {
            rematchStatus.innerHTML = `
                <span>${solicitante.username} quiere la revancha. ¿Aceptas?</span>
                <div class="vote-buttons" style="margin-top: 10px; display: flex; gap: 10px; justify-content: center;">
                    <button id="accept-rematch-btn" class="primary">Aceptar</button>
                    <button id="reject-rematch-btn">Rechazar</button>
                </div>
            `;
        }
    });

    // Listener para manejar los botones de Aceptar/Rechazar revancha
    resultsScreenEl.addEventListener('click', (e) => {
        if (e.target.id === 'accept-rematch-btn') {
            socket.emit('sopa:responderRevancha', { salaId, respuesta: 'aceptada' });
            rematchStatus.textContent = '¡Revancha aceptada! Reiniciando...';
        }
        if (e.target.id === 'reject-rematch-btn') {
            socket.emit('sopa:responderRevancha', { salaId, respuesta: 'rechazada' });
            rematchStatus.textContent = 'Has rechazado la revancha.';
        }
    });

    socket.on('sopa:revanchaRechazada', () => {
        rematchStatus.textContent = 'Tu oponente ha rechazado la revancha.';
        setTimeout(() => {
            rematchControls.style.display = 'flex';
            rematchStatus.style.display = 'none';
        }, 3000);
    });

    socket.on('sopa:reiniciarParaVotacion', () => {
        // Reseteamos la UI para volver a la fase de votación
        resultsScreenEl.style.display = 'none';
        rematchControls.style.display = 'flex';
        rematchStatus.style.display = 'none';
        
        // Ocultamos los tableros viejos
        document.querySelector('.confrontation-boards-container').style.display = 'none';
        
        // Limpiamos el mensaje viejo y dejamos un mensaje neutral de espera
        confrontationMessageEl.textContent = ""; 
        
        // El servidor enviará 'sopa:eresAnfitrion' para reiniciar el flujo
    });

    // --- PASO 1: UNIRSE AL CHAT DE LA SALA ---
    // Esto se hace siempre, una sola vez, para evitar mensajes duplicados.
    socket.emit('chat:unirse', { salaId, usuario: usuario.username });
    mostrarMensaje('Sistema', `¡Bienvenido, ${usuario.username}!`);
    chatBtn.addEventListener('click', enviarMensaje);
    chatInput.addEventListener('keypress', (e) => e.key === 'Enter' && enviarMensaje());

    if (esEnfrentamiento) {
        // --- MODO ENFRENTAMIENTO ---
        confrontationMode = true;
        normalModeEl.style.display = 'none';
        confrontationModeEl.style.display = 'block';
        if(document.getElementById('jugadores-panel')) {
            document.getElementById('jugadores-panel').style.display = 'none';
        }
        confrontationMessageEl.textContent = "Buscando oponente...";
        
        // El cliente se une a la partida, el servidor decidirá quién es el anfitrión
        socket.emit('sopa:unirseEnfrentamiento', { salaId, usuario });

    } else {
        // --- MODO INDIVIDUAL ---
        confrontationMode = false;
        await cargarCategorias();
        await initGame();
        await cargarJugadoresActivos();
        setInterval(cargarJugadoresActivos, 15000);

        // Listeners de botones exclusivos del modo individual
        btnClear.addEventListener('click', () => {
             clearPathVisual(dragPath);
             dragPath = [];
        });
        btnRestart.addEventListener('click', initGame);
        categoriaSelect.addEventListener('change', initGame);
        
        // --- PASO 2: UNIRSE A LA PARTIDA INDIVIDUAL ---
        // Descomentamos esta línea para que el modo individual también se registre en el servidor
        socket.emit('sopa:unirseIndividual', { salaId, usuario, idMateria });
    }
    });
  </script>
</body>
</html>