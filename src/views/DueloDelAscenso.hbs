<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Duelos de Ascenso</title>
</head>
<body>

<div id="rankingGlobalContainer"></div>

<script>
    const user = {{{json user}}};
    const rankingGlobalContainer = document.getElementById('rankingGlobalContainer');

    document.addEventListener('click', async (e) => {
    if (e.target && e.target.tagName === 'BUTTON' && e.target.dataset.id) {
        const idOponente = e.target.dataset.id;

        // Preguntar materia
        const materia = prompt("¿Qué materia quieres para el desafío?");
        if (!materia) return;

        // Tiempo límite fijo de 2 días (en horas o fecha)
        const tiempoLimite = 2 * 24 * 60 * 60; // 2 días en segundos

        e.target.disabled = true;
        e.target.textContent = 'Enviado...';

        try {
            await fetch(`/desafiar/duelo/${idOponente}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ materia, tiempoLimite })
            });
        } catch (error) {
            console.error("Error al enviar desafío:", error);
            e.target.disabled = false;
            e.target.textContent = 'Desafiar ⚔️';
        }
    }
});

    function renderizarRanking(container, jugadores) {
            container.innerHTML = '';
            if (!jugadores || jugadores.length === 0) {
                container.innerHTML = '<p>No hay jugadores en este ranking.</p>';
                return;
            }

            // Ordenar jugadores de mayor a menor puntos
            jugadores.sort((a, b) => b.puntos - a.puntos);

            // Encontrar tu posición
            const miIndex = jugadores.findIndex(j => j.id_usuario === user.id_usuario);

            jugadores.forEach((jugador, i) => {
                const item = document.createElement('div');
                item.innerHTML = `
                    <img src="${jugador.foto_perfil || '/media/images/default_avatar.png'}" alt="Avatar" width="40">
                    <strong>${jugador.username}</strong>
                    <span>${jugador.puntos} puntos</span>
                    ${i < miIndex ? `<button data-id="${jugador.id_usuario}">Desafiar ⚔️</button>` : ''}
                `;
                container.appendChild(item);
            });
        }


    async function cargarRankingGlobal() {
        const response = await fetch('/api/ranking/global');
        const jugadores = await response.json();
        renderizarRanking(rankingGlobalContainer, jugadores);
    }

    document.addEventListener('click', async (e) => {
        if (e.target && e.target.tagName === 'BUTTON' && e.target.dataset.id) {
            e.target.disabled = true;
            e.target.textContent = 'Enviado...';
            const idOponente = e.target.dataset.id;
            try {
                await fetch(`/desafiar/duelo/${idOponente}`, { method: 'POST' });
            } catch (error) {
                console.error("Error al enviar desafío:", error);
                e.target.disabled = false;
                e.target.textContent = 'Desafiar ⚔️';
            }
        }
    });

    document.addEventListener('DOMContentLoaded', async () => {
        cargarRankingGlobal();
    });
</script>

</body>
</html>