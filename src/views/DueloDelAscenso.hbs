<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Duelos de Ascenso</title>
    <link rel="stylesheet" href="/css/DueloDelAscenso.css">
</head>
<body>

<h2>🏆 Ranking Global</h2>
<div id="rankingGlobalContainer"></div>

<h2>🎓 Ranking por Carrera</h2>
<div id="rankingCarreraContainer"></div>

<button onclick="location.href='/matchmaking'">Matchmaking</button>

<script>
    const user = {{{json user}}}; // Asegúrate de que user incluye id_carrera
    console.log('DEBUG user →', user);
    const rankingGlobalContainer = document.getElementById('rankingGlobalContainer');
    const rankingCarreraContainer = document.getElementById('rankingCarreraContainer');

    // -----------------------
    // Función para renderizar cualquier ranking
    // -----------------------
    function renderizarRanking(container, jugadores) {
        container.innerHTML = '';
        if (!jugadores || jugadores.length === 0) {
            container.innerHTML = '<p>No hay jugadores en este ranking.</p>';
            return;
        }

        jugadores.sort((a, b) => b.puntos - a.puntos);
        const miIndex = jugadores.findIndex(j => j.id_usuario === user.id_usuario);

        jugadores.forEach((jugador, i) => {
            const item = document.createElement('div');
            item.innerHTML = `
                <img src="${jugador.foto_perfil || '/media/images/default_avatar.png'}" alt="Avatar" width="40">
                <strong>${jugador.username}</strong>
                <span>${jugador.puntos} pts</span>
                ${i < miIndex ? `<button data-id="${jugador.id_usuario}">Desafiar ⚔️</button>` : ''}
            `;
            container.appendChild(item);
        });
    }

    // -----------------------
    // Cargar ranking global
    // -----------------------
    async function cargarRankingGlobal() {
        try {
            const response = await fetch('/api/ranking/global');
            const jugadores = await response.json();
            renderizarRanking(rankingGlobalContainer, jugadores);
        } catch (err) {
            console.error('Error cargando ranking global:', err);
        }
    }

    // -----------------------
    // Cargar ranking por carrera
    // -----------------------
    async function cargarRankingCarrera() {
        try {
            if (!user.id_carrera) {
                rankingCarreraContainer.innerHTML = '<p>No tienes carrera asignada.</p>';
                return;
            }
            const response = await fetch(`/api/ranking/carrera/${user.id_carrera}`);
            const jugadores = await response.json();
            renderizarRanking(rankingCarreraContainer, jugadores);
        } catch (err) {
            console.error('Error cargando ranking por carrera:', err);
        }
    }

    // -----------------------
    // Listener para desafíos
    // -----------------------
    document.addEventListener('click', async (e) => {
        if (e.target && e.target.tagName === 'BUTTON' && e.target.dataset.id) {
            const idOponente = e.target.dataset.id;
            e.target.disabled = true;
            e.target.textContent = 'Enviado...';

            try {
                const res = await fetch(`/desafiar/duelo/${idOponente}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tiempoLimite: 2 * 24 * 60 * 60 }) // 2 días
                });
                const data = await res.json();
                console.log("Respuesta del servidor:", data);
            } catch (error) {
                console.error("Error al enviar desafío:", error);
                e.target.disabled = false;
                e.target.textContent = 'Desafiar ⚔️';
            }
        }
    });

    // -----------------------
    // Inicialización
    // -----------------------
    document.addEventListener('DOMContentLoaded', () => {
        cargarRankingGlobal();
        cargarRankingCarrera();
    });
</script>

</body>
</html>
