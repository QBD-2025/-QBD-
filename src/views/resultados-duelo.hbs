<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados del Duelo</title>
    <style>
        .resultado-container { max-width: 800px; margin: 0 auto; padding: 20px; }
        .puntajes { display: flex; justify-content: space-between; margin: 20px 0; }
        .puntaje-card { background: #f8f9fa; padding: 15px; border-radius: 8px; text-align: center; }
        .pregunta-resultado { background: white; border: 1px solid #ddd; margin: 10px 0; padding: 15px; border-radius: 8px; }
        .respuesta-correcta { color: #28a745; font-weight: bold; }
        .respuesta-incorrecta { color: #dc3545; }
        .esperando { background: #fff3cd; border: 1px solid #ffeaa7; padding: 15px; border-radius: 8px; text-align: center; margin: 20px 0; }
        .oponente-pendiente { color: #6c757d; font-style: italic; }
        .btn-volver { background: #007bff; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; }
    </style>
</head>
<body>
    <div class="resultado-container">
        <h1>Resultados del Duelo</h1>
        
        <!-- Información del duelo -->
        <div class="info-duelo">
            <h3>{{#if esRetador}}
                Duelo: Tú vs {{duelo.defensor_username}}
            {{else}}
                Duelo: {{duelo.retador_username}} vs Tú
            {{/if}}</h3>
        </div>

        <!-- Puntajes -->
        <div class="puntajes">
            <div class="puntaje-card">
                <h4>Tu puntaje</h4>
                <div class="puntaje-numero">{{miPuntaje}}/10</div>
            </div>
            
            <div class="puntaje-card">
                <h4>{{nombreOponente}}</h4>
                <div class="puntaje-numero">
                    {{#if ambosTerminaron}}
                        {{oponentePuntaje}}/10
                    {{else}}
                        <span class="oponente-pendiente">En progreso...</span>
                    {{/if}}
                </div>
            </div>
        </div>

        {{#unless ambosTerminaron}}
        <div class="esperando">
            <h4>⏳ Esperando a {{nombreOponente}}</h4>
            <p>Tu oponente aún está realizando el examen. Los resultados completos aparecerán cuando termine.</p>
            <p>Puedes cerrar esta página y volver más tarde, o esperar aquí.</p>
        </div>
        {{/unless}}

        <!-- Resultados por pregunta -->
        <h3>Detalle de respuestas</h3>
        {{#each respuestas}}
        <div class="pregunta-resultado">
            <h4>Pregunta {{this.id_pregunta}}</h4>
            <p><strong>{{this.pregunta}}</strong></p>
            
            <div class="respuestas-comparacion">
                <div class="mi-respuesta">
                    <strong>Tu respuesta:</strong> 
                    <span class="{{#if this.mi_correcta}}respuesta-correcta{{else}}respuesta-incorrecta{{/if}}">
                        Opción {{this.mi_respuesta}} 
                        {{#if this.mi_correcta}}✓ Correcta{{else}}✗ Incorrecta{{/if}}
                    </span>
                </div>
                
                <div class="oponente-respuesta">
                    <strong>{{../nombreOponente}}:</strong> 
                    {{#if ../ambosTerminaron}}
                        {{#if this.oponente_respuesta}}
                            <span class="{{#if this.oponente_correcta}}respuesta-correcta{{else}}respuesta-incorrecta{{/if}}">
                                Opción {{this.oponente_respuesta}} 
                                {{#if this.oponente_correcta}}✓ Correcta{{else}}✗ Incorrecta{{/if}}
                            </span>
                        {{else}}
                            <span class="oponente-pendiente">No respondió</span>
                        {{/if}}
                    {{else}}
                        <span class="oponente-pendiente">Esperando respuesta...</span>
                    {{/if}}
                </div>
            </div>
        </div>
        {{/each}}

        {{#if ambosTerminaron}}
        <div class="resultado-final">
            <h3>Resultado Final</h3>
            {{#if (eq miPuntaje oponentePuntaje)}}
                <h4 style="color: #ffc107;">¡Empate! Ambos obtuvieron {{miPuntaje}} puntos</h4>
                <p>Ambos jugadores obtienen 10 puntos de bonificación.</p>
            {{else}}
                {{#if (gt miPuntaje oponentePuntaje)}}
                    <h4 style="color: #28a745;">¡Ganaste! {{miPuntaje}} vs {{oponentePuntaje}}</h4>
                    <p>Has ganado 20 puntos por tu victoria.</p>
                {{else}}
                    <h4 style="color: #dc3545;">Perdiste: {{miPuntaje}} vs {{oponentePuntaje}}</h4>
                    <p>Mejor suerte la próxima vez. Sigue practicando.</p>
                {{/if}}
            {{/if}}
        </div>
        {{/if}}

        <!-- Botón para volver -->
        <div style="text-align: center; margin-top: 30px;">
            <button class="btn-volver" onclick="volverAlPortal()">
                Volver al Portal de Duelos
            </button>
        </div>
    </div>

    <script>
        // Auto-actualizar página si el oponente no ha terminado
        {{#unless ambosTerminaron}}
        let contadorRecargas = 0;
        const maxRecargas = 20; // Máximo 20 recargas (10 minutos)
        
        function verificarEstado() {
            contadorRecargas++;
            if (contadorRecargas > maxRecargas) {
                console.log('Dejando de recargar automáticamente');
                return;
            }
            
            fetch(`/competitivo/duelo/estado/{{duelo.id_duelo}}`)
                .then(response => response.json())
                .then(data => {
                    if (data.ambosCompletaron) {
                        location.reload(); // Recargar para mostrar resultados completos
                    } else {
                        // Esperar 30 segundos antes de verificar de nuevo
                        setTimeout(verificarEstado, 30000);
                    }
                })
                .catch(error => {
                    console.error('Error verificando estado:', error);
                    // Intentar de nuevo en 1 minuto si hay error
                    setTimeout(verificarEstado, 60000);
                });
        }
        
        // Iniciar verificación después de 30 segundos
        setTimeout(verificarEstado, 30000);
        {{/unless}}

        function volverAlPortal() {
            window.location.href = '/portal';
        }
        
        // Helpers para las comparaciones en el template (solo client-side)
        {{#if ambosTerminaron}}
        // Estos helpers funcionan solo en el cliente para las comparaciones finales
        function eq(a, b) { return a === b; }
        function gt(a, b) { return a > b; }
        {{/if}}
    </script>
</body>
</html>