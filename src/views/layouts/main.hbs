<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>QueBuenDato.com.mx</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.4/gsap.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap" rel="stylesheet">
</head>
<body>

    {{!-- Cabecera Global --}}
    <div class="global-header-elements">
        <div class="top-left-logo">
            {{#if user}}
                <a href="/menu_principal"><img src="/media/images/logo.png" alt="¡Que Buen Dato!" class="logo-image"></a>
            {{else}}
                <a href="/"><img src="/media/images/logo.png" alt="¡Que Buen Dato!" class="logo-image"></a>
            {{/if}}
            <a href="/conocenos" class="header-button">Conócenos</a>
        </div>
        <div class="top-right-nav">
            {{#if user}}
                <span class="nav-username">Hola, {{user.username}}</span>
                <div class="notification-container">
                    🔔 <span id="notification-count" style="display:none;"></span>
                </div>
                <div class="notification-dropdown" id="notification-list" style="display:none;">
                    <ul id="notifications-ul"><li>Cargando...</li></ul>
                </div>
                <div class="kebab-menu">
                    <button class="kebab-button">&#8942;</button>
                    <ul class="kebab-dropdown">
                        <li><a href="/menu_principal">Menu Principal</a></li>
                        <li><a href="/usuario">Mi cuenta</a></li>
                        {{#if (eq user.id_tp_usuario 3)}}
                            <li><a href="/admin">Permisos</a></li>
                            <li><a href="/editor">Editor</a></li>
                        {{/if}}
                        {{#if (eq user.id_tp_usuario 2)}}
                            <li><a href="/editor">Editor</a></li>
                        {{/if}}
                        <li><a href="/logout" class="cerrar-sesion">Cerrar sesión</a></li>
                    </ul>
                </div>
            {{else}}
                <a href="/login" class="header-link">Iniciar Sesión</a>
            {{/if}}
        </div>
    </div>

    {{{body}}}

    <div class="bottom-left-dot"></div>
    <audio id="musica" loop src="/Audio/bby_no.mp3"></audio>

<script src="/socket.io/socket.io.js"></script>
<script>
    // ✅ FUNCIONES GLOBALES (para que el HTML las encuentre)
   // --- FUNCIONES GLOBALES (para que el HTML las encuentre) ---
    function toggleNotifications(event) {
        event.stopPropagation();
        const list = document.getElementById("notification-list");
        if (list) list.style.display = (list.style.display === "block") ? "none" : "block";
    }

    async function cargarNotificaciones() {
        try {
            const response = await fetch('/notificaciones');
            const data = await response.json();
            const ul = document.getElementById("notifications-ul");
            if (!ul) return;
            ul.innerHTML = data.length === 0 ? "<li>No tienes notificaciones</li>" : "";
            data.forEach(notif => {
                const li = document.createElement('li');
                if (notif.tipo === 'invitacion' || notif.tipo === 'desafio_duelo') {
                    li.innerHTML = `<span>${notif.mensaje}</span><button class="btn-aceptar" data-id="${notif.id_notificacion}">Aceptar</button>`;
                } else {
                    li.innerHTML = `<span>${notif.mensaje}</span>`;
                }
                ul.appendChild(li);
            });
            const countEl = document.getElementById("notification-count");
            if(countEl) {
                countEl.style.display = data.length > 0 ? "inline" : "none";
                countEl.innerText = data.length;
            }
        } catch (error) { console.error("Error al cargar notificaciones:", error); }
    }

    // ✅ CÓDIGO ORGANIZADO (se ejecuta cuando el HTML está listo)
    document.addEventListener('DOMContentLoaded', function() {
        
        // --- Lógica de UI (GSAP y clics de menús) ---
        const kebabButton = document.querySelector('.kebab-button');
        if (kebabButton) {
            gsap.set('.kebab-dropdown li', { opacity: 0, y: -15 });
            kebabButton.addEventListener('click', function(e) {
                e.stopPropagation();
                document.getElementById('notification-list').style.display = 'none';
                const menu = this.parentElement;
                const isActive = menu.classList.toggle('active');
                gsap.to('.kebab-dropdown', { opacity: isActive ? 1 : 0, duration: 0.2 });
                gsap.to('.kebab-dropdown li', { opacity: isActive ? 1 : 0, y: isActive ? 0 : -15, stagger: 0.1, duration: 0.3 });
            });
        }
        document.querySelector('.notification-container')?.addEventListener('click', toggleNotifications);
        document.addEventListener('click', () => {
            const activeMenu = document.querySelector('.kebab-menu.active');
            if (activeMenu) activeMenu.classList.remove('active');
            const notifList = document.getElementById('notification-list');
            if(notifList) notifList.style.display = 'none';
        });
        document.querySelector('.kebab-dropdown')?.addEventListener('click', e => e.stopPropagation());
        document.getElementById('notification-list')?.addEventListener('click', e => e.stopPropagation());

        // --- LÓGICA DE SOCKETS Y NOTIFICACIONES (Solo para usuarios logueados) ---
        {{#if user}}
            const socket = io();

            // 1. Listener para ACEPTAR cualquier notificación
            document.getElementById('notifications-ul')?.addEventListener('click', async (event) => {
                if (event.target.classList.contains('btn-aceptar')) {
                    const notifId = event.target.dataset.id;
                    try {
                        const response = await fetch(`/aceptar/${notifId}`, { method: 'POST' });
                        const data = await response.json();
                        if (data.success) {
                            if (data.tipo === 'desafio_duelo') {
                                // AVISAMOS AL SERVIDOR QUE ACEPTAMOS EL DUELO
                                socket.emit('duelo:aceptarDesafio', { id_retador: data.id_remitente });
                            } else if (data.tipo === 'invitacion') {
                                // REDIRIGIMOS A MINIJUEGOS (esto ya funcionaba)
                                window.location.href = `/${data.extra_data.juego}/${data.extra_data.salaId}`;
                            }
                        } else {
                            alert(data.message || 'No se pudo aceptar.');
                        }
                    } catch (error) { console.error("Error al aceptar:", error); }
                }
            });

            // ✅ 2. Listener GLOBAL para la orden de redirección del Duelo de Ascenso
            // Este evento lo reciben AMBOS jugadores, estén donde estén.
            socket.on('duelo:iniciarDesafio', ({ salaId }) => {
                //alert('¡Desafío aceptado! Redirigiendo a la sala del duelo...');
                window.location.href = `/competitivo/duelo/enfrentamiento/${salaId}`;
            });

            // 3. Listener para que la campanita se actualice en tiempo real
            socket.on('notificacion_recibida', () => {
                cargarNotificaciones(); 
            });
            
            // Cargar notificaciones al inicio y periódicamente
            cargarNotificaciones();
            setInterval(cargarNotificaciones, 5000);
        {{/if}}
    });
</script>
</body>
</html>