<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QueBuenDato.com.mx</title>
  <link rel="stylesheet" href="/css/formulario1.css" />
</head>
<body class="page-usuario">
  <div class="main-form-container">
  <div class="image-column"></div> <!-- Columna oculta -->
  <div class="form-column">
    <form action="/procesar-formulario" method="POST">
      {{#each preguntas}}
        <div class="pregunta">
          <p><strong>{{pregunta}}</strong></p>
          {{#each opciones}}
            <label>
              <input type="radio" name="respuesta_{{../id_pregunta}}" value="{{id_opcion}}" required />
              {{texto_opcion}}
            </label>
          {{/each}}
        </div>
        <hr>
      {{/each}}

      <button type="submit" class="button">Siguiente</button>
    </form>
  </div>
</div>
</body>
</html>
  