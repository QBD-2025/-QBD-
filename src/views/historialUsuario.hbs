<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Historial de Exámenes</title>
  <link rel="stylesheet" href="/css/historialUsuario.css">
</head>
<body>
  <header class="header">
    <h1>📜 Historial de Exámenes</h1>
    <a href="/usuario" class="btn-volver">⬅ Volver al Perfil</a>
  </header>

  {{#if historial.length}}
  <table class="tabla-historial">
    <thead>
      <tr>
        <th>#</th>
        <th>Examen</th>
        <th>Puntaje</th>
        <th>Porcentaje</th> <th>Fecha</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      {{#each historial}}
        <tr>
          <td>{{@index}}</td>
          <td>{{materia}}</td>
          <td>{{puntos}} / {{total}}</td>
          <td><strong>{{porcentaje}}%</strong></td> <td>{{fecha}}</td>
          <td><a href="/usuario/historial/{{id_examen}}" class="btn-ver">Ver resumen</a></td>
        </tr>
      {{/each}}
    </tbody>
  </table>
{{else}}
  <p class="no-datos">No tienes exámenes realizados todavía.</p>
{{/if}}

</body>
</html>