<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ranking - QueBuenDato</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/ranking.css">
    <style>
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1><i class="fas fa-trophy"></i> Ranking</h1>
            <p>Clasificación de los mejores jugadores según sus puntos totales</p>
        </header>
        
        <div class="podium-section">
            <h2 class="section-title"><i class="fas fa-medal"></i> Top Jugadores</h2>
            <div class="podium">
                {{#if usuarios.length}}
                    {{#with usuarios.[0]}}
                    <div class="podium-item">
                        <div class="podium-badge">🥇</div>
                        {{#if foto_perfil}}
                            <img src="{{foto_perfil}}" alt="{{username}}" class="podium-avatar">
                        {{else}}
                            <div class="podium-avatar">{{apodo.[0]}}</div>
                        {{/if}}
                        <div>
                            <div class="podium-username">{{username}}</div>
                            <div class="podium-category">Total - {{puntos}} puntos</div>
                        </div>
                    </div>
                    {{/with}}
                    
                    {{#with usuarios.[1]}}
                    <div class="podium-item">
                        <div class="podium-badge">🥈</div>
                        {{#if foto_perfil}}
                            <img src="{{foto_perfil}}" alt="{{username}}" class="podium-avatar">
                        {{else}}
                            <div class="podium-avatar">{{apodo.[0]}}</div>
                        {{/if}}
                        <div>
                            <div class="podium-username">{{username}}</div>
                            <div class="podium-category">Total - {{puntos}} puntos</div>
                        </div>
                    </div>
                    {{/with}}
                    
                    {{#with usuarios.[2]}}
                    <div class="podium-item">
                        <div class="podium-badge">🥉</div>
                        {{#if foto_perfil}}
                            <img src="{{foto_perfil}}" alt="{{username}}" class="podium-avatar">
                        {{else}}
                            <div class="podium-avatar">{{apodo.[0]}}</div>
                        {{/if}}
                        <div>
                            <div class="podium-username">{{username}}</div>
                            <div class="podium-category">Total - {{puntos}} puntos</div>
                        </div>
                    </div>
                    {{/with}}
                {{else}}
                    <div class="podium-item"><div class="podium-badge">🥇</div><div class="podium-username">No hay datos</div></div>
                    <div class="podium-item"><div class="podium-badge">🥈</div><div class="podium-username">No hay datos</div></div>
                    <div class="podium-item"><div class="podium-badge">🥉</div><div class="podium-username">No hay datos</div></div>
                {{/if}}
            </div>
        </div>
        
        <div class="ranking-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th><i class="fas fa-user"></i> Jugador</th>
                        <th><i class="fas fa-star"></i> Puntos Totales</th>
                    </tr>
                </thead>
                <tbody id="ranking-body">
                    {{#each usuarios}}
                    <tr>
                        <td>{{inc @index}}</td>
                        <td>
                            <div class="user-info">
                                <div class="avatar">
                                    {{#if foto_perfil}}
                                        <img src="{{foto_perfil}}" alt="{{username}}">
                                    {{else}}
                                        {{apodo.[0]}}
                                    {{/if}}
                                </div>
                                <div>
                                    <div class="username">{{username}}</div>
                                    <div class="user-category">Todas las materias</div>
                                </div>
                            </div>
                        </td>
                        <td class="score">{{puntos}}</td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="3" style="text-align: center; padding: 20px;">
                            No hay usuarios para mostrar
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    
    <button class="floating-button" onclick="location.href='/menu_principal'">
        <i class="fas fa-home"></i>
    </button>
</body>
</html>