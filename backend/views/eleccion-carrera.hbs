<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Exámenes por Carrera</title>
  
  <link rel="stylesheet" href="/css/eleccion-examen.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
  <!-- Contenedor del carrusel -->
  <div class="carousel-container">
    <h1 style="text-align: center; color: var(--text-primary); margin-bottom: 2rem; font-size: 2.5rem;">
      <i class="fas fa-graduation-cap"></i> Selecciona tu Carrera
    </h1>
    
    <div class="carousel" id="carousel"></div>

    <!-- Botones de control -->
    <div class="controls">
      <button onclick="location.href='/examen-aleatorio'" class="boton-aleatorio">
        <i class="fas fa-dice"></i> Aleatorio
      </button>
      <button onclick="location.href='/materias'">
        <i class="fas fa-arrow-left"></i> Regresar
      </button>
    </div>
  </div>

  <!-- Zonas invisibles para detectar clicks a izquierda y derecha -->
  <div id="leftZone" class="zone-click izquierda"></div>
  <div id="rightZone" class="zone-click derecha"></div>

  <script>
    window.DATA_MATERIAS = {{{json materias}}};
  </script>

  <script src="/public/js/materiasCarrera.controller.js" defer></script>
</body>
</html>
