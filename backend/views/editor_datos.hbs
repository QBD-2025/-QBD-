<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Gestión de Datos</title>

<!-- CSS principal del editor -->
<link rel="stylesheet" href="/css/editor.css" />

</head>
<body>

<!-- Encabezado del panel de editor -->
<header class="editor-header">
  <div class="header-left">
    <a href="/"><img src="/media/images/logo.png" alt="¡Que Buen Dato!" class="logo-image-header"></a>
  </div>
  <div class="header-center">
    <h1 class="editor-title">Panel de Edición</h1>
    <p class="editor-welcome">Bienvenido {{user.username}} (EDITOR)</p>
  </div>
  <div class="header-right">
    <a href="/menu_principal" class="volver-button">Volver</a>
  </div>
</header>

<!-- Imagen decorativa del personaje editor -->
<img src="/media/images/stuart_recargado.png" alt="Personaje Administrador" class="character-image">

<!-- Contenedor principal de gestión -->
<div class="editor-container container mt-4">
  <h2 class="editor-subtitle mb-4">Gestión de Datos</h2>
  <!-- Accesos rápidos a otras gestiones -->
  <a href="/editor/encuesta" class="editor-btn">Gestión de Encuesta</a>
  <a href="/editor" class="editor-btn">Gestión de Examenes</a>

  <!-- Tabla de datos -->
  <table class="editor-table mt-3">
    <thead>
      <tr>
        <th>ID Materia</th>
        <th>Dato</th>
        <th>Fuente</th>
        <th>Imagen</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <!-- Itera sobre los datos enviados desde el servidor -->
      {{#each datos}}
      <tr>
        <td>{{id_materia}} - {{nombre_materia}}</td>
        <td>{{dato}}</td>
        <td>{{fuente}}</td>
        <td>
          {{#if imagen}}
            <img src="/datos/imagen/{{id_dato}}" alt="Imagen del dato" style="max-width: 100px;" />
          {{else}}  
            Sin imagen
          {{/if}}
        </td>
        <td>
          <!-- Botón editar con datos almacenados en atributos -->
          <button class="editor-btn"
            data-id="{{id_dato}}"
            data-dato="{{dato}}"
            data-fuente="{{fuente}}"
            data-id-materia="{{id_materia}}"
            onclick="editarDatoDesdeAtributos(this)">✏️ Editar</button>
          <!-- Botón eliminar -->
          <button class="editor-btn btn-danger btn-eliminar" data-id="{{id_dato}}">🗑️ Eliminar</button>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Botón para agregar un nuevo dato -->
  <button class="editor-btn mt-3" onclick="agregarDato()">➕ Agregar dato</button>
</div>

<!-- Overlay oscuro para formularios y modales -->
<div id="overlay" onclick="cerrarForm()"></div>
<div id="overlay-eliminar" onclick="cerrarModalEliminar()"></div>

<!-- Formulario oculto para agregar o editar datos -->
<form id="formEditarDato" action="/editor/agregar-dato" method="POST" enctype="multipart/form-data">
  <h3 id="form-titulo">Agregar Dato</h3>
  <input type="hidden" name="id" id="editar-id">
  <label>Dato:</label>
  <input type="text" name="dato" id="editar-dato" required>
  <label>ID Materia:</label>
  <input type="number" name="id_materia" id="editar-id-materia" required>
  <label>Fuente:</label>
  <input type="text" name="fuente" id="editar-fuente">
  <label>Imagen (opcional):</label>
  <input type="file" name="imagen" id="editar-imagen" accept="image/*">
  <button type="submit" class="editor-btn">Guardar</button>
  <button type="button" class="editor-btn" onclick="cerrarForm()">Cancelar</button>
</form>

<!-- Modal de confirmación de eliminación -->
<div id="modal-eliminar">
  <h5>¿Deseas eliminar este dato?</h5>
  <button id="btnEliminarSi" class="editor-btn btn-danger">Sí</button>
  <button class="editor-btn btn-secondary" onclick="cerrarModalEliminar()">No</button>
</div>

<script src="/public/js/editorDatos.controller.js" defer></script>

</body>
</html>
