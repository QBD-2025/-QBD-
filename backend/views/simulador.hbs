<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Prueba de Examen de Admisión EXANI</title>
  
  {{!-- TEMA GLOBAL - IGUAL QUE CONÓCENOS Y RANKING --}}
  <script>
    const tema = localStorage.getItem('theme');
    if (tema) document.documentElement.setAttribute('data-theme', tema);
  </script>
  
  {{!-- GOOGLE FONTS --}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  {{!-- FONT AWESOME --}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  {{!-- ESTILOS PROPIOS --}}
  <link rel="stylesheet" href="/css/simulador.css" />
</head>
<body>
  <!-- Contenedor principal -->
  <div class="container">
    <!-- Encabezado con título y descripción -->
    <header>
      <h1>Prueba de Examen de Admisión EXANI</h1>
      <p>Simula y practica tu examen de admisión con preguntas reales del EXANI.</p>
    </header>

    <!-- Sección de práctica del simulador -->
    <section class="practica">
      <h2>📝 Inicia tu simulador</h2>
      <p>
        Esta es una versión de prueba del examen EXANI. 
        Al presionar el botón, comenzarás el simulador con preguntas seleccionadas.
      </p>
      <!-- Botón que redirige al inicio del simulador -->
      <button onclick="location.href='/examen-exani'">Comenzar examen</button>
    </section>

    <!-- Pie de página -->
    <footer>
      <p>© 2025 QueBuenDato.com</p>
    </footer>
  </div>

  <!-- Botón flotante de ligas (existente) -->
  <button class="floating-button" onclick="location.href='/ligas'" aria-label="Ir a ligas">🧷</button>
  
  <!-- NUEVO: Botón flotante de casa para regresar al menú principal (como en Conócenos) -->
  <button class="floating-home" onclick="location.href='/menu_principal'" aria-label="Volver al menú principal">
    <i class="fas fa-home"></i>
  </button>

  <script>
    // Seleccionamos los botones flotantes
    const floatingBtn = document.querySelector('.floating-button');
    const floatingHome = document.querySelector('.floating-home');

    // Animación para el botón de ligas
    if (floatingBtn) {
      floatingBtn.addEventListener('mouseenter', function() {
        this.style.animation = 'none';
      });
      
      floatingBtn.addEventListener('mouseleave', function() {
        this.style.animation = 'pulse 2s infinite';
      });
    }
    
    // Animación para el botón de casa
    if (floatingHome) {
      floatingHome.addEventListener('mouseenter', function() {
        this.style.animation = 'none';
      });
      
      floatingHome.addEventListener('mouseleave', function() {
        this.style.animation = 'pulseHome 2s infinite';
      });
    }
  </script>
</body>
</html> 