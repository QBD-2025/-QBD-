<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados del Duelo</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-page: #ffffff;
            --bg-primary: #f8f9fa;
            --bg-secondary: #ffffff;
            --text-primary: #1a1a1a;
            --text-secondary: #555555;
            --accent-success: #10b981;
            --accent-error: #ef4444;
            --accent-warning: #f59e0b;
            --accent-primary: #667eea;
            --accent-secondary: #764ba2;
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            --card-shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.15);
        }

        [data-theme="dark"] {
            --bg-page: #0a0e27;
            --bg-primary: #151b3d;
            --bg-secondary: #1e2950;
            --text-primary: #ffffff;
            --text-secondary: #cbd5e1;
            --accent-success: #4ade80;
            --accent-error: #fb7185;
            --accent-warning: #fbbf24;
            --accent-primary: #8b5cf6;
            --accent-secondary: #a78bfa;
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            --card-shadow-hover: 0 8px 30px rgba(0, 0, 0, 0.6);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-page);
            color: var(--text-primary);
            min-height: 100vh;
            line-height: 1.6;
            padding-top: 100px;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }

        /* ====================== HEADER ====================== */
        .header-resultado {
            text-align: center;
            margin-bottom: 40px;
            padding: 30px 20px;
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            border-radius: 20px;
            color: white;
            box-shadow: var(--card-shadow);
        }

        .header-resultado h1 {
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

        .header-resultado p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        /* ====================== PUNTAJES ====================== */
        .puntajes-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 40px;
        }

        .puntaje-card {
            background: var(--bg-secondary);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            box-shadow: var(--card-shadow);
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }

        .puntaje-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--card-shadow-hover);
        }

        .puntaje-card.mi-puntaje {
            border-color: var(--accent-primary);
        }

        .puntaje-card.oponente-puntaje {
            border-color: var(--accent-secondary);
        }

        .puntaje-card h3 {
            font-size: 1.1rem;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-secondary);
        }

        .puntaje-numero {
            font-size: 3.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 15px 0;
        }

        .puntaje-label {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        .puntos-tipo {
            background: var(--bg-primary);
            padding: 15px;
            border-radius: 10px;
            margin-top: 15px;
        }

        .puntos-tipo span {
            display: block;
            font-size: 0.85rem;
            margin: 8px 0;
        }

        .puntos-global {
            color: var(--accent-primary);
            font-weight: 700;
        }

        .puntos-carrera {
            color: var(--accent-warning);
            font-weight: 700;
        }

        .puntos-positivo {
            color: var(--accent-success);
        }

        .puntos-negativo {
            color: var(--accent-error);
        }

        /* ====================== RESULTADO FINAL ====================== */
        .resultado-final {
            background: var(--bg-secondary);
            border-radius: 15px;
            padding: 40px;
            margin-bottom: 40px;
            box-shadow: var(--card-shadow);
            text-align: center;
            border-left: 8px solid var(--accent-primary);
        }

        .resultado-final.victoria {
            border-left-color: var(--accent-success);
        }

        .resultado-final.derrota {
            border-left-color: var(--accent-error);
        }

        .resultado-final.empate {
            border-left-color: var(--accent-warning);
        }

        .resultado-titulo {
            font-size: 2rem;
            margin-bottom: 10px;
            font-weight: 900;
        }

        .resultado-subtitulo {
            font-size: 1.3rem;
            color: var(--text-secondary);
            margin-bottom: 30px;
        }

        .puntos-ganados {
            font-size: 2rem;
            font-weight: 900;
            padding: 20px;
            border-radius: 12px;
            margin: 20px 0;
            background: var(--bg-primary);
        }

        .puntos-ganados.positivos {
            color: var(--accent-success);
        }

        .puntos-ganados.negativos {
            color: var(--accent-error);
        }

        .puntos-ganados.neutro {
            color: var(--accent-warning);
        }

        .mensaje-final {
            font-size: 1.1rem;
            color: var(--text-secondary);
            margin-top: 20px;
            font-style: italic;
        }

        /* ====================== ESPERANDO ====================== */
        .esperando-container {
            background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(245, 158, 11, 0.05) 100%);
            border: 2px solid var(--accent-warning);
            border-radius: 15px;
            padding: 30px;
            text-align: center;
            margin-bottom: 40px;
            box-shadow: var(--card-shadow);
        }

        .esperando-container h3 {
            color: var(--accent-warning);
            margin-bottom: 15px;
            font-size: 1.3rem;
        }

        .esperando-container p {
            color: var(--text-secondary);
            margin: 10px 0;
        }

        .loader {
            display: inline-block;
            width: 30px;
            height: 30px;
            border: 4px solid var(--bg-primary);
            border-top-color: var(--accent-warning);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 15px;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ====================== INFO DUELO ====================== */
        .info-duelo {
            background: var(--bg-secondary);
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 40px;
            box-shadow: var(--card-shadow);
            border-left: 5px solid var(--accent-primary);
        }

        .info-duelo-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .info-item {
            background: var(--bg-primary);
            padding: 15px;
            border-radius: 10px;
        }

        .info-item label {
            display: block;
            color: var(--text-secondary);
            font-size: 0.85rem;
            text-transform: uppercase;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        .info-item value {
            display: block;
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--accent-primary);
        }

        /* ====================== PREGUNTAS DETALLE ====================== */
        .respuestas-detalle {
            margin-bottom: 40px;
        }

        .respuestas-detalle h3 {
            margin-bottom: 20px;
            font-size: 1.3rem;
            color: var(--text-primary);
        }

        .pregunta-item {
            background: var(--bg-secondary);
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            box-shadow: var(--card-shadow);
            border-left: 5px solid var(--accent-primary);
            transition: all 0.3s ease;
        }

        .pregunta-item:hover {
            transform: translateX(5px);
            box-shadow: var(--card-shadow-hover);
        }

        .pregunta-item.correcta {
            border-left-color: var(--accent-success);
        }

        .pregunta-item.incorrecta {
            border-left-color: var(--accent-error);
        }

        .pregunta-numero {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .pregunta-texto {
            font-weight: 700;
            margin-bottom: 20px;
            font-size: 1.05rem;
            color: var(--text-primary);
        }

        .respuestas-comparacion {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 15px;
        }

        .respuesta-box {
            background: var(--bg-primary);
            padding: 15px;
            border-radius: 10px;
            border-left: 4px solid var(--accent-primary);
        }

        .respuesta-box.correcta {
            border-left-color: var(--accent-success);
            background: rgba(16, 185, 129, 0.1);
        }

        .respuesta-box.incorrecta {
            border-left-color: var(--accent-error);
            background: rgba(239, 68, 68, 0.1);
        }

        .respuesta-box.pendiente {
            border-left-color: var(--accent-warning);
            background: rgba(245, 158, 11, 0.1);
        }

        .respuesta-titulo {
            font-size: 0.85rem;
            text-transform: uppercase;
            color: var(--text-secondary);
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }

        .respuesta-texto {
            font-size: 0.95rem;
            color: var(--text-primary);
        }

        .respuesta-icono {
            margin-right: 5px;
            font-weight: bold;
        }

        .respuesta-icono.correcto {
            color: var(--accent-success);
        }

        .respuesta-icono.incorrecto {
            color: var(--accent-error);
        }

        /* ====================== BOTONES ====================== */
        .botones-container {
            display: flex;
            gap: 15px;
            justify-content: center;
            margin: 40px 0 60px 0;
            flex-wrap: wrap;
        }

        .btn {
            padding: 15px 30px;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            color: white;
            box-shadow: var(--card-shadow);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: var(--card-shadow-hover);
        }

        .btn-secondary {
            background: var(--bg-secondary);
            color: var(--accent-primary);
            border: 2px solid var(--accent-primary);
        }

        .btn-secondary:hover {
            background: var(--bg-primary);
            transform: translateY(-3px);
        }

        /* ====================== RESPONSIVE ====================== */
        @media (max-width: 768px) {
            body {
                padding-top: 80px;
            }

            .container {
                padding: 15px;
            }

            .header-resultado h1 {
                font-size: 1.8rem;
            }

            .puntajes-container {
                grid-template-columns: 1fr;
            }

            .puntaje-numero {
                font-size: 2.5rem;
            }

            .respuestas-comparacion {
                grid-template-columns: 1fr;
            }

            .botones-container {
                flex-direction: column;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .resultado-titulo {
                font-size: 1.5rem;
            }

            .puntos-ganados {
                font-size: 1.5rem;
            }
        }

        /* ====================== ANIMACIONES ====================== */
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .puntaje-card,
        .resultado-final,
        .pregunta-item {
            animation: slideIn 0.6s ease forwards;
        }

        .puntaje-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .puntaje-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .resultado-final {
            animation-delay: 0.3s;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <div class="header-resultado">
            <h1 id="headerTitulo">
                <span id="headerIcono">🎮</span> Resultados del Duelo
            </h1>
            <p id="headerSubtitulo">
                {{#if esRetador}}
                    Tú <strong>{{duelo.retador_username}}</strong> vs <strong>{{duelo.defensor_username}}</strong>
                {{else}}
                    <strong>{{duelo.retador_username}}</strong> vs Tú <strong>{{duelo.defensor_username}}</strong>
                {{/if}}
            </p>
        </div>

        <!-- INFO DUELO -->
        <div class="info-duelo">
            <h3>📋 Información del Duelo</h3>
            <div class="info-duelo-grid">
                <div class="info-item">
                    <label>Tipo</label>
                    <value>
                        {{#if (equals tipoDuelo "carrera")}}
                            📚 Duelo de Carrera
                        {{else}}
                            🧠 Duelo General
                        {{/if}}
                    </value>
                </div>
                <div class="info-item">
                    <label>Dificultad</label>
                    <value>
                        {{#if (equals dificultad "Fácil")}}
                            😊 Fácil
                        {{else if (equals dificultad "Medio")}}
                            🤔 Medio
                        {{else}}
                            🔥 Difícil
                        {{/if}}
                    </value>
                </div>
                <div class="info-item">
                    <label>Apuesta</label>
                    <value>{{apuesta}} puntos</value>
                </div>
                <div class="info-item">
                    <label>Total de Preguntas</label>
                    <value>{{totalPreguntas}} preguntas</value>
                </div>
            </div>
        </div>

        <!-- PUNTAJES -->
        <div class="puntajes-container">
            <!-- MI PUNTAJE -->
            <div class="puntaje-card mi-puntaje">
                <h3>Tu Puntaje</h3>
                <div class="puntaje-numero">{{correctas}}</div>
                <div class="puntaje-label">de {{totalPreguntas}} correctas</div>

                <div class="puntos-tipo">
                    {{#if (equals tipoDuelo "general")}}
                        <!-- DUELO GENERAL: Mostrar puntos globales -->
                        <span>
                            <i class="fas fa-globe"></i> <strong>Puntos Globales:</strong><br>
                            {{#if (greaterThan puntosGanados 0)}}
                                <span class="puntos-global puntos-positivo">+{{puntosGanados}} pts 🎉</span>
                            {{else if (lessThan puntosGanados 0)}}
                                <span class="puntos-global puntos-negativo">{{puntosGanados}} pts 😔</span>
                            {{else}}
                                <span class="puntos-global">0 pts (Empate) 🤝</span>
                            {{/if}}
                        </span>
                        
                    {{else if (equals tipoDuelo "carrera")}}
                        <!-- DUELO DE CARRERA: Mostrar puntos de carrera -->
                        <span>
                            <i class="fas fa-graduation-cap"></i> <strong>Puntos de Carrera:</strong><br>
                            <small style="opacity: 0.8;">{{duelo.nombre_carrera}}</small><br>
                            {{#if (greaterThan puntosCarreraGanados 0)}}
                                <span class="puntos-carrera puntos-positivo">+{{puntosCarreraGanados}} pts 🎓</span>
                            {{else if (lessThan puntosCarreraGanados 0)}}
                                <span class="puntos-carrera puntos-negativo">{{puntosCarreraGanados}} pts 😔</span>
                            {{else}}
                                <span class="puntos-carrera">0 pts (Empate) 🤝</span>
                            {{/if}}
                        </span>
                    {{/if}}
                </div>
                
                <!-- Debug info (remover en producción) -->
                {{#if _debug}}
                <div style="margin-top: 15px; padding: 10px; background: rgba(0,0,0,0.05); 
                            border-radius: 5px; font-size: 0.75rem;">
                    <strong>🔍 Debug:</strong><br>
                    Tipo: {{_debug.tipo_duelo}}<br>
                    Es carrera: {{_debug.esDueloCarrera}}<br>
                    ID Carrera: {{_debug.id_carrera}}<br>
                    Pts carrera yo: {{_debug.miPuntosCarrera}}<br>
                    Pts carrera oponente: {{_debug.oponentePuntosCarrera}}
                </div>
                {{/if}}
            </div>

            <!-- PUNTAJE OPONENTE -->
            <div class="puntaje-card oponente-puntaje">
                <h3>{{nombreOponente}}</h3>
                {{#if ambosTerminaron}}
                    <div class="puntaje-numero">{{oponentePuntaje}}</div>
                    <div class="puntaje-label">de {{totalPreguntas}} correctas</div>
                    
                    <div class="puntos-tipo">
                        {{#if (equals tipoDuelo "general")}}
                            <span>
                                <i class="fas fa-globe"></i> <strong>Puntos Globales:</strong><br>
                                {{#if (greaterThan oponentePuntaje correctas)}}
                                    <span class="puntos-global puntos-positivo">+{{apuesta}} pts</span>
                                {{else if (lessThan oponentePuntaje correctas)}}
                                    <span class="puntos-global puntos-negativo">-{{apuesta}} pts</span>
                                {{else}}
                                    <span class="puntos-global">0 pts (Empate)</span>
                                {{/if}}
                            </span>
                        {{else if (equals tipoDuelo "carrera")}}
                            <span>
                                <i class="fas fa-graduation-cap"></i> <strong>Pts Carrera:</strong><br>
                                <small style="opacity: 0.8;">{{duelo.nombre_carrera}}</small><br>
                                {{#if (greaterThan oponentePuntaje correctas)}}
                                    <span class="puntos-carrera puntos-positivo">+{{apuesta}} pts</span>
                                {{else if (lessThan oponentePuntaje correctas)}}
                                    <span class="puntos-carrera puntos-negativo">-{{apuesta}} pts</span>
                                {{else}}
                                    <span class="puntos-carrera">0 pts (Empate)</span>
                                {{/if}}
                            </span>
                        {{/if}}
                    </div>
                {{else}}
                    <div style="font-size: 2rem; margin: 20px 0;">
                        <div class="loader"></div>
                        <p style="margin-top: 15px;">En progreso...</p>
                    </div>
                {{/if}}
            </div>
        </div>

        <!-- RESULTADO FINAL ACTUALIZADO -->
        {{#if ambosTerminaron}}
        <div class="resultado-final {{#if (eq correctas oponentePuntaje)}}empate{{else if (greaterThan correctas oponentePuntaje)}}victoria{{else}}derrota{{/if}}">
            {{#if (eq correctas oponentePuntaje)}}
                <!-- EMPATE -->
                <div class="resultado-titulo">🤝 ¡EMPATE!</div>
                <div class="resultado-subtitulo">{{correctas}} - {{oponentePuntaje}}</div>
                <div class="puntos-ganados neutro">
                    0 puntos {{#if (equals tipoDuelo "carrera")}}de carrera{{else}}globales{{/if}}
                </div>
                <div class="mensaje-final">
                    Ambos tuvieron un desempeño excepcional. ¡Vuelvan a intentarlo! 💪
                </div>

            {{else if (greaterThan correctas oponentePuntaje)}}
                <!-- VICTORIA -->
                <div class="resultado-titulo">🏆 ¡VICTORIA!</div>
                <div class="resultado-subtitulo">{{correctas}} - {{oponentePuntaje}}</div>
                
                {{#if (equals tipoDuelo "general")}}
                    <div class="puntos-ganados positivos">
                        <i class="fas fa-globe"></i> +{{puntosGanados}} puntos globales
                    </div>
                {{else}}
                    <div class="puntos-ganados positivos">
                        <i class="fas fa-graduation-cap"></i> +{{puntosCarreraGanados}} puntos de carrera
                    </div>
                    <small style="opacity: 0.8;">{{duelo.nombre_carrera}}</small>
                {{/if}}
                
                <div class="mensaje-final">
                    ¡Excelente! Derrotaste a {{nombreOponente}} de forma contundente. 🎉
                </div>

            {{else}}
                <!-- DERROTA -->
                <div class="resultado-titulo">😔 DERROTA</div>
                <div class="resultado-subtitulo">{{correctas}} - {{oponentePuntaje}}</div>
                
                {{#if (equals tipoDuelo "general")}}
                    <div class="puntos-ganados negativos">
                        <i class="fas fa-globe"></i> {{puntosGanados}} puntos globales
                    </div>
                {{else}}
                    <div class="puntos-ganados negativos">
                        <i class="fas fa-graduation-cap"></i> {{puntosCarreraGanados}} puntos de carrera
                    </div>
                    <small style="opacity: 0.8;">{{duelo.nombre_carrera}}</small>
                {{/if}}
                
                <div class="mensaje-final">
                    {{nombreOponente}} fue mejor esta vez. ¡No te desanimes, aprende y vuelve más fuerte! 💪
                </div>
            {{/if}}
        </div>
        {{/if}}
        
        <!-- RESPUESTAS DETALLE -->
        <div class="respuestas-detalle">
            <h3>📝 Detalle de Respuestas</h3>

            {{#each respuestas}}
            <div class="pregunta-item {{#if this.mi_correcta}}correcta{{else}}incorrecta{{/if}}">
                <div class="pregunta-numero">Pregunta {{orden}} de {{../totalPreguntas}}</div>
                <div class="pregunta-texto">{{this.pregunta}}</div>

                <div class="respuestas-comparacion">
                    <!-- TU RESPUESTA -->
                    <div class="respuesta-box {{#if this.mi_correcta}}correcta{{else}}incorrecta{{/if}}">
                        <div class="respuesta-titulo">👤 Tu Respuesta</div>
                        <div class="respuesta-texto">
                            <span class="respuesta-icono {{#if this.mi_correcta}}correcto{{else}}incorrecto{{/if}}">
                                {{#if this.mi_correcta}}✓{{else}}✗{{/if}}
                            </span>
                            {{this.mi_respuesta_texto}}
                        </div>
                    </div>

                    <!-- RESPUESTA OPONENTE -->
                    <div class="respuesta-box {{#if ../ambosTerminaron}}{{#if this.oponente_correcta}}correcta{{else}}incorrecta{{/if}}{{else}}pendiente{{/if}}">
                        <div class="respuesta-titulo">👥 {{../nombreOponente}}</div>
                        <div class="respuesta-texto">
                            {{#if ../ambosTerminaron}}
                                {{#if this.oponente_respuesta_texto}}
                                    <span class="respuesta-icono {{#if this.oponente_correcta}}correcto{{else}}incorrecto{{/if}}">
                                        {{#if this.oponente_correcta}}✓{{else}}✗{{/if}}
                                    </span>
                                    {{this.oponente_respuesta_texto}}
                                {{else}}
                                    <span style="color: var(--accent-warning);">⏳ No respondió</span>
                                {{/if}}
                            {{else}}
                                <span style="color: var(--accent-warning);">⏳ Esperando...</span>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>

        <!-- BOTONES -->
        <div class="botones-container">
            </button>
            <button class="btn btn-secondary" onclick="location.href='/portal'">
                <i class="fas fa-home"></i> Volver al Portal
            </button>
        </div>
    </div>

    <!-- CONFIGURACIÓN GLOBAL -->
    <script>
        window.DUELO_DATA = {
            id_duelo: "{{duelo.id_duelo}}",
            ambosTerminaron: {{#if ambosTerminaron}}true{{else}}false{{/if}},
            esRetador: {{#if esRetador}}true{{else}}false{{/if}},
            tipoDuelo: "{{tipoDuelo}}"
        };
    </script>

    <script src="/public/js/resultadosDuelo.controller.js" defer></script>
</body>
</html>