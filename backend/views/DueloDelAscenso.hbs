{{!-- Vista para el portal de Duelos de Ascenso pagina a implementar ver perfil--}} 
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal de Duelos de Ascenso</title>
    <link rel="stylesheet" href="/css/competitivo-duelos.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
     <link rel="stylesheet" href="/css/mini-perfil-modal.css">

    <script src="/socket.io/socket.io.js"></script>
    
    <script>
        window.SALA_CONFIG = {
            user: {{{json user}}},
            stats: {{{json stats}}}
        };
    </script>
    
    <style>
    
    </style>
</head>
<body>
    <div class="main-container">
        <!-- ===== PANEL LATERAL ===== -->
        <aside class="sidebar">
            <div class="user-profile">
                <img src="{{user.foto_perfil}}" alt="Avatar" class="user-avatar" onerror="this.src='/uploads/default_avatar.png'">
                <div class="user-name">{{user.username}}</div>
                <div class="user-career">{{#if user.carrera_descripcion}}{{user.carrera_descripcion}}{{else}}Sin carrera{{/if}}</div>
            </div>
            
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-value">{{stats.puntos}}</div>
                    <div class="stat-label">Pts Globales</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">{{stats.puntos_carrera}}</div>
                    <div class="stat-label">Pts Carrera</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">{{stats.duelos_jugados}}</div>
                    <div class="stat-label">Duelos</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">{{stats.victorias}}</div>
                    <div class="stat-label">Victorias</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">{{stats.racha_victorias}}</div>
                    <div class="stat-label">Racha</div>
                </div>
            </div>
            
            <div class="action-buttons">
              
                
                <button class="btn-action btn-primary" onclick="location.href='/matchmaking'">
                    <i class="fas fa-bolt"></i>
                    <span>Duelos Rápidos</span>
                    <small>Partida inmediata</small>
                </button>
                
                <button class="btn-action btn-secondary" onclick="location.href='/menu_principal'">
                    <i class="fas fa-home"></i>
                    <span>Volver al Portal</span>
                </button>
            </div>
        </aside>
        
        <!-- ===== PANEL PRINCIPAL ===== -->
        <main class="main-panel">
            <div class="tabs">
                <button class="tab active" data-tab="global">
                    <i class="fas fa-globe"></i> Ranking Global
                </button>
                <button class="tab" data-tab="carrera">
                    <i class="fas fa-graduation-cap"></i> Mi Carrera
                </button>
            </div>
            
            <div class="tab-content active" id="global">
                <div id="rankingGlobalContainer"></div>
            </div>
            
            <div class="tab-content" id="carrera">
                <!-- ✅ SELECTOR DE CARRERAS -->
                <div style="margin-bottom: 20px;">
                    <select id="selectorCarreraRanking" style="width: 100%; padding: 12px; border-radius: 10px; background: rgba(255,255,255,0.1); border: 2px solid rgba(255,255,255,0.2); color: #fff; font-size: 16px;">
                        <option value="">Cargando carreras...</option>
                    </select>
                </div>

                <!-- ✅ INFO DE PUNTOS -->
                <div id="carreraInfoBox" style="display: none; background: rgba(251,191,36,0.1); border: 2px solid rgba(251,191,36,0.3); border-radius: 12px; padding: 15px; margin-bottom: 20px; text-align: center;">
                    <p style="color: #cbd5e1; margin: 0 0 5px 0;">Tus puntos en esta carrera:</p>
                    <span id="puntosCarreraActual" style="font-size: 24px; font-weight: 900; color: #fbbf24;">0</span>
                </div>
                <div id="rankingCarreraContainer"></div>
            </div>
        </main>
    </div>
    
    <!-- ===== MODAL DE SELECCIÓN DE DIFICULTAD ===== -->
    <div class="modal-overlay" id="modalDificultad">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-swords"></i> Selecciona la Dificultad</h2>
                <p id="modalSubtitulo">Elige el nivel y la apuesta</p>
            </div>
            
            <!-- ✅ SELECTOR DE CARRERAS (SE MUESTRA SOLO PARA DUELOS DE CARRERA) -->
            <div id="carreraSelector" style="display: none;">
                <select id="selectorCarrera">
                    <option value="">Cargando carreras...</option>
                </select>
                
                <!-- ✅ INDICADOR DE PUNTOS DISPONIBLES -->
                <div class="puntos-carrera-display" id="puntosCarreraDisplay" style="display: none;">
                    <div class="label">Puntos disponibles en esta carrera</div>
                    <div class="valor" id="puntosCarreraValor">0 pts</div>
                </div>
            </div>
            
            <div class="difficulty-grid">
                <!-- FÁCIL -->
                <div class="difficulty-card facil" data-difficulty="1" data-bet="50">
                    <div class="difficulty-icon">😊</div>
                    <div class="difficulty-name">Fácil</div>
                    <div class="difficulty-bet">50 pts</div>
                    <div class="difficulty-desc">Preguntas básicas</div>
                </div>
                
                <!-- MEDIO -->
                <div class="difficulty-card medio" data-difficulty="2" data-bet="100">
                    <div class="difficulty-icon">🤔</div>
                    <div class="difficulty-name">Medio</div>
                    <div class="difficulty-bet">100 pts</div>
                    <div class="difficulty-desc">Reto moderado</div>
                </div>
                
                <!-- DIFÍCIL -->
                <div class="difficulty-card dificil" data-difficulty="3" data-bet="200">
                    <div class="difficulty-icon">🔥</div>
                    <div class="difficulty-name">Difícil</div>
                    <div class="difficulty-bet">200 pts</div>
                    <div class="difficulty-desc">Solo expertos</div>
                </div>
            </div>
            
            <div class="modal-warning">
                <h4><i class="fas fa-exclamation-triangle"></i> Sistema de Penalizaciones</h4>
                <ul>
                    <li><strong>Desconexión:</strong> Pierdes el 50% de tu apuesta</li>
                    <li><strong>Abandono voluntario:</strong> Pierdes el 100% de tu apuesta</li>
                    <li><strong>Victoria:</strong> Ganas la apuesta completa</li>
                    <li><strong>Empate:</strong> No se pierden ni ganan puntos</li>
                </ul>
            </div>
            
            <div class="modal-buttons">
                <button class="btn-modal btn-cancel" onclick="cerrarModalDificultad()">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button class="btn-modal btn-confirm" id="btnConfirmarDuelo" disabled>
                    <i class="fas fa-paper-plane"></i> Enviar Desafío
                </button>
            </div>
        </div>
    </div>
    <script src="/public/js/mini-perfil-modal-controller.js"></script>
    <script src="/public/js/dueloAscenso.controller.js" ></script>
</body>
</html>