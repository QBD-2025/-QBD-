<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal de Duelos de Ascenso</title>
    <link rel="stylesheet" href="/css/competitivo-duelos.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script src="/socket.io/socket.io.js"></script>
    
    <script>
        window.SALA_CONFIG = {
            user: {{{json user}}},
            stats: {{{json stats}}}
        };
    </script>
    
    <style>
        /* ===== ESTILOS DEL MODAL MEJORADO ===== */
        /* ================================================================
   DUELOS DE ASCENSO - CSS COMPLETO CON AJUSTES PARA TOP BAR
   ================================================================ */

:root {
    --morado-principal: #8b5cf6;
    --morado-oscuro: #6d28d9;
    --morado-claro: #a78bfa;
    --azul-principal: #3b82f6;
    --azul-oscuro: #1e40af;
    --azul-claro: #60a5fa;
    --amarillo-mostaza: #f59e0b;
    --amarillo-claro: #fbbf24;
    --blanco: #ffffff;
    --gris-claro: #f3f4f6;
    --gris-medio: #9ca3af;
    --gris-oscuro: #374151;
    --negro: #111827;
    --verde-exito: #10b981;
    --rojo-error: #ef4444;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    min-height: 100vh;
    color: var(--morado-principal);
    overflow-x: hidden;
    /* ✅ PADDING PARA TOP BAR */
    padding-top: 80px;
}

/* ✅ AJUSTE PARA EVITAR SOBREPOSICIÓN CON TOP BAR */
.main-container {
    display: grid;
    grid-template-columns: 350px 1fr;
    gap: 30px;
    padding: 30px;
    max-width: 1600px;
    margin: 0 auto;
    min-height: calc(100vh - 80px); /* Restar altura del top bar */
}

/* ================== SIDEBAR MEJORADO ================== */
.sidebar {
    background: linear-gradient(145deg, rgba(139, 92, 246, 0.15), rgba(59, 130, 246, 0.1));
    backdrop-filter: blur(15px);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
    /* ✅ STICKY CON OFFSET PARA TOP BAR */
    position: sticky;
    top: 100px; /* 80px top bar + 20px espacio */
    height: fit-content;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
}

/* Scrollbar personalizado */
.sidebar::-webkit-scrollbar {
    width: 8px;
}

.sidebar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 10px;
}

.sidebar::-webkit-scrollbar-thumb {
    background: var(--morado-principal);
    border-radius: 10px;
}

.user-avatar {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 4px solid #8b5cf6;
    margin: 0 auto 20px;
    display: block;
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.4);
    object-fit: cover;
    transition: transform 0.3s ease;
}

.user-avatar:hover {
    transform: scale(1.05);
}

.user-name {
    text-align: center;
    font-size: 1.8rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 10px;
}

.user-career {
    text-align: center;
    color: #94a3b8;
    font-size: 1.1rem;
    margin-bottom: 25px;
}

/* ✅ STATS GRID MEJORADO */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 25px;
}

.stat-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 15px 10px;
    text-align: center;
    transition: all 0.3s ease;
}

.stat-card:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
}

.stat-value {
    font-size: 1.8rem;
    font-weight: 900;
    color: #fbbf24;
    margin-bottom: 5px;
    text-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
}

.stat-label {
    font-size: 0.85rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ✅ BOTONES DE ACCIÓN MEJORADOS */
.action-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.btn-action {
    width: 100%;
    padding: 15px;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
}

.btn-action i {
    font-size: 1.3rem;
}

.btn-action small {
    font-size: 0.75rem;
    font-weight: 400;
    opacity: 0.8;
}

.btn-primary {
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    color: #fff;
}

.btn-primary:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(139, 92, 246, 0.5);
}

.btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    border: 2px solid rgba(255, 255, 255, 0.2);
}

.btn-secondary:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-3px);
}

.btn-action:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

/* ================== PANEL PRINCIPAL ================== */
.main-panel {
    background: linear-gradient(145deg, rgba(139, 92, 246, 0.15), rgba(59, 130, 246, 0.1));
    backdrop-filter: blur(15px);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
}

/* ✅ TABS MEJORADOS */
.tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 30px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.tab {
    flex: 1;
    padding: 15px 20px;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    color: #94a3b8;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.tab:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
}

.tab.active {
    color: #fff;
    border-bottom-color: #fbbf24;
    background: rgba(245, 158, 11, 0.1);
}

.tab-content {
    display: none;
    animation: fadeIn 0.5s ease;
}

.tab-content.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* ================== RANKING ITEMS ================== */
.ranking-item {
    display: flex;
    align-items: center;
    gap: 15px;
    background: rgba(255, 255, 255, 0.05);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 15px;
    padding: 18px;
    margin-bottom: 12px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.ranking-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 5px;
    background: linear-gradient(180deg, var(--morado-principal), var(--azul-principal));
    transform: scaleY(0);
    transition: transform 0.3s ease;
}

.ranking-item:hover::before {
    transform: scaleY(1);
}

.ranking-item:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(10px);
    border-color: var(--morado-principal);
    box-shadow: 0 8px 25px rgba(139, 92, 246, 0.3);
}

.ranking-item.current-user {
    background: linear-gradient(145deg, rgba(245, 158, 11, 0.2), rgba(251, 191, 36, 0.1));
    border: 3px solid var(--amarillo-mostaza);
    box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
}

.rank-number {
    font-size: 1.5rem;
    font-weight: 900;
    color: #fbbf24;
    min-width: 50px;
    text-align: center;
}

.player-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 3px solid var(--morado-principal);
    box-shadow: 0 5px 15px rgba(139, 92, 246, 0.4);
    object-fit: cover;
    transition: transform 0.3s ease;
}

.ranking-item:hover .player-avatar {
    transform: scale(1.1) rotate(5deg);
}

.player-info {
    flex: 1;
}

.player-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 5px;
}

.badge-yo {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #000;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 800;
    margin-left: 8px;
}

.player-stats {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
}

.player-stats span {
    background: rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.85rem;
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    gap: 5px;
}

.score-display {
    font-size: 1.8rem;
    font-weight: 900;
    color: #fbbf24;
    text-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    margin-left: auto;
}

/* ✅ BOTÓN DESAFIAR MEJORADO */
.btn-desafiar {
    padding: 10px 20px;
    background: linear-gradient(135deg, #10b981, #059669);
    border: none;
    border-radius: 10px;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
}

.btn-desafiar:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(16, 185, 129, 0.5);
}

.no-challenge-reason {
    font-size: 0.85rem;
    color: #94a3b8;
    font-style: italic;
    padding: 8px 15px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
}

/* ================== MODAL DE DIFICULTAD ================== */
.modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.modal-overlay.active {
    opacity: 1;
    visibility: visible;
}

.modal-content {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.95));
    backdrop-filter: blur(20px);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 25px;
    padding: 40px;
    max-width: 700px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6);
    transform: scale(0.8);
    transition: transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

.modal-overlay.active .modal-content {
    transform: scale(1);
}

/* ✅ HEADER DEL MODAL */
.modal-header {
    text-align: center;
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
}

.modal-header h2 {
    font-size: 2rem;
    background: linear-gradient(135deg, #a78bfa, #60a5fa, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 900;
    margin-bottom: 10px;
}

.modal-header p {
    color: #cbd5e1;
    font-size: 1rem;
    margin: 0;
}

/* ✅ SELECTOR DE CARRERAS MEJORADO */
#selectorCarrera {
    width: 100%;
    padding: 15px;
    margin: 15px 0 25px 0;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(139, 92, 246, 0.1));
    border: 2px solid rgba(59, 130, 246, 0.3);
    border-radius: 12px;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(59, 130, 246, 0.2);
}

#selectorCarrera:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.2));
}

#selectorCarrera option {
    background: #1e293b;
    color: #fff;
    padding: 10px;
}

/* ✅ INDICADOR DE PUNTOS DE CARRERA */
.puntos-carrera-display {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.2), rgba(251, 191, 36, 0.1));
    border: 2px solid rgba(245, 158, 11, 0.3);
    border-radius: 12px;
    padding: 15px;
    margin-bottom: 20px;
    text-align: center;
}

.puntos-carrera-display .label {
    color: #94a3b8;
    font-size: 0.9rem;
    margin-bottom: 5px;
}

.puntos-carrera-display .valor {
    color: #fbbf24;
    font-size: 2rem;
    font-weight: 900;
    text-shadow: 0 0 15px rgba(251, 191, 36, 0.5);
}

/* Grid de dificultades */
.difficulty-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.difficulty-card {
    background: rgba(255, 255, 255, 0.05);
    border: 3px solid rgba(255, 255, 255, 0.15);
    border-radius: 18px;
    padding: 30px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.difficulty-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(139, 92, 246, 0.4);
}

.difficulty-card.selected {
    transform: scale(1.08);
    box-shadow: 0 20px 50px rgba(139, 92, 246, 0.6);
    animation: selectPulse 0.6s ease;
}

.difficulty-card.facil {
    border-color: rgba(16, 185, 129, 0.3);
}

.difficulty-card.facil:hover,
.difficulty-card.facil.selected {
    border-color: #10b981;
    background: linear-gradient(145deg, rgba(16, 185, 129, 0.2), rgba(5, 150, 105, 0.1));
}

.difficulty-card.medio {
    border-color: rgba(59, 130, 246, 0.3);
}

.difficulty-card.medio:hover,
.difficulty-card.medio.selected {
    border-color: #3b82f6;
    background: linear-gradient(145deg, rgba(59, 130, 246, 0.2), rgba(29, 78, 216, 0.1));
}

.difficulty-card.dificil {
    border-color: rgba(239, 68, 68, 0.3);
}

.difficulty-card.dificil:hover,
.difficulty-card.dificil.selected {
    border-color: #ef4444;
    background: linear-gradient(145deg, rgba(239, 68, 68, 0.2), rgba(220, 38, 38, 0.1));
}

.difficulty-icon {
    font-size: 3.5rem;
    margin-bottom: 15px;
}

.difficulty-name {
    font-size: 1.4rem;
    font-weight: 800;
    color: #fff;
    margin-bottom: 10px;
}

.difficulty-bet {
    font-size: 1.6rem;
    font-weight: 900;
    color: #fbbf24;
    margin-bottom: 8px;
    text-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
}

.difficulty-desc {
    font-size: 0.95rem;
    color: #94a3b8;
}

/* Warning del modal */
.modal-warning {
    background: rgba(245, 158, 11, 0.1);
    border: 2px solid rgba(245, 158, 11, 0.3);
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 30px;
}

.modal-warning h4 {
    color: #fbbf24;
    font-size: 1.2rem;
    margin-bottom: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.modal-warning ul {
    list-style: none;
    padding: 0;
}

.modal-warning li {
    color: #cbd5e1;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 1rem;
}

.modal-warning li:last-child {
    border-bottom: none;
}

/* Botones del modal */
.modal-buttons {
    display: flex;
    gap: 15px;
}

.btn-modal {
    flex: 1;
    padding: 16px 30px;
    border: none;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-cancel {
    background: rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
    border: 2px solid rgba(148, 163, 184, 0.3);
}

.btn-cancel:hover {
    background: rgba(148, 163, 184, 0.3);
    transform: translateY(-3px);
}

.btn-confirm {
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    color: #fff;
}

.btn-confirm:hover:not(:disabled) {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(139, 92, 246, 0.5);
}

.btn-confirm:disabled {
    background: rgba(148, 163, 184, 0.3);
    color: #64748b;
    cursor: not-allowed;
    opacity: 0.6;
}

/* ================== RESPONSIVE ================== */
@media (max-width: 1200px) {
    .main-container {
        grid-template-columns: 1fr;
        padding: 20px;
    }
    
    .sidebar {
        position: static;
        max-height: none;
    }
}

@media (max-width: 768px) {
    body {
        padding-top: 70px;
    }
    
    .main-container {
        padding: 15px;
        min-height: calc(100vh - 70px);
    }
    
    .sidebar {
        top: 90px;
    }
    
    .difficulty-grid {
        grid-template-columns: 1fr;
    }
    
    .tabs {
        flex-direction: column;
    }
    
    .modal-content {
        padding: 25px;
    }
}

@media (max-width: 480px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .ranking-item {
        flex-direction: column;
        text-align: center;
    }
    
    .rank-number {
        width: 100%;
    }
}

/* ================== ANIMACIONES ================== */
@keyframes selectPulse {
    0%, 100% { transform: scale(1.08); }
    50% { transform: scale(1.12); }
}

@keyframes slideInRight {
    from { opacity: 0; transform: translateX(100%); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes slideOutRight {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(100%); }
}
