<!-- src/views/DueloDelAscenso.hbs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <!-- Configuración de codificación -->
    <meta charset="UTF-8">
    
    <!-- Título de la página -->
    <title>Duelos de Ascenso</title>
    
    <!-- Enlace al CSS específico de esta vista -->
    <link rel="stylesheet" href="/css/DueloDelAscenso.css">
</head>
<body>

<!-- Contenedor principal que divide la pantalla -->
<div class="main-container">

    <!-- Panel izquierdo con matchmaking y botones de ranking -->
    <div class="matchmaking-container">

        <!-- Botón para buscar duelos rápidos -->
        <button class="matchmaking-btn" onclick="location.href='/matchmaking'">
            Buscar Duelos<br>Rapidos
        </button>

        <!-- Botón para ver el ranking por carrera -->
        <div>
            <button class="ranking-carrera-btn" onclick="location.href='/rankingCarrera'">
                Ranking por Carrera 🏅
            </button>
        </div>

        <!-- Panel informativo sobre el ranking global -->
        <div class="info-panel">
            <h3>🏆 Ranking Global</h3>
            <p><strong>Desafía</strong> a jugadores que estén por encima de ti</p>
            <p><strong>Gana puntos</strong> al vencer oponentes superiores</p>
            <p><strong>Defiende</strong> tu posición de los desafíos</p>
        </div>
    </div>

    <!-- Contenedor derecho para mostrar la tabla de clasificación global -->
    <div id="rankingGlobalContainer">
        <div class="ranking-header">
            <h2>Tabla de Clasificación Global</h2>
            <p class="ranking-subtitle">Los mejores jugadores del servidor</p>
        </div>
    </div>

<script>
    // Variable "user" enviada desde el servidor
    const user = {{{json user}}};

    // Contenedor principal del ranking
    const rankingGlobalContainer = document.getElementById('rankingGlobalContainer');
    
    /**
     * Función para renderizar el ranking de jugadores
     * @param {HTMLElement} container - contenedor donde se renderiza el ranking
     * @param {Array} jugadores - lista de jugadores con datos
     */
    function renderizarRanking(container, jugadores) {
        // Guardar el header para mantenerlo
        const header = container.querySelector('.ranking-header');
        container.innerHTML = ''; // Limpiar contenedor
        if (header) {
            container.appendChild(header); // Volver a agregar el header
        }

        // Si no hay jugadores
        if (!jugadores || jugadores.length === 0) {
            container.innerHTML += '<p>No hay jugadores en este ranking.</p>';
            return;
        }

        // Ordenar jugadores por puntos descendente
        jugadores.sort((a, b) => b.puntos - a.puntos);

        // Encontrar la posición del usuario actual
        const miIndex = jugadores.findIndex(j => j.id_usuario === user.id_usuario);

        // Crear los elementos HTML para cada jugador
        jugadores.forEach((jugador, i) => {
            const item = document.createElement('div');
            const esYo = jugador.id_usuario === user.id_usuario;
            const puedoDesafiar = i < miIndex; // Solo puedo desafiar a jugadores por encima

            item.innerHTML = `
                <img src="${jugador.foto_perfil || '/media/images/default_avatar.png'}" alt="Avatar">
                <div class="player-info">
                    <div class="player-name">${jugador.username} ${esYo ? '(Tú)' : ''}</div>
                    <div class="player-stats">
                        <span class="stat-item">📊 Posición #${i + 1}</span>
                    </div>
                </div>
                <div class="score-display">${jugador.puntos} pts</div>
                ${puedoDesafiar ? `
                    <div class="challenge-actions">
                        <button data-id="${jugador.id_usuario}">Desafiar</button>
                    </div>
                ` : ''}
            `;
            container.appendChild(item);
        });
    }

    /**
     * Función para cargar el ranking global desde la API
     */
    async function cargarRankingGlobal() {
        const response = await fetch('/api/ranking/global');
        const jugadores = await response.json();
        renderizarRanking(rankingGlobalContainer, jugadores);
    }

    // Evento global para capturar clicks en botones de "Desafiar"
    document.addEventListener('click', async (e) => {
        if (e.target && e.target.tagName === 'BUTTON' && e.target.dataset.id) {
            const idOponente = e.target.dataset.id;
            const tiempoLimite = 2 * 24 * 60 * 60; // 2 días en segundos

            e.target.disabled = true;
            e.target.textContent = 'Enviando...';

            try {
                // Enviar solicitud al servidor para desafiar al jugador
                const res = await fetch(`/desafiar/duelo/${idOponente}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ tiempoLimite })
                });
                const data = await res.json();
                console.log("Respuesta del servidor:", data);

                if (res.ok) {
                    e.target.textContent = '✓ Enviado';
                    setTimeout(() => {
                        e.target.textContent = 'Desafiar';
                        e.target.disabled = false;
                    }, 3000);
                } else {
                    throw new Error(data.message || 'Error al enviar desafío');
                }
            } catch (error) {
                console.error("Error al enviar desafío:", error);
                e.target.disabled = false;
                e.target.textContent = 'Desafiar';
                alert('Error al enviar el desafío. Inténtalo de nuevo.');
            }
        }
    });

    // Cargar ranking al cargar la página
    document.addEventListener('DOMContentLoaded', () => {
        cargarRankingGlobal();
    });
</script>

</body>
</html>
