{{!-- Layout principal para todas las vistas, incluye cabecera global y scripts comunes MAIN.HBS --}}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>QueBuenDato.com.mx</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.11.4/gsap.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap" rel="stylesheet">
</head>
<body>

    {{!-- Cabecera Global --}}
    <div class="global-header-elements">
        <div class="top-left-logo">
            {{#if user}}
                <a href="/menu_principal"><img src="/media/images/logo.png" alt="¡Que Buen Dato!" class="logo-image"></a>
            {{else}}
                <a href="/"><img src="/media/images/logo.png" alt="¡Que Buen Dato!" class="logo-image"></a>
            {{/if}}
            <a href="/conocenos" class="header-button">Conócenos</a>
        </div>
        <div class="top-right-nav">
            {{#if user}}
                <span class="nav-username">Hola, {{user.username}}</span>

                <!-- Eliminado el ícono de perfil circular -->

                <div class="notification-container">
                    🔔 <span id="notification-count" style="display:none;"></span>
                </div>
                <div class="notification-dropdown" id="notification-list" style="display:none;">
                    <ul id="notifications-ul"><li>Cargando...</li></ul>
                </div>
                
                <!-- Menú de hamburguesa modificado para incluir perfil -->
                <div class="kebab-menu">
                    <button class="kebab-button">
                        <!-- Mostrar avatar del usuario en el botón -->
                        <div class="kebab-avatar">
                            {{#if user.avatarUrl}}
                                <img src="{{user.avatarUrl}}" alt="Perfil" style="width:100%;height:100%;border-radius:50%;">
                            {{else}}
                                {{#if user.username}}
                                    {{user.username.[0]}}
                                {{else}}
                                    U
                                {{/if}}
                            {{/if}}
                        </div>
                        &#8942; <!-- Icono de hamburguesa -->
                    </button>
                    <ul class="kebab-dropdown">
                        <!-- Encabezado con información del perfil -->
                        <li class="profile-header">
                            <div class="profile-info">
                                <div class="profile-avatar">
                                    {{#if user.avatarUrl}}
                                        <img src="{{user.avatarUrl}}" alt="Perfil">
                                    {{else}}
                                        <div class="avatar-placeholder">
                                            {{user.username.[0]}}
                                        </div>
                                    {{/if}}
                                </div>
                                <div class="profile-details">
                                    <strong>{{user.username}}</strong>
                                    <span>{{user.email}}</span>
                                </div>
                            </div>
                        </li>
                        <li><a href="/menu_principal">Menu Principal</a></li>
                        <li><a href="/usuario/editar">Mi Perfil</a></li>
                        <li><a href="/usuario">Configuración</a></li>
                        {{#if (eq user.id_tp_usuario 3)}}
                            <li><a href="/admin">Permisos</a></li>
                            <li><a href="/editor">Editor</a></li>
                        {{/if}}
                        {{#if (eq user.id_tp_usuario 2)}}
                            <li><a href="/editor">Editor</a></li>
                        {{/if}}
                        <li><a href="/logout" class="cerrar-sesion">Cerrar sesión</a></li>
                    </ul>
                </div>
            {{else}}
                <!-- Mostrar botón de iniciar sesión solo si NO estamos en /presentation -->
                {{#unless (eq currentPath "/")}}
                    <a href="/login" class="header-link">Iniciar Sesión</a>
                {{/unless}}
            {{/if}}
        </div>
    </div>
    <div id="mensajeExamen"></div>

    {{{body}}}

<script src="/socket.io/socket.io.js"></script>
<script>
    // ✅ FUNCIONES GLOBALES (para que el HTML las encuentre)
    function toggleNotifications(event) {
        event.stopPropagation();
        const list = document.getElementById("notification-list");
        if (list) list.style.display = (list.style.display === "block") ? "none" : "block";
    }

    async function cargarNotificaciones() {
        try {
            const response = await fetch('/notificaciones');
            const data = await response.json();
            const ul = document.getElementById("notifications-ul");
            if (!ul) return;
            ul.innerHTML = data.length === 0 ? "<li>No tienes notificaciones</li>" : "";
            data.forEach(notif => {
                const li = document.createElement('li');
                if (notif.tipo === 'invitacion' || notif.tipo === 'desafio_duelo') {
                    li.innerHTML = `<span>${notif.mensaje}</span><button class="btn-aceptar" data-id="${notif.id_notificacion}">Aceptar</button>`;
                    li.innerHTML += `<button class="btn-rechazar" data-id="${notif.id_notificacion}">Rechazar</button>`;
                } else if (notif.tipo === 'duelo_aceptado') {
                    let extraData = {};
                    try { extraData = JSON.parse(notif.extra_data || '{}'); } catch(e) { extraData = {}; }
                    li.innerHTML = `
                        <span>${notif.mensaje}</span>
                        <button class="btn-ir-examen" onclick="window.location.href='/duelo/examen/${extraData.salaId}'" 
                                style="background: #28a745; color: white; border: none; padding: 8px 15px; border-radius: 5px; cursor: pointer; margin-left: 10px; font-weight: bold;">
                            Unirse
                        </button>
                        <button class="btn-eliminar" data-id="${notif.id_notificacion}" 
                                style="background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; margin-left: 5px;">
                            ✕
                        </button>
                    `;
                } else {
                    li.innerHTML = `<span>${notif.mensaje}</span>`;
                }
                ul.appendChild(li);
            });
            const countEl = document.getElementById("notification-count");
            if(countEl) {
                countEl.style.display = data.length > 0 ? "inline" : "none";
                countEl.innerText = data.length;
            }
        } catch (error) { console.error("Error al cargar notificaciones:", error); }
    }

    // ✅ CÓDIGO ORGANIZADO (se ejecuta cuando el HTML está listo)
    document.addEventListener('DOMContentLoaded', function() {
        
        // --- Lógica del menú de hamburguesa ---
        const kebabButton = document.querySelector('.kebab-button');
        if (kebabButton) {
            gsap.set('.kebab-dropdown li', { opacity: 0, y: -15 });
            kebabButton.addEventListener('click', function(e) {
                e.stopPropagation();
                document.getElementById('notification-list').style.display = 'none';
                const menu = this.parentElement;
                const isActive = menu.classList.toggle('active');
                gsap.to('.kebab-dropdown', { opacity: isActive ? 1 : 0, duration: 0.2 });
                gsap.to('.kebab-dropdown li', { opacity: isActive ? 1 : 0, y: isActive ? 0 : -15, stagger: 0.1, duration: 0.3 });
            });
        }

        document.querySelector('.notification-container')?.addEventListener('click', toggleNotifications);
        document.addEventListener('click', () => {
            const activeMenu = document.querySelector('.kebab-menu.active');
            if (activeMenu) activeMenu.classList.remove('active');
            const notifList = document.getElementById("notification-list");
            if(notifList) notifList.style.display = 'none';
        });
        document.querySelector('.kebab-dropdown')?.addEventListener('click', e => e.stopPropagation());
        document.getElementById('notification-list')?.addEventListener('click', e => e.stopPropagation());

        // --- LÓGICA DE SOCKETS Y NOTIFICACIONES (Solo para usuarios logueados) ---
        {{#if user}}
            const socket = io();

            // Listener para ACEPTAR cualquier notificación
            document.getElementById('notifications-ul')?.addEventListener('click', async (event) => {
                if (event.target.classList.contains('btn-aceptar')) {
                    const notifId = event.target.dataset.id;
                    const button = event.target;
                    
                    button.disabled = true;
                    button.textContent = 'Procesando...';
                    
                    try {
                        const response = await fetch(`/aceptar/${notifId}`, { method: 'POST', credentials: 'include' });
                        const data = await response.json();
                        
                        if (data.success) {
                            const li = event.target.closest('li');
                            if (li) li.remove();
                            
                            if (data.tipo === 'desafio_duelo') {
                                console.log('✅ Duelo aceptado, datos:', data);
                                const cont = document.getElementById('mensajeExamen') || document.body;
                                const mensajeDiv = document.createElement('div');
                                mensajeDiv.id = 'duelo-aceptado-mensaje';
                                mensajeDiv.style.cssText = `
                                    position: fixed; top: 20px; left: 50%; transform: translateX(-50%); 
                                    background: #28a745; color: white; padding: 20px; border-radius: 8px; 
                                    z-index: 9999; text-align: center; max-width: 400px;
                                `;
                                mensajeDiv.innerHTML = `
                                    <h4>¡Desafío Aceptado!</h4>
                                    <p>${data.message}</p>
                                    <p><strong>Ve a las notificaciones 🔔 para unirte al duelo.</strong></p>
                                    <div style="margin-top: 15px;">
                                        <button id="btn-cerrar-mensaje" style="background: #28a745; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;">
                                            Entendido
                                        </button>
                                    </div>
                                `;
                                cont.appendChild(mensajeDiv);
                                
                                document.getElementById('btn-cerrar-mensaje').addEventListener('click', () => {
                                    mensajeDiv.remove();
                                    setTimeout(cargarNotificaciones, 1500);
                                });
                                
                                setTimeout(() => {
                                    if (document.getElementById('duelo-aceptado-mensaje')) {
                                        mensajeDiv.remove();
                                    }
                                }, 10000);
                                
                            } else if (data.tipo === 'invitacion') {
                                console.log('✅ Invitación aceptada, redirigiendo:', data.redirigir);
                                window.location.href = data.redirigir;
                            } else {
                                setTimeout(cargarNotificaciones, 500);
                            }
                            
                        } else {
                            console.error('❌ Error al aceptar:', data.message);
                            alert(data.message || 'No se pudo aceptar la notificación.');
                            button.disabled = false;
                            button.textContent = 'Aceptar';
                        }
                        
                    } catch (error) {
                        console.error("❌ Error de red al aceptar:", error);
                        alert('Error de conexión. Inténtalo de nuevo.');
                        button.disabled = false;
                        button.textContent = 'Aceptar';
                    }
                }
                
                if (event.target.classList.contains('btn-rechazar')) {
                    const notifId = event.target.dataset.id;
                    const button = event.target;
                    
                    button.disabled = true;
                    button.textContent = 'Rechazando...';

                    try {
                        const li = event.target.closest('li');
                        if (li) li.remove();
                        await fetch(`/rechazar/${notifId}`, { method: 'POST', credentials: 'include' });
                        console.log('✅ Notificación rechazada');
                    } catch (error) {
                        console.error("❌ Error al rechazar:", error);
                        button.disabled = false;
                        button.textContent = 'Rechazar';
                    }
                }
                
                if (event.target.classList.contains('btn-eliminar')) {
                    const notifId = event.target.dataset.id;
                    const button = event.target;
                    
                    button.disabled = true;
                    button.textContent = '...';

                    try {
                        const li = event.target.closest('li');
                        if (li) li.remove();
                        await fetch(`/rechazar/${notifId}`, { method: 'POST', credentials: 'include' });
                        console.log('✅ Notificación eliminada');
                    } catch (error) {
                        console.error("❌ Error al eliminar:", error);
                        button.disabled = false;
                        button.textContent = '✕';
                    }
                } 
            });

            // Listener GLOBAL para la orden de redirección del Duelo
            socket.on('duelo:iniciarDesafio', ({ salaId, mensaje }) => {
                console.log('🚀 Recibido evento duelo:iniciarDesafio:', { salaId, mensaje });
                if (mensaje) alert(mensaje);
                window.location.href = `/duelo/enfrentamiento/${salaId}`;
            });

            // Listener para que la campanita se actualice en tiempo real
            socket.on('notificacion_recibida', () => {
                console.log('🔔 Notificación recibida, recargando...');
                cargarNotificaciones(); 
            });
            
            // Cargar notificaciones al inicio y periódicamente
            cargarNotificaciones();
            setInterval(cargarNotificaciones, 5000);
        {{/if}}
    });
</script>
</body>
</html>