<!DOCTYPE html>
<html lang="es">
<head>
    <!-- Configuración de codificación de caracteres y viewport para responsive -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">

    <!-- Título de la página -->
    <title>QueBuenDato.com</title>

    <!-- CSS externo principal para la página de verificación/restablecimiento -->
    <link rel="stylesheet" href="/css/verification.css">
</head>
<body>
    <!-- Contenedor principal de toda la sección -->
    <div class="verification-main-wrapper">

        <!-- Contenedor de elementos visuales (GIF, imágenes decorativas) -->
        <div class="verification-visuals-container">
            <!-- Imagen animada de Stuart pensando -->
            <div class="stuart-figure">
                <img src="/media/videos/stuart_pensando2.gif" alt="Stuart pensando" class="stuart-character">
            </div>
        </div>

        <!-- Contenedor del contenido textual y formulario -->
        <div class="verification-text-content">

            <!-- Título principal -->
            <h1 class="verification-headline">Restablecer Contraseña</h1>

            <!-- Mensaje explicativo -->
            <p class="verification-message">Crea una nueva contraseña segura.</p>

            {{!-- Mensaje de error dinámico desde el servidor --}}
            {{#if error}}
                <p class="verification-error-message" 
                   style="display: block; color: #dc3545; margin-top: 15px;">
                    {{error}}
                </p>
            {{/if}}

            <!-- Formulario para restablecer la contraseña -->
            <form id="reset-form" action="/restablecer-contrasena" method="POST" style="margin-top: 20px;">
                
                <!-- Token oculto para validar la acción del usuario -->
                <input type="hidden" name="token" value="{{token}}">

                <!-- Campo de nueva contraseña -->
                <div class="form-group" style="margin-bottom: 15px;">
                    <label for="password">Nueva Contraseña</label>
                    <div class="password-wrapper">
                        <!-- Input tipo password -->
                        <input type="password" id="password" name="password" class="form-control" required>
                        <!-- Icono para mostrar/ocultar contraseña -->
                        <span onclick="togglePassword('password', this)" class="password-toggle-icon">👁</span>
                    </div>
                </div>

                <!-- Campo de confirmación de contraseña -->
                <div class="form-group">
                    <label for="confirmPassword">Confirmar Nueva Contraseña</label>
                    <div class="password-wrapper">
                        <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required>
                        <span onclick="togglePassword('confirmPassword', this)" class="password-toggle-icon">👁</span>
                    </div>
                </div>

                <!-- Botón para enviar el formulario -->
                <button type="submit" class="btn-primary verification-button-resend" 
                        style="display: block; width: 100%; margin-top: 20px;">
                    Cambiar Contraseña
                </button>
            </form>
        </div>
    </div>

    <!-- Script para validar y controlar inputs de contraseña -->
    <script src="/public/js/cambiarContra.controller.js" defer></script>
</body>
</html>
