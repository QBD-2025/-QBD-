<!--Examen-carrera.hbs-->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Examen de {{carrera}}</title>
  <link rel="stylesheet" href="/css/examen.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body {{#if errorMsg}}data-error-msg="{{errorMsg}}"{{/if}}>

<!-- SECCIÓN PRE-EXAMEN -->
<div class="pre-examen-container" id="preExamenContent">
  <div class="pre-examen-content">
    <div class="pre-examen-header">
      <h1><i class="fas fa-user-graduate"></i> Examen de {{carrera}}</h1>
      <p>Demuestra tu dominio en tu área de especialización</p>
    </div>

    {{!-- Mostrar mensaje de error si no hay preguntas --}}
    {{#if errorMsg}}
    <div class="error-message">
      <i class="fas fa-exclamation-triangle"></i>
      <p>{{errorMsg}}</p>
    </div>
    {{/if}}

    <!-- Top player -->
    <div class="top-player-section">
      <h2 class="section-title"><i class="fas fa-crown"></i> Jugador Top Global</h2>
      
      {{#if rankingData.length}}
        {{#with rankingData.[0]}}
          <div class="top-player-card">
            <div class="top-badge">🥇</div>
            
            {{#if foto_perfil}}
              <img src="{{foto_perfil}}" alt="Foto de {{username}}" class="top-avatar">
            {{else}}
              <div class="top-avatar">{{apodo.[0]}}</div>
            {{/if}}
            
            <div class="top-username">{{username}}</div>
            <div class="top-category">Total - {{puntos}} puntos</div>
          </div>
        {{/with}}
      {{else}}
        <div class="top-player-card">
          <div class="top-badge">🥇</div>
          <div class="top-avatar">?</div>
          <div class="top-username">No hay datos aún</div>
          <div class="top-category">Sé el primero en jugar</div>
          <div class="top-score">0 puntos</div>
        </div>
      {{/if}}
      <p>¡Inspírate en el mejor jugador para lograr tus propios objetivos! Completa el examen con éxito para aumentar tu puntuación global.</p>
    </div>

    {{#if ultimoExamen}}
    <div class="previous-result">
      <i class="fas fa-chart-line" style="font-size: 36px; margin-bottom: 10px;"></i>
      <p>Tu último examen de {{carrera}}: <strong>{{ultimoExamen}}%</strong></p>
    </div>
    {{else}}
    <div class="no-previous-results">
      <i class="fas fa-inbox" style="font-size: 48px; margin-bottom: 15px;"></i>
      <p>No hay resultados previos para mostrar. ¡Completa este examen para ver tu progreso!</p>
    </div>
    {{/if}}

    <!-- Información del examen -->
    <div class="exam-info">
      <h2 class="section-title"><i class="fas fa-info-circle"></i> Información del Examen</h2>
      <div class="info-item"><i class="fas fa-graduation-cap"></i><div><strong>Carrera:</strong> {{carrera}}</div></div>
      {{#if tematicaNombre}}
      <div class="info-item"><i class="fas fa-book-open"></i><div><strong>Temática:</strong> {{tematicaNombre}}</div></div>
      {{/if}}
      <div class="info-item"><i class="fas fa-question-circle"></i><div><strong>Preguntas:</strong> {{#if preguntas.length}}{{preguntas.length}}{{else}}Selecciona temática y dificultad{{/if}}</div></div>
      <div class="info-item"><i class="fas fa-clock"></i><div><strong>Duración:</strong> 10 minutos aproximadamente</div></div>
      <div class="info-item"><i class="fas fa-star"></i><div><strong>Puntuación máxima:</strong> {{#if dificultad}}{{#if (eq dificultad "1")}}40 puntos{{else if (eq dificultad "2")}}100 puntos{{else}}200 puntos{{/if}}{{else}}Depende de la dificultad{{/if}}</div></div>
      
      <div class="pre-examen-buttons">
        
        <!-- MODAL DE SELECCIÓN DE TEMÁTICA Y DIFICULTAD -->
        <div id="modalTematicaDificultad" class="modal-dificultad {{#unless mostrarModal}}oculto{{/unless}}">
          <div class="modal-dificultad-content" style="max-width: 800px;">
            <h2><i class="fas fa-layer-group"></i> Configura tu Examen</h2>
            <p>Primero selecciona la temática que deseas estudiar, luego elige la dificultad del examen.</p>
            
            <!-- PASO 1: SELECCIÓN DE TEMÁTICA -->
            <div id="pasoTematica" class="paso-configuracion">
              <h3><i class="fas fa-book"></i> Paso 1: Selecciona una Temática</h3>
              
              {{#if tematicas.length}}
              <div class="opciones-tematica">
                {{#each tematicas}}
                <button class="opcion-tematica" data-tematica="{{id_tematica}}">
                  <div class="tematica-icono"><i class="fas fa-bookmark"></i></div>
                  <div class="tematica-titulo">{{descripcion}}</div>
                </button>
                {{/each}}
              </div>
              {{else}}
              <div class="error-message">
                <i class="fas fa-exclamation-circle"></i>
                <p>No hay temáticas disponibles para esta carrera.</p>
              </div>
              {{/if}}
            </div>

            <!-- PASO 2: SELECCIÓN DE DIFICULTAD (Oculto inicialmente) -->
            <div id="pasoDificultad" class="paso-configuracion oculto">
              <h3><i class="fas fa-sliders-h"></i> Paso 2: Selecciona la Dificultad</h3>
              <p>Has seleccionado: <strong id="tematicaSeleccionadaTexto"></strong></p>
              
              <div class="opciones-dificultad">
                <button class="opcion-dificultad" data-dificultad="1">
                  <div class="dificultad-icono">😊</div>
                  <div class="dificultad-titulo">Fácil</div>
                  <div class="dificultad-puntos">2 puntos por pregunta</div>
                  <div class="dificultad-descripcion">Preguntas básicas y directas</div>
                </button>
                
                <button class="opcion-dificultad" data-dificultad="2">
                  <div class="dificultad-icono">🤔</div>
                  <div class="dificultad-titulo">Normal</div>
                  <div class="dificultad-puntos">5 puntos por pregunta</div>
                  <div class="dificultad-descripcion">Preguntas de nivel medio</div>
                </button>
                
                <button class="opcion-dificultad" data-dificultad="3">
                  <div class="dificultad-icono">🔥</div>
                  <div class="dificultad-titulo">Difícil</div>
                  <div class="dificultad-puntos">10 puntos por pregunta</div>
                  <div class="dificultad-descripcion">Preguntas avanzadas y complejas</div>
                </button>
              </div>
              
              <button class="btn-volver-paso" onclick="volverATematica()">
                <i class="fas fa-arrow-left"></i> Volver a Temáticas
              </button>
            </div>
            
            <div class="modal-dificultad-botones">
              <button class="btn-cancelar-dificultad" onclick="cerrarModalTematicaDificultad()">
                <i class="fas fa-times"></i> Cancelar
              </button>
            </div>
          </div>
        </div>
        
        <button class="pre-examen-btn btn-secondary" onclick="location.href='/materias_carrera'">
          <i class="fas fa-arrow-left"></i> Volver a Carreras
        </button>
        <button class="pre-examen-btn btn-primary" onclick="location.href='/ranking'">
          <i class="fas fa-trophy"></i> Ver Ranking
        </button>
        
        {{#if preguntas.length}}
        <button class="pre-examen-btn btn-success pulse" onclick="comenzarExamen()">
          <i class="fas fa-play"></i> Iniciar Examen
        </button>
        {{else}}
        <button class="pre-examen-btn btn-success pulse" onclick="abrirModalTematicaDificultad()">
          <i class="fas fa-cog"></i> Configurar Examen
        </button>
        {{/if}}
      </div>
    </div>
  </div>
</div>

<!-- SECCIÓN EXAMEN -->
<div id="examenContent">
  <header>
    Examen - {{carrera}} {{#if tematicaNombre}}({{tematicaNombre}}){{/if}}
    <div><button onclick="volverAPreExamen()" class="btn-volver">Regresar</button></div>
  </header>

  {{#each preguntas}}
   <div class="contenedor-pregunta {{#if @first}}activa{{/if}}" data-index="{{@index}}" data-id-pregunta="{{id_pregunta}}">
    <div class="encabezado">
      <div>Pregunta {{sum @index 1}} de {{../preguntas.length}}</div>
      <div class="cronometro">10:00</div>
    </div>

    <h2 class="pregunta">{{pregunta}}</h2>

    <div class="opciones">
      {{#each respuestas}}
        <button type="button">{{respuesta}}</button>
      {{/each}}
    </div>

    <div class="navegacion">
      {{#unless @first}}
        <button type="button" class="btn-volver">← Volver</button>
      {{/unless}}
      <button type="button" class="btn-volver btnNoSeguro">No seguro / Para después</button>
      <button type="button" class="btn-volver btnVolverFinal" style="display:none;">Volver al final</button>
      
      {{#if @last}}
        <button type="button" class="btn-finalizar">Finalizar</button>
      {{else}}
        <button type="button" class="btn-siguiente">Siguiente →</button>
      {{/if}}
    </div>
  </div>
  {{/each}}

   <div id="pendientesContainer" class="pendientes-container">
    <div class="filter-toggle">
        <label for="toggleFiltro">Mostrar solo no respondidas</label>
        <input type="checkbox" id="toggleFiltro" checked>
    </div>
    <div id="listaPreguntasNavegacion"></div>
    </div>
      
  <form id="formResultados" method="POST" action="/resultados-carrera" style="display:none;">
    <input type="hidden" name="id_carrera" id="inputIdCarrera" value="{{id_carrera}}">
    <input type="hidden" name="respuestas" id="inputRespuestas">
    <input type="hidden" name="fecha_inicio_str" id="inputFechaInicio">
    <input type="hidden" name="id_dificultad" id="inputDificultad" value="{{dificultad}}">
    <input type="hidden" name="id_tematica" id="inputTematica" value="{{tematica}}">
 </form>
</div>

<!-- MODAL DE AVISO -->
<div id="avisoTiempo" class="modal-aviso oculto">
  <div class="modal-content">
    <p id="mensajeAviso">Te has quedado mucho tiempo en esta pregunta.</p>
    <button onclick="cerrarAviso()">Entendido</button>
  </div>
</div>

<script src="/public/js/examenCarrera.controller.js" defer></script>

<script>
// Variables globales para la configuración
window.ID_CARRERA = '{{id_carrera}}';
window.TEMATICAS = {{{json tematicas}}};

window.addEventListener('DOMContentLoaded', () => {
    const modalTematicaDificultad = document.getElementById('modalTematicaDificultad');
    const errorMsg = document.body.dataset.errorMsg;
    
    // Si hay mensaje de error, mostrar alerta y modal
    if (errorMsg) {
        alert(errorMsg);
        if (modalTematicaDificultad) {
            modalTematicaDificultad.classList.remove('oculto');
        }
    }
    
    {{#if mostrarModal}}
    if (modalTematicaDificultad) {
        modalTematicaDificultad.classList.remove('oculto');
    }
    {{/if}}
});
</script>
</body>
</html>
