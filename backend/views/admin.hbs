<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administración - ¡Que Buen Dato!</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<!-- ===== ENCABEZADO ===== -->
<header class="admin-header">
  <div class="header-left">
    <a href="/menu_principal">
      <img src="/media/images/logo.png" alt="¡Que Buen Dato!" class="logo-image-header">
    </a>
  </div>

  <div class="header-center">
    <h1 class="admin-title">Panel de Administración</h1>
    <p class="admin-welcome">Bienvenido {{user.username}} (ADMIN)</p>
  </div>

  <div class="header-right">
    <a href="/menu_principal" class="volver-button">← Volver</a>
  </div>
</header>

  <img src="/media/images/stuart_recargado.png" alt="Personaje Administrador" class="character-image">
<!-- ===== SECCIÓN PRINCIPAL ===== -->
<div class="admin-container">
  <h2 class="admin-subtitle mb-4">👥 Usuarios del Sistema</h2>

  <!-- Formulario principal para actualizar usuarios -->
  <form method="POST" action="/admin/actualizar-usuarios" class="admin-form">


    <!-- Tabla de usuarios con estilos de Bootstrap -->
    <div class="table-responsive">
      <table class="admin-table table table-striped table-hover">
        <thead>
          <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Nombre</th>
            <th>Rol Actual</th>
            <th>Cambiar Rol</th>
            <th>Estatus Actual</th>
            <th>Cambiar Estatus</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="usuarios-tbody">
          <!-- Iteración sobre los usuarios con Handlebars -->
          {{#each usuarios}}
          <tr>
            <td><strong>{{this.id_usuario}}</strong></td>
            <td>{{this.email}}</td>
            <td>{{this.username}}</td>
            <td>
              {{#if (eq this.id_tp_usuario 3)}}
                <span class="badge bg-danger">ADMIN</span>
              {{else if (eq this.id_tp_usuario 2)}}
                <span class="badge bg-warning text-dark">EDITOR</span>
              {{else}}
                <span class="badge bg-primary">USUARIO</span>
              {{/if}}
            </td>
            <td>
              <input type="hidden" name="usuario_ids[]" value="{{this.id_usuario}}">
              <select name="nuevos_roles[]" class="form-select form-select-sm" required>
                <option value="1" {{#if (eq this.id_tp_usuario 1)}}selected{{/if}}>USUARIO</option>
                <option value="2" {{#if (eq this.id_tp_usuario 2)}}selected{{/if}}>EDITOR</option>
                <option value="3" {{#if (eq this.id_tp_usuario 3)}}selected{{/if}}>ADMIN</option>
              </select>
            </td>
            <td>
              <span class="badge status-{{this.id_status}} bg-info">{{this.status}}</span>
            </td>
            <td>
              <select name="nuevos_status[]" class="form-select form-select-sm" required onchange="toggleSuspensionInput(this, {{this.id_usuario}})">
                <option value="1" {{#if (eq this.id_status 1)}}selected{{/if}}>Activo</option>
                <option value="2" {{#if (eq this.id_status 2)}}selected{{/if}}>Inactivo</option>
                <option value="3" {{#if (eq this.id_status 3)}}selected{{/if}}>Suspendido</option>
                <option value="4" {{#if (eq this.id_status 4)}}selected{{/if}}>Pendiente</option>
                <option value="5" {{#if (eq this.id_status 5)}}selected{{/if}}>Baja</option>
              </select>

              <input type="datetime-local" name="suspension_fin_{{this.id_usuario}}" class="form-control form-control-sm mt-2 suspension-input"
                    {{#unless (eq this.id_status 3)}}style="display:none;"{{/unless}}
                    value="{{this.suspension_fin}}">
            </td>
            <td>
              <button type="button" class="btn btn-sm btn-secondary" onclick="abrirModalEditar({{this.id_usuario}}, '{{this.username}}', '{{this.email}}')">✏️ Editar</button>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Botones principales de acción -->
    <div class="mt-3">
      <button type="button" class="btn btn-success" onclick="abrirModalAgregar()">➕ Agregar usuario</button>
      <button type="submit" class="btn btn-primary">💾 Guardar Cambios</button>
    </div>
  </form>
</div>

<!-- ===== MODALES ===== -->

<!-- Modal para editar usuario -->
<div class="modal fade" id="modalEditarUsuario" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="formEditarUsuario">
        <div class="modal-header">
          <h5 class="modal-title">✏️ Editar Usuario</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="edit-id_usuario" name="id_usuario">
          <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control" id="edit-username" name="username" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" id="edit-email" name="email" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Nueva contraseña (opcional)</label>
            <input type="password" class="form-control" id="edit-password" name="password" placeholder="Dejar en blanco para no cambiar">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal para agregar usuario -->
<div class="modal fade" id="modalAgregarUsuario" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="formAgregarUsuario">
        <div class="modal-header">
          <h5 class="modal-title">➕ Agregar Usuario</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input type="text" class="form-control" name="username" id="usernameAgregar" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" name="email" id="emailAgregar" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input type="password" class="form-control" name="password" id="passwordAgregar" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-success">Agregar Usuario</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ===== SCRIPTS ===== -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/public/js/admin.controller.js" defer></script>

</body>
</html>