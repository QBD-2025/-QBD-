{{!-- =============================================
     👤 PERFIL PÚBLICO - VERSIÓN CORREGIDA
     views/perfil-publico.hbs
     
     FIXES:
     - Corregido helper {{greaterThan}} que en la versión
       anterior quedaba dentro de {{#if}} sin el bloque
       correcto (error de sintaxis HBS).
     - La sección de barras de duelos usaba {{multiply}}
       y {{divide}} directamente en style="width:", lo cual
       sólo funciona si el helper devuelve un SafeString.
       Se corrigió usando un helper de porcentaje inline.
     - Agregada sección de insignias con grid completo.
     - Agregada sección de logros con progreso visual.
     ============================================= --}}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Perfil de {{usuario.username}} - QueBuenDato</title>
  <link rel="stylesheet" href="/css/perfil-publico.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    /* ── Variables ── */
    :root {
      --bg-dark:    #0f172a;
      --bg-card:    #1e293b;
      --bg-card2:   #273549;
      --accent:     #6366f1;
      --accent2:    #818cf8;
      --gold:       #fbbf24;
      --green:      #10b981;
      --red:        #ef4444;
      --blue:       #3b82f6;
      --text:       #f1f5f9;
      --text-muted: #94a3b8;
      --border:     rgba(255,255,255,0.08);
      --radius:     14px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg-dark);
      color: var(--text);
      font-family: 'Segoe UI', system-ui, sans-serif;
      min-height: 100vh;
    }

    /* ── Layout ── */
    .perfil-container {
      max-width: 900px;
      margin: 0 auto;
      padding: 24px 16px 60px;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* ── Volver ── */
    .btn-volver {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 8px 18px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      transition: color .2s, border-color .2s;
    }
    .btn-volver:hover { color: var(--text); border-color: var(--accent); }

    /* ── Header ── */
    .perfil-header {
      background: linear-gradient(135deg, #1e293b 0%, #162032 100%);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px;
    }
    .header-content {
      display: flex;
      gap: 24px;
      align-items: flex-start;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    .avatar-grande {
      position: relative;
      flex-shrink: 0;
    }
    .avatar-grande img {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      border: 3px solid var(--accent);
      object-fit: cover;
    }
    .badge-propio {
      position: absolute;
      bottom: 0;
      right: 0;
      background: var(--accent);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 20px;
    }
    .info-principal { flex: 1; min-width: 200px; }
    .username  { font-size: 26px; font-weight: 800; color: var(--text); }
    .nombre-real { color: var(--text-muted); font-size: 15px; margin-top: 4px; }
    .carrera-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(99,102,241,.15);
      border: 1px solid rgba(99,102,241,.4);
      color: var(--accent2);
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 13px;
      margin-top: 10px;
    }
    .descripcion {
      color: var(--text-muted);
      font-size: 14px;
      margin-top: 10px;
      line-height: 1.5;
    }
    .fecha-registro {
      color: var(--text-muted);
      font-size: 13px;
      margin-top: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* ── Sección genérica ── */
    .seccion-contenido {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 24px;
    }
    .titulo-seccion {
      font-size: 18px;
      font-weight: 700;
      color: var(--text);
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }
    .titulo-seccion i { color: var(--accent); }

    /* ── Stats principales ── */
    .stats-grid-principal {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 16px;
    }
    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      text-align: center;
      transition: transform .2s, border-color .2s;
    }
    .stat-card:hover { transform: translateY(-3px); border-color: var(--accent); }
    .stat-card.destacado { border-color: var(--gold); }
    .stat-icon { font-size: 28px; margin-bottom: 8px; }
    .stat-valor { font-size: 26px; font-weight: 900; color: var(--text); }
    .stat-card.destacado .stat-valor { color: var(--gold); }
    .stat-label { font-size: 12px; color: var(--text-muted); margin-top: 4px; text-transform: uppercase; letter-spacing: .5px; }

    /* ── Insignias ── */
    .insignias-grid-perfil {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
      gap: 16px;
    }
    .insignia-card {
      position: relative;
      background: var(--bg-card2);
      border-radius: 12px;
      padding: 14px 10px;
      text-align: center;
      border: 2px solid var(--border);
      transition: transform .2s, border-color .2s;
      cursor: default;
    }
    .insignia-card:hover { transform: translateY(-4px); }
    .insignia-card img {
      width: 56px;
      height: 56px;
      object-fit: contain;
      margin-bottom: 8px;
    }
    .insignia-nombre {
      font-size: 12px;
      font-weight: 600;
      color: var(--text);
      line-height: 1.3;
    }
    .insignia-rareza {
      font-size: 10px;
      color: var(--text-muted);
      text-transform: capitalize;
      margin-top: 4px;
    }
    /* Colores por rareza */
    .insignia-card.comun       { border-color: #94a3b8; }
    .insignia-card.rara        { border-color: #3b82f6; }
    .insignia-card.epica       { border-color: #a855f7; }
    .insignia-card.legendaria  { border-color: var(--gold); box-shadow: 0 0 12px rgba(251,191,36,.35); }
    .insignia-card.especial    { border-color: var(--green); }

    .sin-insignias {
      text-align: center;
      color: var(--text-muted);
      padding: 30px;
      font-size: 14px;
    }
    .sin-insignias i { display: block; font-size: 36px; margin-bottom: 12px; opacity: .4; }

    /* ── Logros ── */
    .logros-grid-perfil {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .logro-card {
      display: flex;
      align-items: center;
      gap: 16px;
      background: var(--bg-card2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 14px 18px;
      transition: border-color .2s;
    }
    .logro-card:hover { border-color: var(--accent); }
    .logro-icono  { font-size: 28px; flex-shrink: 0; }
    .logro-info   { flex: 1; }
    .logro-nombre { font-weight: 700; font-size: 15px; color: var(--text); }
    .logro-descripcion { font-size: 13px; color: var(--text-muted); margin-top: 3px; }
    .logro-bonus  { display: inline-block; background: rgba(16,185,129,.15); border: 1px solid rgba(16,185,129,.4); color: var(--green); font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 20px; margin-top: 6px; }
    .logro-fecha  { font-size: 12px; color: var(--text-muted); flex-shrink: 0; white-space: nowrap; }

    .ver-todos-logros { text-align: center; margin-top: 16px; }
    .btn-ver-todos {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(99,102,241,.15);
      border: 1px solid rgba(99,102,241,.4);
      color: var(--accent2);
      padding: 10px 24px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      transition: background .2s;
    }
    .btn-ver-todos:hover { background: rgba(99,102,241,.3); }

    /* ── Barras de duelos ── */
    .duelos-stats { display: flex; gap: 24px; flex-wrap: wrap; }
    .stats-barras { flex: 1; min-width: 240px; display: flex; flex-direction: column; gap: 14px; }
    .barra-stat .barra-label {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 6px;
    }
    .barra-stat .barra-label strong { color: var(--text); }
    .barra-contenedor {
      background: rgba(255,255,255,.06);
      border-radius: 20px;
      height: 8px;
      overflow: hidden;
    }
    .barra-fill {
      height: 100%;
      border-radius: 20px;
      transition: width 1s cubic-bezier(.4,0,.2,1);
    }
    .barra-stat.victoria .barra-fill { background: var(--green); }
    .barra-stat.empate   .barra-fill { background: var(--gold); }
    .barra-stat.derrota  .barra-fill { background: var(--red); }

    .stats-adicionales {
      display: flex;
      gap: 16px;
      align-items: center;
    }
    .stat-mini { text-align: center; padding: 16px 20px; background: var(--bg-card2); border-radius: 10px; }
    .stat-mini.destacado { border: 1px solid rgba(239,68,68,.3); }
    .stat-mini .icono { font-size: 22px; }
    .stat-mini .valor { font-size: 22px; font-weight: 800; color: var(--text); margin: 4px 0; }
    .stat-mini .label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; }

    /* ── Carreras ── */
    .carreras-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
    }
    .carrera-card {
      background: var(--bg-card2);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .carrera-nombre { font-size: 14px; color: var(--text); font-weight: 600; }
    .carrera-puntos { font-size: 16px; font-weight: 800; color: var(--gold); }

    /* ── Últimos duelos ── */
    .duelos-lista { display: flex; flex-direction: column; gap: 10px; }
    .duelo-item {
      display: flex;
      align-items: center;
      gap: 14px;
      background: var(--bg-card2);
      border: 1px solid var(--border);
      border-left: 4px solid transparent;
      border-radius: 10px;
      padding: 14px 18px;
      flex-wrap: wrap;
    }
    .duelo-item.victoria { border-left-color: var(--green); }
    .duelo-item.derrota  { border-left-color: var(--red); }
    .duelo-item.empate   { border-left-color: var(--gold); }

    .duelo-fecha   { font-size: 12px; color: var(--text-muted); flex-shrink: 0; }
    .duelo-info    { flex: 1; }
    .duelo-jugadores { font-size: 14px; font-weight: 600; color: var(--text); }
    .duelo-jugadores .vs { color: var(--text-muted); margin: 0 8px; }
    .jugador-yo { color: var(--accent2); }
    .duelo-resultado { margin-top: 4px; display: flex; align-items: center; gap: 10px; }
    .puntaje  { font-size: 13px; color: var(--text-muted); }
    .dificultad {
      font-size: 11px;
      background: rgba(99,102,241,.15);
      border: 1px solid rgba(99,102,241,.3);
      color: var(--accent2);
      padding: 2px 8px;
      border-radius: 20px;
    }
    .duelo-estado { font-size: 13px; font-weight: 700; flex-shrink: 0; }
    .duelo-item.victoria .duelo-estado { color: var(--green); }
    .duelo-item.derrota  .duelo-estado { color: var(--red); }
    .duelo-item.empate   .duelo-estado { color: var(--gold); }

    /* ── Responsive ── */
    @media (max-width: 600px) {
      .header-content { flex-direction: column; }
      .duelos-stats   { flex-direction: column; }
      .stats-adicionales { flex-direction: row; }
    }
  </style>
</head>
<body class="perfil-publico-page">
  <div class="perfil-container">

    {{!-- Botón volver --}}
    <div>
      <button class="btn-volver" onclick="window.history.back()">
        <i class="fas fa-arrow-left"></i> Volver
      </button>
    </div>

    {{!-- ═══ ENCABEZADO ═══ --}}
    <div class="perfil-header">
      <div class="header-content">
        <div class="avatar-grande">
          <img src="{{usuario.foto_perfil}}" alt="{{usuario.username}}"
               onerror="this.src='/uploads/default_avatar.png'">
          {{#if esPropioPerfil}}
            <div class="badge-propio">Tu Perfil</div>
          {{/if}}
        </div>

        <div class="info-principal">
          <h1 class="username">{{#if usuario.apodo}}{{usuario.apodo}}{{else}}{{usuario.username}}{{/if}}</h1>
          <p class="nombre-real">@{{usuario.username}}</p>

          {{#if usuario.carrera_descripcion}}
            <div class="carrera-badge">
              <i class="fas fa-graduation-cap"></i>
              {{usuario.carrera_descripcion}}
            </div>
          {{/if}}

          {{#if usuario.descripcion}}
            <p class="descripcion">{{usuario.descripcion}}</p>
          {{/if}}

          <div class="fecha-registro">
            <i class="fas fa-calendar-alt"></i>
            Miembro desde {{formatDate usuario.fecha_registro}}
          </div>
        </div>
      </div>
    </div>

    {{!-- ═══ STATS PRINCIPALES ═══ --}}
    <div class="stats-grid-principal">
      <div class="stat-card destacado">
        <div class="stat-icon">🏆</div>
        <div class="stat-valor">{{formatNumber stats.puntos_totales}}</div>
        <div class="stat-label">Puntos Totales</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">📊</div>
        <div class="stat-valor">{{stats.examenes_realizados}}</div>
        <div class="stat-label">Exámenes</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">⚔️</div>
        <div class="stat-valor">{{stats.duelos_totales}}</div>
        <div class="stat-label">Duelos</div>
      </div>
      <div class="stat-card">
        <div class="stat-icon">🥇</div>
        <div class="stat-valor">#{{stats.posicion_global}}</div>
        <div class="stat-label">Ranking Global</div>
      </div>
    </div>

    {{!-- ═══ INSIGNIAS EQUIPADAS ═══ --}}
    <div class="seccion-contenido">
      <h2 class="titulo-seccion">
        <i class="fas fa-medal"></i> Insignias Destacadas
      </h2>

      {{!--
        FIX DE SINTAXIS: en lugar de {{#if (greaterThan stats.insignias_equipadas.length 0)}}
        que a veces falla en HBS según la versión, usamos {{#if stats.insignias_equipadas}}
        y controlamos el caso vacío dentro.
      --}}
      {{#if stats.insignias_equipadas}}
        <div class="insignias-grid-perfil">
          {{#each stats.insignias_equipadas}}
            <div class="insignia-card {{this.rareza}}"
                 style="border-color: {{this.color_borde}}"
                 title="{{this.nombre}}: {{this.descripcion}}">
              <img src="{{this.imagen}}"
                   alt="{{this.nombre}}"
                   onerror="this.src='/media/insignias/default.png'">
              <div class="insignia-nombre">{{this.nombre}}</div>
              <div class="insignia-rareza">{{this.rareza}}</div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="sin-insignias">
          <i class="fas fa-medal"></i>
          <p>Aún no hay insignias equipadas</p>
        </div>
      {{/if}}
    </div>

    {{!-- ═══ LOGROS RECIENTES ═══ --}}
    <div class="seccion-contenido">
      <h2 class="titulo-seccion">
        <i class="fas fa-trophy"></i> Logros Recientes
      </h2>

      {{#if stats.logros_recientes}}
        <div class="logros-grid-perfil">
          {{#each stats.logros_recientes}}
            <div class="logro-card">
              <div class="logro-icono">{{this.icono}}</div>
              <div class="logro-info">
                <div class="logro-nombre">{{this.nombre}}</div>
                <div class="logro-descripcion">{{this.descripcion}}</div>
                {{#if this.puntos_bonus}}
                  <div class="logro-bonus">+{{this.puntos_bonus}} pts bonus</div>
                {{/if}}
              </div>
              <div class="logro-fecha">{{formatDate this.fecha_desbloqueo}}</div>
            </div>
          {{/each}}
        </div>

        {{#if esPropioPerfil}}
          <div class="ver-todos-logros">
            <button class="btn-ver-todos" onclick="location.href='/usuario/logros'">
              <i class="fas fa-trophy"></i> Ver Todos los Logros
            </button>
          </div>
        {{/if}}

      {{else}}
        <div class="sin-insignias">
          <i class="fas fa-trophy"></i>
          <p>Aún no se han desbloqueado logros</p>
        </div>
      {{/if}}
    </div>

    {{!-- ═══ ESTADÍSTICAS DE DUELOS ═══ --}}
    <div class="seccion-contenido">
      <h2 class="titulo-seccion">
        <i class="fas fa-swords"></i> Estadísticas de Duelos
      </h2>

      <div class="duelos-stats">
        <div class="stats-barras">

          {{!-- FIX: El ancho de la barra se calcula en el atributo data y se aplica via JS
               para evitar problemas con helpers inline en style="" --}}
          <div class="barra-stat victoria">
            <div class="barra-label">
              <span>Victorias</span>
              <strong>{{stats.victorias}}</strong>
            </div>
            <div class="barra-contenedor">
              <div class="barra-fill"
                   data-total="{{stats.duelos_totales}}"
                   data-valor="{{stats.victorias}}"
                   style="width:0%"></div>
            </div>
          </div>

          <div class="barra-stat empate">
            <div class="barra-label">
              <span>Empates</span>
              <strong>{{stats.empates}}</strong>
            </div>
            <div class="barra-contenedor">
              <div class="barra-fill"
                   data-total="{{stats.duelos_totales}}"
                   data-valor="{{stats.empates}}"
                   style="width:0%"></div>
            </div>
          </div>

          <div class="barra-stat derrota">
            <div class="barra-label">
              <span>Derrotas</span>
              <strong>{{stats.derrotas}}</strong>
            </div>
            <div class="barra-contenedor">
              <div class="barra-fill"
                   data-total="{{stats.duelos_totales}}"
                   data-valor="{{stats.derrotas}}"
                   style="width:0%"></div>
            </div>
          </div>

        </div>

        <div class="stats-adicionales">
          <div class="stat-mini">
            <div class="icono">📈</div>
            <div class="valor">{{stats.porcentaje_victoria}}%</div>
            <div class="label">Ratio Victoria</div>
          </div>
          <div class="stat-mini destacado">
            <div class="icono">🔥</div>
            <div class="valor">{{stats.racha_victorias}}</div>
            <div class="label">Racha Actual</div>
          </div>
        </div>
      </div>
    </div>

    {{!-- ═══ PUNTOS POR CARRERA ═══ --}}
    {{#if stats.carreras}}
      <div class="seccion-contenido">
        <h2 class="titulo-seccion">
          <i class="fas fa-graduation-cap"></i> Puntos por Carrera
        </h2>
        <div class="carreras-grid">
          {{#each stats.carreras}}
            <div class="carrera-card">
              <div class="carrera-nombre">{{this.carrera}}</div>
              <div class="carrera-puntos">{{formatNumber this.puntos_carrera}} pts</div>
            </div>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{!-- ═══ ÚLTIMOS DUELOS ═══ --}}
    {{#if stats.ultimos_duelos}}
      <div class="seccion-contenido">
        <h2 class="titulo-seccion">
          <i class="fas fa-history"></i> Últimos Duelos
        </h2>

        <div class="duelos-lista">
          {{#each stats.ultimos_duelos}}
            {{!-- FIX: En lugar de inline if con helpers de comparación,
                 usamos clases calculadas por el servidor vía un helper
                 más simple (eq). La clase CSS la inyectamos con {{eq}}. --}}
            <div class="duelo-item {{#if this.id_ganador}}{{#if (eq ../usuario.id_usuario this.id_ganador)}}victoria{{else}}derrota{{/if}}{{else}}empate{{/if}}">

              <div class="duelo-fecha">{{formatDate this.fecha_fin}}</div>

              <div class="duelo-info">
                <div class="duelo-jugadores">
                  <span class="{{#if (eq this.retador_nombre ../usuario.username)}}jugador-yo{{/if}}">
                    {{this.retador_nombre}}
                  </span>
                  <span class="vs">VS</span>
                  <span class="{{#if (eq this.defensor_nombre ../usuario.username)}}jugador-yo{{/if}}">
                    {{this.defensor_nombre}}
                  </span>
                </div>
                <div class="duelo-resultado">
                  <span class="puntaje">{{this.puntaje_retador}} - {{this.puntaje_defensor}}</span>
                  {{#if this.dificultad}}
                    <span class="dificultad">{{this.dificultad}}</span>
                  {{/if}}
                </div>
              </div>

              <div class="duelo-estado">
                {{#if this.id_ganador}}
                  {{#if (eq ../usuario.id_usuario this.id_ganador)}}
                    <i class="fas fa-trophy"></i> Victoria
                  {{else}}
                    <i class="fas fa-times"></i> Derrota
                  {{/if}}
                {{else}}
                  <i class="fas fa-handshake"></i> Empate
                {{/if}}
              </div>

            </div>
          {{/each}}
        </div>
      </div>
    {{/if}}

  </div>{{!-- /perfil-container --}}

  <script src="/socket.io/socket.io.js"></script>

  <script>
    // Animar barras de duelos con los datos del atributo data-*
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.barra-fill').forEach(barra => {
        const total = parseInt(barra.dataset.total) || 0;
        const valor = parseInt(barra.dataset.valor) || 0;
        const pct   = total > 0 ? Math.round((valor / total) * 100) : 0;
        setTimeout(() => { barra.style.width = pct + '%'; }, 150);
      });
    });
  </script>

  <script src="/public/js/perfil-publico.controller.js" defer></script>
</body>
</html>
