<!-- views/dato-sesion.hbs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <!-- Configuración de codificación de caracteres -->
    <meta charset="UTF-8">
    
    <!-- Configuración para que la página sea responsive en dispositivos móviles -->
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    
    <!-- Título de la página -->
    <title> QueBuenDato.com </title>
    
    <!-- Vinculación del archivo CSS específico para esta vista -->
    <link rel="stylesheet" href="/css/dato-sesion.css">
</head>
<body>
  <!-- Contenedor principal para mostrar el dato curioso -->
  <div class="dato-container">
    
    <!-- Título de la sección -->
    <h2 class="title">¡Que buenos datos!</h2>
    
    <!-- Mostrar el dato curioso que proviene del servidor -->
    <p class="texto-dato">{{dato}}</p>
    
    <!-- Si hay imagen asociada al dato, se renderiza -->
    {{#if imagen}}
      <img src="data:image/jpeg;base64,{{imagen}}" alt="Imagen del dato curioso">
    {{/if}}
    
    <!-- Mensaje de aviso de redirección -->
    <p style="margin-top: 1.5em; color: #888;">haz doble click para continuar</p>
  </div>
  
  <!-- Reproducción automática de sonido asociado al dato -->
  <audio id="sonidoCurioso" src="/media/audio/curioso.mp3" preload="auto" autoplay></audio>

  <script src="/public/js/dato.controller.js" defer></script> 
</body>
</html>
