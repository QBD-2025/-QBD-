<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>📊 Mi Progreso</title>
  <link rel="stylesheet" href="/css/historialUnificado.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <header class="header">
      <h1>📊 Mi Progreso</h1>
      <a href="/usuario" class="btn-volver">⬅ Volver al Perfil</a>
    </header>

    <!-- Navegación por Pestañas -->
    <nav class="tabs">
      <button class="tab-btn active" data-tab="examenes">
        📝 Exámenes ({{examenes.length}})
      </button>
      <button class="tab-btn" data-tab="duelos">
        ⚔️ Duelos ({{duelos.length}})
      </button>
      <button class="tab-btn" data-tab="estadisticas">
        📈 Estadísticas
      </button>
    </nav>

    <!-- ==================== TAB 1: EXÁMENES ==================== -->
    <section id="tab-examenes" class="tab-content active">
      <h2>📝 Historial de Exámenes</h2>
      
      {{#if tieneExamenes}}
        <div class="table-wrapper">
          <table class="tabla-historial">
            <thead>
              <tr>
                <th>#</th>
                <th>Materia</th>
                <th>Puntaje</th>
                <th>Porcentaje</th>
                <th>Fecha</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {{#each examenes}}
                <tr>
                  <td>{{inc @index}}</td>
                  <td>{{materia}}</td>
                  <td>{{puntos}} / {{total}}</td>
                  <td>
                    <span class="badge {{#if (gte porcentaje 70)}}success{{else if (gte porcentaje 50)}}warning{{else}}danger{{/if}}">
                      {{porcentaje}}%
                    </span>
                  </td>
                  <td>{{fecha}}</td>
                  <td>
                    <a href="/usuario/historial/examen/{{id_examen}}" class="btn-accion">
                      👁️ Ver
                    </a>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="empty-state">
          <div class="empty-icon">📭</div>
          <p>No has realizado ningún examen todavía</p>
          <a href="/menu_principal" class="btn-primary">Ir a Exámenes</a>
        </div>
      {{/if}}
    </section>

    <!-- ==================== TAB 2: DUELOS ==================== -->
    <section id="tab-duelos" class="tab-content">
      <h2>⚔️ Historial de Duelos</h2>
      
      {{#if tieneDuelos}}
        <div class="table-wrapper">
          <table class="tabla-historial">
            <thead>
              <tr>
                <th>#</th>
                <th>Oponente</th>
                <th>Tipo</th>
                <th>Resultado</th>
                <th>Puntaje</th>
                <th>Dificultad</th>
                <th>Apuesta</th>
                <th>Fecha</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody>
              {{#each duelos}}
                <tr class="duelo-row {{resultado}}">
                  <td>{{inc @index}}</td>
                  <td>
                    <strong>{{oponente}}</strong>
                  </td>
                  <td>
                    <span class="badge-tipo {{tipo}}">
                      {{#if (eq tipo 'carrera')}}🎓 Carrera{{else}}🌍 General{{/if}}
                    </span>
                  </td>
                  <td>
                    <span class="resultado-badge {{resultado}}">
                      {{#if (eq resultado 'Victoria')}}🏆 Victoria
                      {{else if (eq resultado 'Empate')}}🤝 Empate
                      {{else}}😔 Derrota{{/if}}
                    </span>
                  </td>
                  <td>
                    {{mis_correctas}}/{{total}} 
                    <small>({{porcentaje}}%)</small>
                  </td>
                  <td>
                    <span class="badge-dificultad {{dificultad}}">
                      {{dificultad}}
                    </span>
                  </td>
                  <td>
                    <span class="apuesta">{{apuesta}} pts</span>
                  </td>
                  <td>{{fecha}}</td>
                  <td>
                    <a href="/usuario/historial/duelo/{{id_duelo}}" class="btn-accion">
                      👁️ Ver
                    </a>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <div class="empty-state">
          <div class="empty-icon">⚔️</div>
          <p>No has participado en ningún duelo todavía</p>
          <a href="/portal" class="btn-primary">Ir a Duelos</a>
        </div>
      {{/if}}
    </section>

    <!-- ==================== TAB 3: ESTADÍSTICAS ==================== -->
    <section id="tab-estadisticas" class="tab-content">
      <h2>📈 Mis Estadísticas de Duelos</h2>
      
      <!-- Loading -->
      <div id="loading" class="loading-overlay" style="display: none;">
        <div class="spinner"></div>
        <p>Cargando estadísticas...</p>
      </div>

      <!-- Resumen -->
      <div class="stats-summary">
        <div class="stat-card">
          <div class="stat-icon">🏆</div>
          <div class="stat-content">
            <h3 id="victorias">-</h3>
            <p>Victorias</p>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">😔</div>
          <div class="stat-content">
            <h3 id="derrotas">-</h3>
            <p>Derrotas</p>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🤝</div>
          <div class="stat-content">
            <h3 id="empates">-</h3>
            <p>Empates</p>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">📈</div>
          <div class="stat-content">
            <h3 id="promedio">-%</h3>
            <p>Promedio</p>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">💎</div>
          <div class="stat-content">
            <h3 id="puntos">-</h3>
            <p>Puntos</p>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon">🔥</div>
          <div class="stat-content">
            <h3 id="racha">-</h3>
            <p>Racha</p>
          </div>
        </div>
      </div>

      <!-- Gráficas -->
      <div class="charts-grid">
        <div class="chart-container">
          <h3>📊 Distribución de Resultados</h3>
          <canvas id="chartResultados"></canvas>
        </div>

        <div class="chart-container">
          <h3>📊 Rendimiento por Dificultad</h3>
          <canvas id="chartDificultad"></canvas>
        </div>

        <div class="chart-container full-width">
          <h3>📈 Evolución (Últimos 30 duelos)</h3>
          <canvas id="chartEvolucion"></canvas>
        </div>

        <div class="chart-container">
          <h3>⚔️ Por Tipo de Duelo</h3>
          <canvas id="chartTipo"></canvas>
        </div>

        <div class="chart-container">
          <h3>🏅 Top 5 Jugadores</h3>
          <canvas id="chartTop5"></canvas>
        </div>
      </div>

      <!-- Recomendaciones -->
      <div class="recommendations">
        <h3>💡 Recomendaciones</h3>
        <div id="recommendationsContent"></div>
      </div>
    </section>
  </div>

  <script src="../../public/js/historial.controller.js"></script>
</body>
</html>