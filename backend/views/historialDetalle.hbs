<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Detalle del Examen</title>
  <link rel="stylesheet" href="/css/historialUsuario.css">
</head>
<body>
  <header class="header">
    <h1> Resumen del Examen </h1>
    <a href="/usuario/historial" class="btn-volver">⬅ Volver al Historial</a>
  </header>

  {{#if examen}}
    <div class="summary-card">
        <h2>{{examen.materia}}</h2>
        <p>Realizado el: <strong>{{examen.fecha}}</strong></p>
        <div class="score-display">
            <span class="percentage">{{examen.porcentaje}}%</span>
            <span class="points">({{examen.obtenido}} de {{examen.maximo}} puntos)</span>
        </div>
    </div>

    {{#if preguntas}}
      <div class="preguntas-container">
        <h2> Preguntas del Examen</h2>
        
        {{#each preguntas}}
          <div class="pregunta-card {{#if this.esCorrecta}}correcta{{else}}incorrecta{{/if}}">
            <h3>Pregunta {{inc @index}}</h3>
            
            <p class="pregunta-texto"><strong>{{this.pregunta}}</strong></p>
            
            <div class="respuesta-info">
              <p class="respuesta-usuario">
                <strong>Tu respuesta:</strong> {{this.textoSeleccionado}} 
                {{#if this.esCorrecta}}✅{{else}}❌{{/if}}
              </p>
              
              {{#unless this.esCorrecta}}
                <p class="respuesta-correcta">
                  <strong>Respuesta correcta:</strong> {{this.textoCorrecto}}
                </p>
              {{/unless}}
              
              {{#if this.retroalimentacion}}
                <p class="retroalimentacion"> {{this.retroalimentacion}}</p>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="no-datos">No se encontraron preguntas para este examen.</p>
    {{/if}}

  {{else}}
    <p class="no-datos">No se encontraron detalles de este examen.</p>
  {{/if}}
</body>
</html>