<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Detalle del Examen</title>

  <!-- Estilos externos específicos para el historial del usuario -->
  <link rel="stylesheet" href="/css/historialUsuario.css">
</head>
<body>

  <!-- Encabezado de la página -->
  <header class="header">
    <!-- Título de la página con icono de lápiz -->
    <h1>📝 Resumen del Examen</h1>

    <!-- Botón para volver al historial general de exámenes del usuario -->
    <a href="/usuario/historial" class="btn-volver">⬅ Volver al Historial</a>
  </header>

  <!-- Verificar si hay un examen disponible usando Handlebars -->
  {{#if examen}}
    <!-- Tarjeta resumen del examen -->
    <div class="summary-card">
        <!-- Mostrar el nombre de la materia -->
        <h2>{{examen.materia}}</h2>

        <!-- Fecha en que se realizó el examen -->
        <p>Realizado el: <strong>{{examen.fecha}}</strong></p>

        <!-- Sección para mostrar calificación y puntaje -->
        <div class="score-display">
            <!-- Porcentaje obtenido en el examen -->
            <span class="percentage">{{examen.porcentaje}}%</span>
            <!-- Puntos obtenidos de los posibles -->
            <span class="points">({{examen.obtenido}} de {{examen.maximo}} puntos)</span>
        </div>
    </div>
  {{else}}
    <!-- Mensaje en caso de que no haya detalles del examen -->
    <p class="no-datos">No se encontraron detalles de este examen.</p>
  {{/if}}

</body>
</html>