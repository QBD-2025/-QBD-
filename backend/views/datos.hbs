<!DOCTYPE html>
<html lang="es">
<head>
  <!-- Configuración de codificación -->
  <meta charset="UTF-8">
  
  <!-- Título dinámico de la página según la materia -->
  <title>Datos Curiosos - {{materias}}</title>
  
  <!-- Vinculación de la hoja de estilos específica para la vista -->
  <link rel="stylesheet" href="/css/dato.css">
</head>
<body>
  <!-- Contenedor principal de la página -->
  <div class="contenedor-datos">
    
    <!-- Botón para regresar a la selección de materias -->
    <div>
      <button class="boton-volver" onclick="location.href='/eleccion-dato'">Regresar</button>
    </div>
    
    <!-- Título principal con el nombre de la materia -->
    <h1 class="titulo">{{materias}}</h1>

    <!-- Verifica si hay datos curiosos para mostrar -->
    {{#if datos.length}}
      <!-- Contenedor de la lista de datos -->
      <div class="lista-datos">
        
        <!-- Itera sobre cada dato curioso -->
        {{#each datos}}
        <div class="tarjeta-dato">
          <!-- Muestra el texto del dato -->
          <p class="texto-dato">{{texto}}</p>
          
          <!-- Si existe una imagen en Base64, la muestra -->
          {{#if imagenBase64}}
            <img src="data:image/jpeg;base64,{{imagenBase64}}" alt="Imagen del dato curioso" class="imagen-dato">
          {{/if}}
        </div>
        {{/each}}
      </div>
    {{else}}
      <!-- Mensaje si no hay datos curiosos para la materia -->
      <p class="sin-datos">No hay datos curiosos para esta materia.</p>
    {{/if}}

    <!-- Script para un carrusel 3D de tarjetas-->
    <script src="/public/js/datos.controller.js" defer></script>
    
  </div>
</body>
</html>
