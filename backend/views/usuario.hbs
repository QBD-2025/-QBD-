<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" /> <!-- Codificación UTF-8 -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <!-- Responsive en móviles -->
  <title>QueBuenDato.com.mx</title> <!-- Título de la página -->
  <link rel="stylesheet" href="/css/usuario.css" /> <!-- Hoja de estilos externa -->

  <!-- Google Fonts: Poppins -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Contenedor principal del perfil -->
  <div class="profile-full">
    <div class="profile-card">
      <body class="page-usuario"> <!-- Clase para estilos específicos de la página -->

      <!-- Encabezado del perfil -->
      <header class="profile-header">
        <h1 class="profile-title">Mi Cuenta</h1> <!-- Título principal -->
        <p class="user-welcome">Bienvenido {{user.username}} ({{user.role}})</p> <!-- Saludo dinámico -->
        <a href="/logout" class="logout-btn">Cerrar sesión</a> <!-- Botón para cerrar sesión -->
      </header>

      <!-- Contenido principal del perfil -->
      <div class="profile-body">
        <h2 class="user-subtitle">Tu información</h2>

        <!-- Tabla con la información del usuario -->
        <table class="info-table">
          <tr>
            <th>ID</th>
            <td>{{user.id_usuario}}</td> <!-- ID del usuario -->
          </tr>
          <tr>
            <th>Email</th>
            <td>{{user.email}}</td> <!-- Correo del usuario -->
          </tr>
          <tr>
            <th>Nombre de usuario</th>
            <td>{{user.username}}</td> <!-- Nombre de usuario -->
          </tr>
          <tr>
            <th>Alias</th>
            <td>{{user.apodo}}</td> <!-- Apodo del usuario -->
          </tr>
          <tr>
            <th>Tipo de cuenta</th>
            <td>{{user.role}}</td> <!-- Rol del usuario -->
          </tr>
          <tr>
            <th>Descripcion</th>
            <td>{{user.descripcion}}</td> <!-- Descripción del perfil -->
          </tr>
        </table>

        <!-- Sección de acciones que el usuario puede realizar -->
        <div class="actions-section">
          <h3>Acciones disponibles</h3>
          <ul class="actions-list">
            <li class="action-item">
              <a href="/buscar-correo" class="action-link">Cambiar mi contraseña</a> <!-- Redirige a cambio de contraseña -->
            </li>
            <li class="action-item">
              <a href="/usuario/editar" class="action-link">Editar mi perfil</a> <!-- Redirige a edición de perfil -->
            </li>
            
          </ul>
        </div>

        <!-- Botón de regreso al menú principal -->
      <button onclick="window.location.href='/menu_principal'" class="back-button">
        Regresar
      </button>
      </div> <!-- Fin profile-body -->
    </div> <!-- Fin profile-card -->
  </div> <!-- Fin profile-full -->
</body>
</html>
