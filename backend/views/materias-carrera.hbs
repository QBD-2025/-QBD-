  <title>Examenes de Carrera</title> <!-- Título de la página -->
  
  <!-- Estilos externos -->
  <link rel="stylesheet" href="/css/eleccion-examen.css" />

  <!-- Estilos internos para las tarjetas -->

</head>
<body>
