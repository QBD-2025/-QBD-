<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>QueBuenDato.com - Portal Principal</title>           
    <link rel="stylesheet" href="/css/perfil.css">
    
    {{!-- GOOGLE FONTS --}}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700;800&display=swap" rel="stylesheet">
    
    {{!-- SweetAlert2 para el modal de bienvenida --}}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>

<body>
<div class="duo-style-wrapper">

    {{!-- ========= CONTENEDOR PREMIUM 1: MINIJUEGOS ========= --}}
    <div class="mode-container minijuegos" onclick="location.href='/minijuegos'">
        <div class="mode-badge">🎮 Popular</div>
        <div class="mode-content">
            <div class="mode-text">
                <div class="mode-title-wrapper">
                    <span class="mode-icon">🎮</span>
                    <h2 class="mode-title">Divertido, efectivo y retador</h2>
                </div>
                <p class="mode-description">Aprende jugando con minijuegos interactivos diseñados para hacer el aprendizaje más divertido y memorable. Desafía tu mente mientras te diviertes.</p>
            </div>
            <div class="mode-video">
                <div id="animationContainer2" class="animacion-duolingo">
                    <img id="duolingoAnimation2" src="/media/video_stuart_octavio/frame-1.webp" alt="Animación Minijuegos">
                </div>
            </div>
        </div>
    </div>

    {{!-- ========= CONTENEDOR PREMIUM 2: EXÁMENES DE PRÁCTICA (REVERSE) ========= --}}
    <div class="mode-container examenes reverse" onclick="location.href='/materias'">
        <div class="mode-content">
            <div class="mode-text">
                <div class="mode-title-wrapper">
                    <span class="mode-icon">📝</span>
                    <h2 class="mode-title">Refuerza tu conocimiento</h2>
                </div>
                <p class="mode-description">Pon a prueba lo que has aprendido con exámenes diseñados para reforzar tu comprensión y prepararte para los desafíos reales.</p>
            </div>
            <div class="mode-video">
                <div id="animationContainer" class="animacion-duolingo">
                    <img id="duolingoAnimation" src="/media/stuart_octavio_libro/frame-1.webp" alt="Animación Exámenes">
                </div>
            </div>
        </div>
    </div>

    {{!-- ========= CONTENEDOR PREMIUM 3: SIMULADOR ========= --}}
    <div class="mode-container simulador" onclick="location.href='/simulador'">
        <div class="mode-badge">⚡ Nuevo</div>
        <div class="mode-content">
            <div class="mode-text">
                <div class="mode-title-wrapper">
                    <span class="mode-icon">🎯</span>
                    <h2 class="mode-title">Desafíos de intelecto avanzado</h2>
                </div>
                <p class="mode-description">Enfréntate a simulaciones realistas que te preparan para los retos más difíciles. Sorprende a tu intelecto con nuevos desafíos.</p>
            </div>
            <div class="mode-video">
                <div id="animationContainer5" class="animacion-duolingo">
                    <img id="duolingoAnimation5" src="media/video_admision_000/frame-1.webp" alt="Animación Simulador">
                </div>
            </div>
        </div>
    </div>

    {{!-- ========= CONTENEDOR PREMIUM 4: CLASIFICACIÓN (REVERSE) ========= --}}
    <div class="mode-container ranking reverse" onclick="location.href='/ranking'">
        <div class="mode-content">
            <div class="mode-text">
                <div class="mode-title-wrapper">
                    <span class="mode-icon">🏆</span>
                    <h2 class="mode-title">Tu progreso y clasificación</h2>
                </div>
                <p class="mode-description">Sube en el ranking, desbloquea logros y demuestra que eres el mejor estudiante. Compite con otros y alcanza la cima.</p>
            </div>
            <div class="mode-video">
                <div id="animationContainer7" class="animacion-duolingo">
                    <img id="duolingoAnimation7" src="/media/video_clasifica/frame-8.webp" alt="Animación Clasificación">
                </div>
            </div>
        </div>
    </div>

    {{!-- ========= CONTENEDOR PREMIUM 5: MODO COMPETITIVO ========= --}}
    <div class="mode-container competitivo" onclick="location.href='/portal'">
        <div class="mode-badge">🔥 Hot</div>
        <div class="mode-content">
            <div class="mode-text">
                <div class="mode-title-wrapper">
                    <span class="mode-icon">⚔️</span>
                    <h2 class="mode-title">¡Demuestra quién es el mejor!</h2>
                </div>
                <p class="mode-description">Enfréntate a otros jugadores en batallas de conocimiento en tiempo real. La competencia más épica te espera.</p>
            </div>
            <div class="mode-video">
                <div id="animationContainer6" class="animacion-duolingo">
                    <img id="duolingoAnimation6" src="/media/animacion-competitivo/animacion-competitivo_000001.webp" alt="Animación Batalla">
                </div>
            </div>
        </div>
    </div>

    {{!-- ========= CONTENEDOR PREMIUM 6: DATOS (REVERSE) ========= --}}
    <div class="mode-container datos reverse" onclick="location.href='/eleccion-dato'">
        <div class="mode-content">
            <div class="mode-text">
                <div class="mode-title-wrapper">
                    <span class="mode-icon">📚</span>
                    <h2 class="mode-title">Datos que te hacen sobresalir</h2>
                </div>
                <p class="mode-description">Descubre datos fascinantes y curiosidades que ampliarán tu conocimiento. Aprende algo nuevo cada día.</p>
            </div>
            <div class="mode-video">
                <div id="animationContainer3" class="animacion-duolingo">
                    <img id="duolingoAnimation3" src="/media/caminando_stuart_octavio/frame-1.webp" alt="Animación Datos">
                </div>
            </div>
        </div>
    </div>

    {{!-- ========= BOTÓN FLOTANTE CIRCULAR ========= --}}
    <button class="floating-button" onclick="location.href='/ligas'" aria-label="Ir a Ligas">🧷</button>

</div>

{{!-- ========= SCRIPTS ========= --}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
<script src="/js/theme-animation-system.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    // Mejorar interacción del botón flotante
    const floatingBtn = document.querySelector('.floating-button');
    if (floatingBtn) {
        floatingBtn.addEventListener('mouseenter', function() {
            this.style.animation = 'none';
        });
        
        floatingBtn.addEventListener('mouseleave', function() {
            this.style.animation = 'pulse 2s infinite';
        });
    }

    // Agregar efecto de cursor en contenedores
    const containers = document.querySelectorAll('.mode-container');
    containers.forEach(container => {
        container.addEventListener('mouseenter', function() {
            this.style.cursor = 'pointer';
        });
    });

// ✨ MODAL DE BIENVENIDA PARA NUEVOS USUARIOS - CORREGIDO ✅
{{#if mostrarBienvenida}}
document.addEventListener('DOMContentLoaded', function() {
    const userName = '{{user.apodo}}' || '{{user.username}}' || 'Usuario';
    const puntos = {{puntosActuales}} || 0;
    
    // Inyectamos estilos personalizados para este modal específico
    const style = document.createElement('style');
    style.innerHTML = `
        /* Título más pequeño */
        .swal-bienvenida-title {
            font-size: 1.5rem !important; 
            color: #333 !important;
        }
        /* Ajuste del popup */
        .swal-bienvenida-modal {
            border-radius: 15px !important;
            padding: 20px !important;
        }
        /* Evitar que el botón se quede con focus visible */
        .swal-btn-confirm:focus {
            outline: none !important;
            box-shadow: none !important;
        }
    `;
    document.head.appendChild(style);

    Swal.fire({
        title: `¡Bienvenido, ${userName}!`,
        html: `
            <div style="text-align: center; margin-bottom: 15px;">
                <img src="/media/images/Bienvenida_personajes.png" 
                     alt="Bienvenida" 
                     style="max-width: 50%; height: auto; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
            </div>
            <div style="text-align: left; padding: 0 15px; font-size: 15px; line-height: 1.6;">
                <p style="margin-bottom: 10px;">
                    <strong>¡Ten estos <span style="color: #FFD700; font-size: 19px; text-shadow: 1px 1px 2px rgba(0,0,0,0.1);">50 puntos</span> de regalo!</strong>
                </p>
                <p style="margin-bottom: 10px;">
                    Podrás conseguir más entre más interactúes con el sistema.
                </p>
                <p style="margin-bottom: 8px;">Con ellos podrás:</p>
                <ul style="list-style: none; padding-left: 0; margin-bottom: 10px;">
                    <li style="margin-bottom: 6px;"> <strong>Competir</strong> en modos competitivos</li>
                    <li style="margin-bottom: 6px;"> <strong>Escalar</strong> en el ranking</li>
                    <li style="margin-bottom: 6px;"> <strong>Desbloquear</strong> logros</li>
                </ul>
                <p style="text-align: center; font-weight: bold; color: #4CAF50; margin-top: 20px;">
                    ¡Buena suerte en tu Viaje!
                </p>
            </div>
        `,
        icon: null,
        width: '650px',
        padding: '1em',
        background: '#fff',
        
        confirmButtonText: '¡Empecemos! ',
        confirmButtonColor: '#4CAF50',
        focusConfirm: false,

        customClass: {
            popup: 'swal-bienvenida-modal',
            title: 'swal-bienvenida-title',
            confirmButton: 'swal-btn-confirm'
        },

        showClass: {
            popup: 'animate__animated animate__bounceIn'
        },
        hideClass: {
            popup: 'animate__animated animate__fadeOut'
        },

        allowOutsideClick: false,
        allowEscapeKey: false
    }).then((result) => {
        // ✅ SOLUCIÓN AL ERROR: Limpieza completa del modal
        if (result.isConfirmed) {
            // 1. Cerrar el modal inmediatamente
            Swal.close();
            
            // 2. Pequeño delay para asegurar que la animación termine
            setTimeout(() => {
                // 3. Eliminar cualquier contenedor residual de SweetAlert
                const swalContainer = document.querySelector('.swal2-container');
                if (swalContainer) {
                    swalContainer.remove();
                }
                
                // 4. Quitar el fondo oscuro (backdrop) si quedó
                const swalBackdrop = document.querySelector('.swal2-backdrop-show');
                if (swalBackdrop) {
                    swalBackdrop.remove();
                }
                
                // 5. Quitar focus de cualquier elemento activo
                if (document.activeElement && document.activeElement !== document.body) {
                    document.activeElement.blur();
                }
                
                // 6. Remover clase que bloquea el scroll del body (por si acaso)
                document.body.classList.remove('swal2-shown', 'swal2-height-auto');
                document.documentElement.classList.remove('swal2-shown', 'swal2-height-auto');
                
                console.log('✅ Modal de bienvenida cerrado completamente');
            }, 150); // Delay mínimo para que termine la animación de salida
        }
    });
});
{{/if}}
</script>

</body>
</html>