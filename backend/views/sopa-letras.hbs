<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/sopa-letras.css" />
  <title>Sopa de Letras Multijugador</title>
</head>
<body>
  <div class="page">
    <div class="header">
      <div class="title">🧩 Sopa de Letras Multijugador</div>
      <div class="pill">
        Jugador: <strong>{{#if user}}{{user.username}}{{else}}Invitado{{/if}}</strong>
      </div>
      <button onclick="location.href='/minijuegos'"> ← Regresar</button>
    </div>

    <div class="layout">
      <section class="game card">

        <!-- ========== MODO NORMAL (INDIVIDUAL/COOPERATIVO) ========== -->
        <div id="normal-mode">
          <div class="status panel">
            <div>
              <div class="small">Progreso</div>
              <div id="progressText"><strong>0</strong>/<strong id="totalWords">0</strong> palabras</div>
            </div>
            <div class="badge" id="errorsBadge">0 / 4</div>
          </div>
          
          <div class="controls">
            <label for="categoria-select">Categoría:</label>
            <select id="categoria-select">
              <option>Cargando categorías...</option>
            </select>
            <button id="btnClear">Limpiar selección</button>
            <button id="btnRestart" class="primary">Reiniciar</button>
          </div>
          
          <div id="board" class="board" aria-label="Tablero de sopa de letras"></div>
          <div id="gameMessage" class="message" role="status" aria-live="polite"></div>
        </div>

        <!-- ========== MODO ENFRENTAMIENTO ========== -->
        <div id="confrontation-mode" style="display: none;">
          
          <!-- PANEL DE VOTACIÓN DE CATEGORÍA -->
          <div id="voting-panel" class="panel" style="display: none;">
            <h4>🗳️ Selección de Categoría</h4>
            
            <!-- ÁREA 1: Estado actual de la votación -->
            <div id="propuesta-actual">
              <p>Esperando que un jugador proponga una categoría...</p>
            </div>
            
            <!-- ÁREA 2: Proponer categoría -->
            <div id="area-proponer" style="display: none;">
              <label for="confrontation-categoria-select">Elige una categoría:</label>
              <select id="confrontation-categoria-select">
                <option>Cargando...</option>
              </select>
              <button id="propose-category-btn" class="primary">📤 Proponer</button>
            </div>

            <!-- ÁREA 3: Votar -->
            <div id="area-votar" style="display: none;">
              <button id="aceptar-categoria-btn" class="primary btn-aceptar">✅ Aceptar</button>
              <button id="rechazar-categoria-btn" class="btn-rechazar">❌ Rechazar</button>
            </div>
          </div>
          
          <!-- TEMPORIZADOR DEL JUEGO -->
          <div class="timer-container" id="confrontation-timer" style="display: none;">00:00</div>
          
          <!-- TABLEROS DE AMBOS JUGADORES -->
          <div class="confrontation-boards-container" style="display: none;">
            <!-- MI TABLERO (Interactivo) -->
            <div class="player-board" id="my-board">
              <div class="player-header">
                <div class="player-name" id="my-name">Tú</div>
                <div class="player-stats">
                  <div class="stat">
                    <div class="stat-value" id="my-words">0</div> 
                    <div class="stat-label">Palabras</div>
                  </div>
                  <div class="stat">
                    <div class="stat-value" id="my-errors">0</div> 
                    <div class="stat-label">Errores</div>
                  </div>
                </div>
              </div>
              <div id="my-board-grid" class="board"></div>
            </div>
            
            <!-- TABLERO DEL OPONENTE (Solo visual) -->
            <div class="player-board" id="opponent-board">
              <div class="player-header">
                <div class="player-name" id="opponent-name">Rival</div>
                <div class="player-stats">
                  <div class="stat">
                    <div class="stat-value" id="opponent-words">0</div> 
                    <div class="stat-label">Palabras</div>
                  </div>
                  <div class="stat">
                    <div class="stat-value" id="opponent-errors">0</div> 
                    <div class="stat-label">Errores</div>
                  </div>
                </div>
              </div>
              <div id="opponent-board-grid" class="board"></div>
            </div>
          </div>
          
          <div id="confrontation-message" class="message" role="status" aria-live="polite"></div>
        </div>

        <!-- PANEL LATERAL: Palabras e Instrucciones -->
        <aside>
          <div class="panel">
            <h3>Palabras a encontrar</h3>
            <ul id="clues" class="clues"></ul>
          </div>
          <div class="panel">
            <h3>Instrucciones</h3>
            <div class="small">
              • Arrastra el mouse en recta horizontal o vertical.<br>
              • Si no coincide con ninguna palabra, cuenta como error.<br>
              • Con <strong>4 errores</strong> pierdes y el juego se reinicia.
            </div>
          </div>
        </aside>
      </section>

      <!-- ============================================================
           PANEL LATERAL DERECHO: Jugadores (Amigos / Ranking) + Chat
      ============================================================ -->
      <aside class="side">

        <!-- ── PANEL DE JUGADORES CON TABS ── -->
        <div class="panel card" id="jugadores-panel">
          <div class="panel-tabs">
            <button class="tab-btn active" data-tab="amigos">
              💜 Amigos
            </button>
            <button class="tab-btn" data-tab="ranking">
              🏆 Ranking
            </button>
          </div>

          <!-- TAB: AMIGOS -->
          <div class="tab-content active" id="tab-amigos">
            <div class="tab-header">
              <span class="tab-title">Tus amigos</span>
              <span class="count-badge" id="amigos-count">0</span>
            </div>
            <ul id="lista-amigos" class="lista-jugadores">
              <li class="empty-state">
                <span>😴</span>
                <p>Cargando amigos...</p>
              </li>
            </ul>
          </div>

          <!-- TAB: RANKING GLOBAL -->
          <div class="tab-content" id="tab-ranking">
            <div class="tab-header">
              <span class="tab-title">Top jugadores</span>
              <span class="count-badge" id="ranking-count">—</span>
            </div>
            <ul id="lista-ranking" class="lista-jugadores">
              <li class="empty-state">
                <span>⏳</span>
                <p>Cargando ranking...</p>
              </li>
            </ul>
          </div>
        </div>

        <!-- ── PANEL DE CHAT ── -->
        <div class="panel card" id="chat-panel">
          <h3>💬 Chat</h3>
          <div id="chatBox"></div>
          <div class="chat-input">
            <input id="chatInput" type="text" placeholder="Escribe un mensaje…" autocomplete="off">
            <button id="chatBtn" class="chat-send">↑</button>
          </div>
        </div>

      </aside>
    </div>
  </div>

  <!-- PANTALLA DE RESULTADOS -->
  <div id="results-screen" class="results-screen" style="display: none;">
    <div class="results-content">
      <h2 class="results-title" id="results-title">Resultados del Enfrentamiento</h2>
      <div class="results-stats">
        <div class="result-player" id="result-player1">
          <h3 id="result-name1">Jugador 1</h3>
          <div class="stat">
            <div class="stat-value" id="result-words1">0</div>
            <div class="stat-label">Palabras encontradas</div>
          </div>
          <div class="stat">
            <div class="stat-value" id="result-errors1">0</div>
            <div class="stat-label">Errores</div>
          </div>
        </div>
        <div class="result-player" id="result-player2">
          <h3 id="result-name2">Jugador 2</h3>
          <div class="stat">
            <div class="stat-value" id="result-words2">0</div>
            <div class="stat-label">Palabras encontradas</div>
          </div>
          <div class="stat">
            <div class="stat-value" id="result-errors2">0</div>
            <div class="stat-label">Errores</div>
          </div>
        </div>
      </div>
      
      <!-- CONTROLES DE REVANCHA -->
      <div id="rematch-controls" style="margin-top: 20px;">
        <button id="rematch-btn" class="primary">⚔️ Revancha</button>
        <button id="back-to-lobby-btn">Ir al Lobby</button>
      </div>
      <div id="rematch-status" style="display: none; margin-top: 15px;"></div>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    window.USER_DATA={{{json user}}}
  </script>
  <script src="/public/js/sopaLetras.controller.js" defer></script>

</body>
</html>
