<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Revisión de Preguntas</title>
    <link rel="stylesheet" href="/css/revisor.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <div class="dashboard-container">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">
                    <i class="fas fa-clipboard-list"></i> Preguntas Pendientes de Revisión
                </h3>
                <p style="color: #666; margin-top: 10px;">
                    Total: <strong>{{preguntas.length}}</strong> preguntas esperando revisión
                </p>
            </div>
            
            {{#if preguntas.length}}
            <div class="preguntas-revision-grid">
                {{#each preguntas}}
                <div class="pregunta-card">
                    <div class="pregunta-header">
                        <span class="pregunta-id">ID: {{id_pregunta}}</span>
                        <span class="pregunta-materia">{{nombre_materia}}</span>
                    </div>
                    
                    <div class="pregunta-contenido">
                        <h4 class="pregunta-titulo">{{pregunta}}</h4>
                        
                        {{#if retroalimentacion}}
                        <div class="pregunta-retroalimentacion">
                            <strong>Retroalimentación:</strong> {{retroalimentacion}}
                        </div>
                        {{/if}}
                        
                        <div class="respuestas-lista">
                            <strong>Respuestas:</strong>
                            <ul>
                                {{#each respuestas}}
                                <li class="{{#if correcta}}respuesta-correcta{{/if}}">
                                    {{respuesta}} 
                                    {{#if correcta}}<i class="fas fa-check-circle" style="color: #28a745;"></i>{{/if}}
                                    <span class="puntos-badge">{{puntos}} pts</span>
                                </li>
                                {{/each}}
                            </ul>
                        </div>
                    </div>
                    
                    <div class="pregunta-acciones">
                        <button class="btn-action btn-aprobar" data-id="{{id_pregunta}}" data-tipo="pregunta">
                            <i class="fas fa-check"></i> Aprobar y Publicar
                        </button>
                        <button class="btn-action btn-rechazar" data-id="{{id_pregunta}}" data-tipo="pregunta">
                            <i class="fas fa-times"></i> Rechazar y Eliminar
                        </button>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>
                <h4 class="empty-state-title">¡Excelente trabajo!</h4>
                <p class="empty-state-description">No hay preguntas pendientes de revisión.</p>
                <a href="/revisor" class="revisor-btn" style="margin-top: 20px;">Volver al Panel</a>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div id="modal-confirmacion" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); z-index: 1001; min-width: 400px;">
        <h3 id="modal-titulo" style="margin-bottom: 15px; color: #333;">¿Confirmar acción?</h3>
        <p id="modal-mensaje" style="color: #666; margin-bottom: 20px;"></p>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button id="modal-cancelar" class="revisor-btn" style="background: #6c757d;">Cancelar</button>
            <button id="modal-confirmar" class="revisor-btn">Confirmar</button>
        </div>
    </div>
    <div id="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;"></div>

    <script src="/public/js/revisor.controller.js"></script>
</body>
</html>