<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Serpientes y Escaleras - Multijugador</title>
    <link rel="stylesheet" href="/css/serpientes-escaleras.css" /> 
</head>
<body>
    <div class="page">
        <div class="header">
            <div class="title">🐍 Serpientes y Escaleras - Multijugador</div>
            <div class="pill">
                Jugador: <strong id="username">{{#if user}}{{user.username}}{{else}}Invitado{{/if}}</strong>
            </div>
            <button onclick="location.href='/minijuegos'"> ← Regresar</button>
        </div>

        <div class="game-container">
            <aside class="side-panel">
                <div class="panel" id="chat-panel">
                    <h3>💬 Chat de la Sala</h3>
                    <div id="chatBox"></div>
                    <div class="chat-input">
                        <input id="chatInput" type="text" placeholder="Escribe un mensaje…">
                        <button id="chatBtn" class="chat-send">Enviar</button>
                    </div>
                </div>
                <div class="panel" id="jugadores-panel">
                    <h3>🟢 Jugadores activos</h3>
                    <ul id="lista-jugadores"></ul>
                </div>
            </aside>
            <main class="game-board">
                <div class="panel" id="lobby-panel">
                    <h3>Sala de Espera</h3>
                    <div id="players-list-room"></div>
                    <div id="lobby-state">Conectando...</div>
                    
                    <div id="character-selector">
                        <h4>Elige tu Ficha:</h4>
                        <div class="emoji-grid">
                            <span class="emoji-option selected" data-emoji="🐵">🐵</span>
                            <span class="emoji-option" data-emoji="🐸">🐸</span>
                            <span class="emoji-option" data-emoji="🦄">🦄</span>
                            <span class="emoji-option" data-emoji="🤖">🤖</span>
                            <span class="emoji-option" data-emoji="👽">👽</span>
                            <span class="emoji-option" data-emoji="🍕">🍕</span>
                            <span class="emoji-option" data-emoji="👻">👻</span>
                            <span class="emoji-option" data-emoji="🎃">🎃</span>
                            <span class="emoji-option" data-emoji="🐲">🐲</span>
                            <span class="emoji-option" data-emoji="🐷">🐷</span>
                            <span class="emoji-option" data-emoji="🐰">🐰</span>
                            <span class="emoji-option" data-emoji="🐼">🐼</span>
                            <span class="emoji-option" data-emoji="🐨">🐨</span>
                        </div>
                    </div>
                    
                    <div id="start-game-controls" class="hidden">
                        <label for="materias-select">Categoría:</label>
                        <select id="materias-select"></select>
                        <button id="propose-materia-btn">Proponer Categoría</button>
                    </div>

                    <div id="vote-controls" class="hidden">
                        <p id="vote-proposal-text"></p>
                        <button id="vote-yes-btn">✅ Aceptar</button>
                        <button id="vote-no-btn">❌ Rechazar</button>
                    </div>
                </div>

                <div class="board-container">
                    <div class="board" id="board"></div>
                    <svg id="paths-svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none;"></svg>
                </div>
                <div class="game-controls">
                    <div class="dice-container">
                        <div class="dice" id="dice">?</div>
                        <button id="lanzar-dado" disabled>Lanzar Dado 🎲</button>
                    </div>
                    <div id="info-turno">Esperando jugadores...</div>
                </div>
            </main>
            <aside class="side-panel">
                <div class="panel" id="rules-panel">
                    <h3>📜 Reglas y Símbolos</h3>
                    <ul class="rules-list">
                        <li><strong>Pregunta 🧠:</strong> Cada 3-5 turnos, aparecerá una pregunta.</li>
                        <li><strong>Respuesta Correcta ✅:</strong> ¡Ganas un turno extra!</li>
                        <li><strong>Respuesta Incorrecta ❌:</strong> Pierdes tu siguiente turno.</li>
                        <li><strong>Escalera 🪜 / Avión 🛩️:</strong> Sube a la casilla superior.</li>
                        <li><strong>Serpiente 🐍 / Lagarto 🦎:</strong> Deslízate a la casilla inferior.</li>
                        <li><strong>Ganador 🏆:</strong> El primero en llegar a la casilla 100 gana.</li>
                    </ul>
                </div>
            </aside>
        </div>
        <div class="notification" id="notification"></div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        // ================== 1. INICIALIZACIÓN Y VARIABLES ==================
        const socket = io();
        const salaId = "{{salaId}}";
        const usuario = {{{json user}}};
        const materiasPrecargadas = {{{json materias}}};
         // ✅ NUEVO: Lista de emojis disponibles y variable para guardar la elección
        const EMOJI_OPTIONS =['🐵', '🐸', '🦄', '🤖', 
                            '👻', '👽', '🎃', '🐲',
                            '🐷', '🐰', '🐼', '🐨'  
        ];
        let miEmoji = EMOJI_OPTIONS[0]; // Emoji por defecto
        const elements = {
            board: document.getElementById('board'),
            dice: document.getElementById('dice'),
            lanzarDadoBtn: document.getElementById('lanzar-dado'),
            infoTurno: document.getElementById('info-turno'),
            chatBox: document.getElementById('chatBox'),
            chatInput: document.getElementById('chatInput'),
            chatBtn: document.getElementById('chatBtn'),
            listaJugadoresEl: document.getElementById('lista-jugadores'),
            playersListRoom: document.getElementById('players-list-room'),
            notification: document.getElementById('notification'),
            pathsSvg: document.getElementById('paths-svg'),
            lobbyPanel: document.getElementById('lobby-panel'),
            lobbyState: document.getElementById('lobby-state'),
            startGameControls: document.getElementById('start-game-controls'),
            materiasSelect: document.getElementById('materias-select'),
            proposeMateriaBtn: document.getElementById('propose-materia-btn'),
            voteControls: document.getElementById('vote-controls'),
            voteProposalText: document.getElementById('vote-proposal-text'),
            voteYesBtn: document.getElementById('vote-yes-btn'),
            voteNoBtn: document.getElementById('vote-no-btn'),
        };

        let gameState = null;
        let previousGameState = null;
        const specialCells = {
            // Escaleras (según tu imagen)
            5: 25,
            14: 47,
            22: 42,
            30: 50,
            49: 69,
            61: 82,
            70: 90,
            83: 98,

            // Serpientes (según tu imagen)
            17: 4,
            27: 7,
            35: 15,
            45: 65,
            58: 38,
            76: 56,
            88: 68,
            94: 74,
            99: 79
        };
        const playerColors = ['player-1', 'player-2', 'player-3', 'player-4'];

        // ================== 2. FUNCIÓN PRINCIPAL DE RENDERIZADO ==================
        
        // Se encarga de mostrar/ocultar el lobby y actualizar los textos.
        function actualizarUI() {
            if (!gameState || !gameState.jugadores) return;
            
            renderPlayersInRoomList();
            colocarJugadoresEstaticos();
            
            const jugadorActual = gameState.jugadores[gameState.turnoActual];
            const esAnfitrion = gameState.jugadores.length > 0 && Number(gameState.jugadores[0].id) === Number(usuario.id_usuario);
            const numJugadores = gameState.jugadores.length;
            
            console.log('[UI DEBUG]', {
                numJugadores,
                esAnfitrion,
                gameStarted: gameState.gameStarted,
                votacionEnProgreso: gameState.votacionEnProgreso
            });
            
            // ========== SI EL JUEGO YA COMENZÓ ==========
            if (gameState.gameStarted) {
                elements.lobbyPanel.style.display = 'none';
                elements.listaJugadoresEl.parentElement.style.display = 'none';
                
                const esMiTurno = jugadorActual && Number(jugadorActual.id) === Number(usuario.id_usuario);
                elements.lanzarDadoBtn.disabled = !esMiTurno || !!gameState.ganador || gameState.estadoDelJuego !== 'lanzando_dado';
                
                if (gameState.ganador) {
                    elements.infoTurno.textContent = `¡${gameState.ganador.username} ha ganado! 🏆`;
                } else if (jugadorActual) {
                    if (gameState.estadoDelJuego === 'respondiendo_pregunta') {
                        elements.infoTurno.textContent = `${jugadorActual.username} está respondiendo 🧠`;
                    } else {
                        elements.infoTurno.textContent = `Turno de: ${jugadorActual.username}`;
                    }
                }
                return;
            }
            
            // ========== LOBBY (JUEGO NO INICIADO) ==========
            elements.lobbyPanel.style.display = 'block';
            elements.listaJugadoresEl.parentElement.style.display = 'block';
            
            // Por defecto, ocultar todo
            elements.startGameControls.style.display = 'none';
            elements.voteControls.style.display = 'none';
            
            // ✅ CASO 1: Solo hay 1 jugador (esperando oponente)
            if (numJugadores < 2) {
                console.log('[UI] Solo 1 jugador, esperando oponente...');
                elements.lobbyState.textContent = "Esperando a otro jugador...";
                return; // 🚨 IMPORTANTE: Salir aquí para NO mostrar controles
            }
            
            // ✅ CASO 2: Votación en progreso
            if (gameState.votacionEnProgreso) {
                const { proponente, textoMateria } = gameState.propuestaMateria;
                elements.lobbyState.innerHTML = `Votación iniciada por <strong>${proponente.username}</strong>`;
                elements.voteControls.style.display = 'block';
                
                if (esAnfitrion) {
                    // Si SOY el anfitrión (el que propuso)
                    elements.voteProposalText.innerHTML = `Propusiste jugar con <strong>"${textoMateria}"</strong>.<br>Esperando respuesta...`;
                    elements.voteYesBtn.style.display = 'none';
                    elements.voteNoBtn.style.display = 'none';
                } else {
                    // Si NO soy el anfitrión (debo votar)
                    elements.voteProposalText.innerHTML = `<strong>${proponente.username}</strong> propone:<br><strong>"${textoMateria}"</strong><br>¿Aceptas?`;
                    elements.voteYesBtn.style.display = 'inline-block';
                    elements.voteNoBtn.style.display = 'inline-block';
                }
                return;
            }
            
            // ✅ CASO 3: Hay 2+ jugadores y NO hay votación (listo para proponer)
            console.log('[UI] 2+ jugadores, sin votación');
            
            if (esAnfitrion) {
                // Solo el ANFITRIÓN puede proponer
                console.log('[UI] Mostrando controles al anfitrión');
                elements.lobbyState.textContent = "¡Listo! Elige una categoría y propón el inicio.";
                elements.startGameControls.style.display = 'block';
            } else {
                // El INVITADO solo espera
                console.log('[UI] Invitado esperando...');
                elements.lobbyState.textContent = "¡Listo! Esperando que el anfitrión inicie la partida.";
                elements.startGameControls.style.display = 'none';
            }
        }

        function renderPlayersInRoomList() {
            elements.playersListRoom.innerHTML = '';
            if (!gameState || !gameState.jugadores) return;
            gameState.jugadores.forEach((p, i) => {
                const li = document.createElement('li');
                // Usa el emoji del estado del juego, con un emoji por defecto si aún no existe
                const playerEmoji = p.emoji || EMOJI_OPTIONS[i] || '❔';
                li.innerHTML = `<span class="player-emoji-lobby">${playerEmoji}</span> ${p.username}`;
                elements.playersListRoom.appendChild(li);
            });
        }
        // ================== 3. FUNCIONES DEL TABLERO Y DADO ==================

        // ✅ FUNCIÓN CORREGIDA PARA PINTAR EL TABLERO CORRECTAMENTE
        function crearTablero() {
            elements.board.innerHTML = '';
            const endCells = {};
            for (const start in specialCells) {
                endCells[specialCells[start]] = parseInt(start);
            }

            for (let r = 9; r >= 0; r--) {
                for (let c = 0; c < 10; c++) {
                    const i = r % 2 !== 0 ? (r * 10) + (9 - c) : (r * 10) + c;
                    const n = i + 1;
                    const cell = document.createElement('div');
                    cell.className = 'cell';
                    cell.dataset.number = n;
                    
                    let specialIcon = '';
                    let specialClass = '';

                    if (specialCells[n]) {
                        if (specialCells[n] > n) {
                            specialClass = 'ladder-start';
                            specialIcon = '🪜';
                        } else {
                            specialClass = 'snake-start';
                            specialIcon = '🐍';
                        }
                    } else if (endCells[n]) {
                        if (n > endCells[n]) {
                            specialClass = 'ladder-end';
                        } else {
                            specialClass = 'snake-end';
                        }
                    }
                    
                    if (specialClass) cell.classList.add(specialClass);
                    cell.innerHTML = `<span class="cell-number">${n}</span><span class="cell-icon">${specialIcon}</span>`;
                    elements.board.appendChild(cell);
                }
            }
            dibujarCaminos();
        }
        
        // ✅ FUNCIÓN MEJORADA PARA DIBUJAR CAMINOS CURVOS
        function dibujarCaminos() {
            setTimeout(() => {
                elements.pathsSvg.innerHTML = '';
                for (const start in specialCells) {
                    const end = specialCells[start];
                    const sC = document.querySelector(`.cell[data-number="${start}"]`);
                    const eC = document.querySelector(`.cell[data-number="${end}"]`);
                    if (!sC || !eC) continue;

                    const sR = sC.getBoundingClientRect();
                    const eR = eC.getBoundingClientRect();
                    const bR = elements.board.getBoundingClientRect();
                    const sX = sR.left + sR.width / 2 - bR.left;
                    const sY = sR.top + sR.height / 2 - bR.top;
                    const eX = eR.left + eR.width / 2 - bR.left;
                    const eY = eR.top + eR.height / 2 - bR.top;
                    
                    const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                    const isLadder = end > start;
                    
                    if (isLadder) {
                        p.setAttribute('d', `M${sX},${sY} L${eX},${eY}`);
                        p.setAttribute('class', 'ladder-path');
                    } else { // Curva para las serpientes
                        const cpx1 = sX + (eX - sX) * 0.3 + (sY - eY) * 0.2;
                        const cpy1 = sY + (eY - sY) * 0.3 + (eX - sX) * 0.2;
                        const cpx2 = sX + (eX - sX) * 0.7 - (sY - eY) * 0.2;
                        const cpy2 = sY + (eY - sY) * 0.7 - (eX - sX) * 0.2;
                        p.setAttribute('d', `M ${sX} ${sY} C ${cpx1} ${cpy1}, ${cpx2} ${cpy2}, ${eX} ${eY}`);
                        p.setAttribute('class', 'snake-path');
                    }
                    elements.pathsSvg.appendChild(p);
                }
            }, 100);
        }

        // Las demás funciones de animación, colocación de jugadores, etc., pueden quedar
        // como en la versión anterior que te proporcioné, ya que su lógica es correcta.
        async function animarMovimiento(playerElement, fromPos, toPos, finalPos) {
             for (let i = fromPos + 1; i <= toPos; i++) {
                await moverFicha(playerElement, i, 200);
            }
            if (finalPos !== toPos) {
                await new Promise(resolve => setTimeout(resolve, 300));
                await moverFicha(playerElement, finalPos, 500);
            }
        }
        function moverFicha(playerElement, pos, duration = 300) {
            return new Promise(resolve => {
                const finalCell = document.querySelector(`.cell[data-number="${pos}"]`);
                if (finalCell) {
                    const finalRect = finalCell.getBoundingClientRect();
                    const boardRect = elements.board.getBoundingClientRect();
                    const playerRect = playerElement.getBoundingClientRect();
                    playerElement.style.transition = `all ${duration}ms ease-in-out`;
                    playerElement.style.left = `${(finalRect.left - boardRect.left) + (finalRect.width / 2) - (playerRect.width / 2)}px`;
                    playerElement.style.top = `${(finalRect.top - boardRect.top) + (finalRect.height / 2) - (playerRect.height / 2)}px`;
                }
                setTimeout(resolve, duration);
            });
        }
        function animarDado(valorFinal) {
            elements.lanzarDadoBtn.disabled = true;
            let sorteo;
            const anim = setInterval(() => {
                sorteo = Math.floor(Math.random() * 6) + 1;
                elements.dice.textContent = sorteo;
            }, 80);
            setTimeout(() => {
                clearInterval(anim);
                elements.dice.textContent = valorFinal;
            }, 1000);
        }
        function colocarJugadoresEstaticos() {
            if (!gameState || !gameState.jugadores) return;
            const jugadorQueSeMueveId = previousGameState?.jugadores[previousGameState.turnoActual]?.id;

            gameState.jugadores.forEach((jugador, i) => {
                if (jugador.id === jugadorQueSeMueveId && previousGameState) return;
                
                let playerEl = document.querySelector(`.player[data-player-id="${jugador.id}"]`);
                if (!playerEl) {
                    playerEl = document.createElement('div');
                    playerEl.className = `player`; // Ya no necesita color específico
                    playerEl.dataset.playerId = jugador.id;
                    elements.board.appendChild(playerEl);
                }

                // Asigna el emoji del estado del juego a la ficha
                playerEl.textContent = jugador.emoji || EMOJI_OPTIONS[i] || '❔';
                
                const cell = document.querySelector(`.cell[data-number="${jugador.posicion || 1}"]`);
                if (cell) {
                    const cellRect = cell.getBoundingClientRect();
                    const boardRect = elements.board.getBoundingClientRect();
                    const playerRect = playerEl.getBoundingClientRect();
                    playerEl.style.transition = 'none';
                    playerEl.style.left = `${(cellRect.left - boardRect.left) + (cellRect.width / 2) - (playerRect.width / 2)}px`;
                    playerEl.style.top = `${(cellRect.top - boardRect.top) + (cellRect.height / 2) - (playerRect.height / 2)}px`;
                    setTimeout(() => { playerEl.style.transition = ''; }, 50);
                }
            });
        }
        // ================== 4. LÓGICA DE PREGUNTAS Y CHAT ==================

        function addChatMessage(user, msg, type = '') {
            const msgDiv = document.createElement('div');
            msgDiv.className = `chat-message ${type}`;
            msgDiv.innerHTML = type === 'system' ? msg : `<strong>${user}:</strong> ${msg}`;
            elements.chatBox.appendChild(msgDiv);
            elements.chatBox.scrollTop = elements.chatBox.scrollHeight;
        }

        function showQuestionInChat(pregunta) {
            const questionDiv = document.createElement('div');
            questionDiv.id = `pregunta-${pregunta.id_pregunta}`;
            questionDiv.classList.add('chat-message', 'question-message');
            questionDiv.innerHTML = `<p><strong>${pregunta.pregunta}</strong></p>`;
            
            const optionsDiv = document.createElement('div');
            optionsDiv.classList.add('question-options');
            
            pregunta.opciones.forEach(opcion => {
                const btn = document.createElement('button');
                btn.textContent = opcion.texto;
                btn.onclick = () => {
                    optionsDiv.querySelectorAll('button').forEach(b => b.disabled = true);
                    socket.emit('serpientes:responderPregunta', { salaId, respuestaId: opcion.id });
                };
                optionsDiv.appendChild(btn);
            });
            
            questionDiv.appendChild(optionsDiv);
            elements.chatBox.appendChild(questionDiv);
            elements.chatBox.scrollTop = elements.chatBox.scrollHeight;
        }

        function handleAnswerFeedback({ esCorrecta, respuestaCorrectaTexto }) {
            const preguntaDiv = elements.chatBox.querySelector('.question-message:last-child');
            if (!preguntaDiv) return;

            const botones = preguntaDiv.querySelectorAll('button');
            botones.forEach(btn => {
                btn.classList.add(btn.textContent === respuestaCorrectaTexto ? 'respuesta-correcta' : 'respuesta-incorrecta');
            });
        }

        // ================== 5. JUGADORES ACTIVOS E INVITACIONES ==================

        async function cargarJugadoresActivos() {
            try {
                const res = await fetch('/jugadores');
                if (!res.ok) throw new Error('Error al obtener jugadores');
                const jugadores = await res.json();
                
                elements.listaJugadoresEl.innerHTML = '';
                const sePuedeInvitar = !gameState || !gameState.votacionEnProgreso;

                jugadores.forEach(jugador => {
                    if (jugador.id === usuario.id_usuario) return;
                    const item = document.createElement('li');
                    
                    let inviteButtonHTML = '';
                    if (sePuedeInvitar) {
                        inviteButtonHTML = `<div class="actions"><button class="btn-invite" data-id="${jugador.id}">Invitar 🤝</button></div>`;
                    }
                    item.innerHTML = `<span>${jugador.username}</span>${inviteButtonHTML}`;
                    elements.listaJugadoresEl.appendChild(item);
                });
            } catch (error) {
                console.error('Error al cargar jugadores:', error);
                elements.listaJugadoresEl.innerHTML = '<li>Error al cargar jugadores.</li>';
            }
        }
        
        function mostrarNotificacion(mensaje) {
            elements.notification.textContent = mensaje;
            elements.notification.classList.add('show');
            setTimeout(() => elements.notification.classList.remove('show'), 3000);
        }

        // ================== 6. MANEJO DE SOCKETS Y EVENTOS ==================

         function setupSocketListeners() {
            socket.on('serpientes:estado', async (serverState) => {
                const jugadorEnTurnoAntes = previousGameState?.jugadores[previousGameState.turnoActual];
                
                gameState = serverState;
                actualizarUI(); // Dibuja la UI estática y los jugadores que no se mueven

                if (previousGameState && jugadorEnTurnoAntes) {
                    const jugadorDespues = gameState.jugadores.find(p => p.id === jugadorEnTurnoAntes.id);
                    if (jugadorDespues) {
                        const posAnterior = jugadorEnTurnoAntes.posicion;
                        const posNueva = jugadorDespues.posicion;
                        
                        if (posAnterior !== posNueva) {
                            let playerEl = document.querySelector(`.player[data-player-id="${jugadorDespues.id}"]`);
                            if (!playerEl) return;

                            elements.lanzarDadoBtn.disabled = true;
                            
                            const posIntermedia = Math.min(posAnterior + (gameState.dado || 0), 100);
                            await animarMovimiento(playerEl, posAnterior, posIntermedia, posNueva);
                            
                            actualizarUI();
                        }
                    }
                }

                if (previousGameState && gameState.log.length > previousGameState.log.length) {
                    const nuevosLogs = gameState.log.slice(previousGameState.log.length);
                    nuevosLogs.forEach(mensaje => addChatMessage(null, mensaje, 'system'));
                }
                
                previousGameState = JSON.parse(JSON.stringify(serverState));
            });

            socket.on('serpientes:dado', ({ valor }) => animarDado(valor));
            socket.on('serpientes:error', ({ mensaje }) => mostrarNotificacion(mensaje));
            socket.on('serpientes:votacionMateria', (propuesta) => addChatMessage(null, `<strong>${propuesta.proponente.username}</strong> propone jugar con: <strong>${propuesta.textoMateria}</strong>`, 'system'));
            socket.on('serpientes:votacionCancelada', ({ motivo }) => addChatMessage(null, `Votación cancelada: ${motivo}`, 'system'));
            
            // ✅ CORREGIDO: Escucha el evento para todos, pero solo actúa si es para ti.
            socket.on('serpientes:mostrarPregunta', ({ pregunta, jugadorId }) => {
                if (Number(jugadorId) === Number(usuario.id_usuario)) {
                    showQuestionInChat(pregunta);
                }
            });

            socket.on('serpientes:respuestaResultado', handleAnswerFeedback);
            socket.on('nuevoMensaje', (data) => {
                if (data.usuario && data.mensaje) {
                    addChatMessage(data.usuario, data.mensaje);
                }
            });
        }
        
        function setupEventListeners() {
            elements.lanzarDadoBtn.addEventListener('click', () => socket.emit('serpientes:lanzarDado', { salaId, userId: usuario.id_usuario }));
            
            elements.proposeMateriaBtn.addEventListener('click', () => {
                const idMateria = elements.materiasSelect.value;
                const textoMateria = elements.materiasSelect.options[elements.materiasSelect.selectedIndex].text;
                socket.emit('serpientes:proponerMateria', { salaId, idMateria, textoMateria });
            });
            elements.voteYesBtn.addEventListener('click', () => socket.emit('serpientes:votar', { salaId, voto: true }));
            elements.voteNoBtn.addEventListener('click', () => socket.emit('serpientes:votar', { salaId, voto: false }));
            
            const enviarMensaje = () => {
                const mensaje = elements.chatInput.value.trim();
                if (mensaje) {
                    socket.emit('mensajeChat', { salaId, mensaje, usuario: usuario.username });
                    elements.chatInput.value = '';
                }
            };
            elements.chatBtn.addEventListener('click', enviarMensaje);
            elements.chatInput.addEventListener('keypress', (e) => e.key === 'Enter' && enviarMensaje());
            elements.lobbyPanel.addEventListener('click', (e) => {
                if (e.target.classList.contains('emoji-option')) {
                    // Previene la selección si el juego ya empezó (doble seguridad)
                    if(gameState && gameState.gameStarted) return;
                    
                    const selectedEmoji = e.target.dataset.emoji;
                    miEmoji = selectedEmoji;
                    
                    // Emite el nuevo evento al servidor
                    socket.emit('serpientes:elegirFicha', { salaId, emoji: selectedEmoji });
                    
                    // Actualiza la UI para mostrar la selección
                    document.querySelectorAll('.emoji-option').forEach(el => el.classList.remove('selected'));
                    e.target.classList.add('selected');
                }
            });
            elements.listaJugadoresEl.addEventListener('click', async (e) => {
                if (!e.target.classList.contains('btn-invite')) return;
                const idJugador = e.target.dataset.id;
                if (!idJugador) return;
                
                try {
                    const res = await fetch(`/invitar/${idJugador}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ salaId: salaId, juego: 'serpientes_escaleras' })
                    });
                    const data = await res.json();
                    mostrarNotificacion(data.message || 'Invitación enviada');
                } catch (error) {
                    mostrarNotificacion('Hubo un problema al enviar la invitación.');
                }
            });
            
            window.addEventListener('resize', dibujarCaminos);
        }

        // ================== 7. INICIALIZACIÓN DEL JUEGO ==================
        function init() {
            crearTablero();
            setupSocketListeners();
            setupEventListeners();
            
            if (!materiasPrecargadas || materiasPrecargadas.length === 0) {
                elements.startGameControls.innerHTML = '<p>No hay categorías con preguntas.</p>';
            } else {
                materiasPrecargadas.forEach(m => {
                    const option = document.createElement('option');
                    option.value = m.id_materia;
                    option.textContent = m.descripcion;
                    elements.materiasSelect.appendChild(option);
                });
            }
            
            cargarJugadoresActivos();
            setInterval(cargarJugadoresActivos, 15000);
            
            socket.emit('serpientes:unirse', { salaId, usuario });
        }

        init();
    });
    </script>
</body>
</html>