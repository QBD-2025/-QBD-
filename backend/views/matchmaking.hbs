socket.on('duelo:invitacionLobbyError', (data) => {
    console.error('[LOBBY]: Error:', data.mensaje);
    
    if (window.mostrarNotificacionTemporal) {
        window.mostrarNotificacionTemporal(data.mensaje, 'error');
    } else {
        alert('❌ ' + data.mensaje);
    }
    
    // Restaurar botones
    restaurarBusqueda(data.mensaje);
});

socket.on('duelo:invitacionExpirada', (data) => {
    console.log('[LOBBY]: Invitación expirada');
    
    if (window.mostrarNotificacionTemporal) {
        window.mostrarNotificacionTemporal(data.mensaje, 'info');
    }
    
    restaurarBusqueda(data.mensaje || 'La invitación expiró.');
});

socket.on('duelo:invitacionLobbyRechazada', (data) => {
    console.log('[LOBBY]: Invitación rechazada');
    
    if (window.mostrarNotificacionTemporal) {
        window.mostrarNotificacionTemporal(data.mensaje, 'error');
    }
    
    restaurarBusqueda(data.mensaje || 'Tu invitación fue rechazada.');
});

// ================================================================
// EVENTOS DE SOCKET PARA NOTIFICACIONES
// ================================================================
socket.on('notificacion_recibida', () => {
    console.log('[SOCKET]: Nueva notificación recibida');
    cargarNotificaciones();
    
    const btn = document.getElementById('btnNotificaciones');
    if (btn) {
        btn.style.animation = 'pulseNotif 1s';
        setTimeout(() => btn.style.animation = '', 1000);
    }
});

// ================================================================
// MATCHMAKING NORMAL
// ================================================================
function iniciarBusqueda(modo, dificultad = null) {
    modalDificultad.classList.remove('visible');
    btnBuscarCarrera.style.display = 'none';
    btnBuscarGeneral.style.display = 'none';
    btnCancelarBusqueda.style.display = 'inline-block';
    statusText.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Buscando oponente...';
    
    const evento = `duelo:buscar:${modo}`;
    const payload = modo === 'carrera' ? { user, dificultad } : user;
    socket.emit(evento, payload);
}

function restaurarBusqueda(mensaje) {
    btnBuscarCarrera.style.display = 'inline-block';
    btnBuscarGeneral.style.display = 'inline-block';
    btnCancelarBusqueda.style.display = 'none';
    statusText.textContent = mensaje || 'Compite en tu área de especialidad o en cultura general.';
}

btnBuscarCarrera.addEventListener('click', () => {
    modalDificultad.classList.add('visible');
});

btnBuscarGeneral.addEventListener('click', () => iniciarBusqueda('general'));

// ============================================================
// 🎮 BOTÓN CANCELAR - MEJORADO
// ============================================================
btnCancelarBusqueda.addEventListener('click', () => {
    // Si hay una sala activa (invitación o matchmaking)
    if (salaActual) {
        if (confirm('¿Seguro que quieres salir de esta sala?')) {
            socket.emit('sala:salir', { salaId: salaActual });
            sessionStorage.removeItem('ultimaSala');
            sessionStorage.removeItem('tiempoUnion');
            window.location.href = '/competitivo/portal';
        }
    } else {
        // Cancelar búsqueda de matchmaking O invitación pendiente
        socket.emit('duelo:cancelarBusqueda', user.id_usuario);
        
        // También intentar cancelar invitación si hay alguna pendiente
        socket.emit('duelo:cancelarInvitacion', { userId: user.id_usuario });
        
        restaurarBusqueda("Búsqueda/invitación cancelada.");
    }
});


modalDificultad.querySelectorAll('.dificultad-opciones button').forEach(btn => {
    if (btn.dataset.dificultad) {
        btn.onclick = () => iniciarBusqueda('carrera', btn.dataset.dificultad);
    }
});

document.getElementById('cerrarModalDificultad').onclick = () => {
    modalDificultad.classList.remove('visible');
};

// ================================================================
// EVENTOS DEL DUELO
// ================================================================
socket.on('duelo:iniciarDesafio', ({ salaId: newSalaId }) => {
    console.log('[DUELO]: Matchmaking encontró pareja:', newSalaId);
    
    if (document.body.classList.contains('in-transition')) return;
    document.body.classList.add('in-transition');

    salaId = newSalaId;
    statusText.textContent = 'Duelo encontrado! Preparando...';
    btnCancelarBusqueda.style.display = 'none';
    
    setTimeout(() => {
        matchmakingView.style.opacity = '0';
        setTimeout(() => {
            matchmakingView.style.display = 'none';
            dueloView.style.display = 'flex';
            
            socket.emit('duelo:clienteListo', { salaId, userId: user.id_usuario });
            
            setTimeout(() => {
                dueloView.style.opacity = '1';
                document.body.classList.remove('in-transition');
            }, 100);
        }, 500);
    }, 1500);
});

socket.on('duelo:oponenteInfo', ({ oponenteId, oponente: oponenteData }) => {
    console.log('[DUELO]: Info del oponente recibida:', oponenteData.username);
    oponenteUsernameEl.textContent = oponenteData.username;
    oponenteAvatarEl.src = oponenteData.foto_perfil || '/media/images/default_avatar.png';
    oponente = { ...oponenteData, id_usuario: oponenteId };
});

socket.on('duelo:iniciarMiniDraft', ({ categorias }) => {
    console.log('[DRAFT]: Recibidas', categorias.length, 'categorías');
    
    draftTitle.textContent = "ELIGE TU CAMPO DE BATALLA";
    draftInstruction.textContent = "Selecciona una categoría.";
    materiasGrid.innerHTML = '';

    if (categorias.length === 0) {
        draftInstruction.textContent = "No hay categorías disponibles.";
        return;
    }

    categorias.forEach(categoria => {
        const card = document.createElement('div');
        card.className = 'materia-card';
        card.dataset.id = categoria.id;
        card.textContent = categoria.descripcion;
        
        card.onclick = () => {
            document.querySelectorAll('.materia-card').forEach(c => {
                c.onclick = null;
                if (c !== card) c.classList.add('deshabilitada');
            });
            card.classList.add('seleccionada');
            draftInstruction.textContent = "Esperando oponente...";
            
            console.log('[DRAFT]: Seleccionando categoría', categoria.id);
            socket.emit('duelo:seleccionarCategoria', { 
                salaId: salaActual || salaId, 
                userId: user.id_usuario, 
                idCategoria: categoria.id 
            });
        };
        materiasGrid.appendChild(card);
    });
});

socket.on('duelo:oponenteSelecciono', () => {
    console.log('[DRAFT]: Oponente seleccionó su categoría');
    draftInstruction.textContent = "El oponente ya seleccionó...";
});

socket.on('duelo:miniDraftFinalizado', () => {
    console.log('[DRAFT]: ✅ Finalizado, ocultando draft');
    draftContainer.style.display = 'none';
    arenaContainer.style.display = 'flex';
});

socket.on('duelo:nuevaPregunta', ({ pregunta, opciones, numeroPregunta, totalPreguntas, evento }) => {
    console.log(`[PREGUNTA]: ${numeroPregunta}/${totalPreguntas}`);
    
    preguntaActualId = pregunta.id_pregunta;
    textoPregunta.textContent = pregunta.pregunta;
    document.getElementById('numeroPregunta').textContent = `Pregunta ${numeroPregunta} / ${totalPreguntas}`;
    opcionesContainer.innerHTML = '';
    
    if (evento) {
        const eventoDiv = document.createElement('div');
        eventoDiv.className = 'evento-especial';
        eventoDiv.textContent = evento.notificacion;
        textoPregunta.parentNode.insertBefore(eventoDiv, textoPregunta);
        setTimeout(() => eventoDiv.remove(), 3000);
    }

    if (cronometroInterval) clearInterval(cronometroInterval);
    let tiempoRestante = evento?.duracion || 15;
    cronometroEl.textContent = tiempoRestante;
    cronometroInterval = setInterval(() => {
        tiempoRestante--;
        cronometroEl.textContent = tiempoRestante;
        if (tiempoRestante <= 0) clearInterval(cronometroInterval);
    }, 1000);

    opciones.forEach(opcion => {
        const btn = document.createElement('button');
        btn.className = 'opcion-btn';
        btn.textContent = opcion.respuesta;
        
        btn.onclick = () => {
            opcionesContainer.querySelectorAll('button').forEach(b => b.disabled = true);
            btn.classList.add('seleccionada-jugador');
            socket.emit('duelo:responder', {
                salaId: salaActual || salaId,
                userId: user.id_usuario,
                idPregunta: pregunta.id_pregunta,
                idRespuesta: opcion.id_respuesta
            });
        };
        opcionesContainer.appendChild(btn);
    });
});

socket.on('duelo:actualizarEstado', ({ puntuaciones, rachas }) => {
    document.getElementById('puntuacionTuya').textContent = puntuaciones[user.id_usuario];
    document.getElementById('puntuacionOponente').textContent = puntuaciones[oponente.id_usuario];

    if (rachas) {
        tuRachaEl.textContent = `🔥 x${rachas[user.id_usuario]}`;
        oponenteRachaEl.textContent = `🔥 x${rachas[oponente.id_usuario]}`;
    }
});

socket.on('duelo:resultadoRespuesta', ({ esCorrecta, retroalimentacion }) => {
    const feedback = document.createElement('div');
    feedback.className = `feedback ${esCorrecta ? 'correcto' : 'incorrecto'}`;
    feedback.innerHTML = `<p>${esCorrecta ? '✓ ¡Correcto!' : '✗ Incorrecto'}</p><small>${retroalimentacion}</small>`;
    textoPregunta.parentNode.appendChild(feedback);
    setTimeout(() => feedback.remove(), 3000);
});

socket.on('duelo:finalizado', (resultado) => {
    console.log('[DUELO]: Finalizado', resultado);
    
    let mensaje = '';
    if (resultado.ganadorId === user.id_usuario) {
        mensaje = '¡Felicidades! Has ganado.';
    } else if (resultado.ganadorId === null) {
        mensaje = '¡Empate!';
    } else {
        mensaje = 'Has perdido.';
    }
    
    setTimeout(() => {
        alert(mensaje + ' Serás redirigido.');
        window.location.href = '/portal';
    }, 3000);
});

socket.on('duelo:oponenteAbandono', (data) => {
    if (window.mostrarNotificacionTemporal) {
        window.mostrarNotificacionTemporal(data.mensaje, 'info');
    }
    setTimeout(() => {
        window.location.href = '/competitivo/portal';
    }, 2000);
});

socket.on('duelo:oponenteRespondio', () => {
    document.getElementById('estadoOponente').textContent = '✓ Ya respondió';
});

socket.on('duelo:error', (data) => {
    console.error('[DUELO ERROR]:', data);
    if (window.mostrarNotificacionTemporal) {
        window.mostrarNotificacionTemporal('Error: ' + data.mensaje, 'error');
    }
});

// ================================================================
// INICIALIZACIÓN
// ================================================================
document.addEventListener('DOMContentLoaded', async () => {
    console.log('[INIT]: Portal cargado');
    
    if (rankingGlobalContainer) {
        cargarRankingGlobal();
    }
    
    if (selectorCarrera) {
        try {
            const resCarreras = await fetch('/api/usuario/carreras');
            if (resCarreras.ok) {
                const carreras = await resCarreras.json();
                selectorCarrera.innerHTML = '<option value="">Selecciona tu carrera</option>';
                carreras.forEach(carrera => {
                    const option = document.createElement('option');
                    option.value = carrera.id_carrera;
                    option.textContent = carrera.descripcion;
                    selectorCarrera.appendChild(option);
                });
                
                selectorCarrera.addEventListener('change', (e) => {
                    cargarRankingCarrera(e.target.value);
                });
            }
        } catch (error) {
            console.error('Error cargando carreras:', error);
        }
    }
    
    // Cargar notificaciones
    cargarNotificaciones();
    intervalNotificaciones = setInterval(cargarNotificaciones, 30000);

    // Exponer funciones globalmente
    window.togglePanelNotificaciones = togglePanelNotificaciones;
    window.aceptarNotificacion = aceptarNotificacion;
    window.rechazarNotificacion = rechazarNotificacion;
    window.marcarComoLeida = marcarComoLeida;
    window.irADuelo = irADuelo;
});

// ================================================================
// CLEANUP
// ================================================================
window.addEventListener('beforeunload', () => {
    if (user?.id_usuario) {
        socket.emit('competitivo:salirPortal', user.id_usuario);
    }
    if (salaActual) {
        socket.emit('sala:salir', { salaId: salaActual });
    }
    if (intervalNotificaciones) {
        clearInterval(intervalNotificaciones);
    }
});
