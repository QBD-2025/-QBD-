);

// ============================================================
// ✅ EXPORTAR FUNCIONES PARA USO GLOBAL
// ============================================================
window.sistemaDesafiosBD = {
    enviar: enviarDesafioBD,
    aceptar: aceptarNotificacion,
    version: '2.0-unificado'
};

console.log('[BD DESAFÍOS]: Sistema inicializado correctamente ✅');
</script>
