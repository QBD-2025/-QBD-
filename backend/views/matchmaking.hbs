async function enviarDesafioBD(idOponente, usernameOponente, btnElement) {
    if (parseInt(idOponente) === parseInt(user.id_usuario)) {
        if (window.mostrarNotificacionTemporal) {
            window.mostrarNotificacionTemporal('No puedes desafiarte a ti mismo', 'error');
        }
        return;
    }

    console.log(`[BD DESAFÍO]: Enviando a ${usernameOponente} (ID: ${idOponente})`);
    
    if (btnElement) {
        btnElement.disabled = true;
        btnElement.textContent = 'Enviando...';
    }
    
    try {
        // ✅ RUTA CORREGIDA según tu sistema
        // Ajusta la ruta base según tu configuración de Express
        const response = await fetch(`/competitivo/invitaciones/desafio/duelo/${idOponente}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                modo: 'general', // o 'carrera' según tu lógica
                dificultad: null
            })
        });
        
        if (!response.ok) {
            const errorData = await response.json().catch(() => ({ 
                message: `Error HTTP ${response.status}` 
            }));
            throw new Error(errorData.message || `Error ${response.status}`);
        }
        
        const data = await response.json();
        
        if (data.success && data.salaId) {
            console.log(`[BD DESAFÍO]: ✅ Enviado. Sala: ${data.salaId}`);
            
            if (window.mostrarNotificacionTemporal) {
                window.mostrarNotificacionTemporal(
                    `✅ Desafío enviado a ${usernameOponente}`, 
                    'success'
                );
            }
            
            statusText.innerHTML = `<i class="fas fa-paper-plane"></i> Desafío enviado a <strong>${usernameOponente}</strong>`;
            
            // Opcional: Cambiar estado de los botones
            btnBuscarCarrera.style.display = 'none';
            btnBuscarGeneral.style.display = 'none';
            btnCancelarBusqueda.style.display = 'inline-block';
            btnCancelarBusqueda.textContent = 'Esperando respuesta...';
            btnCancelarBusqueda.disabled = true; // No se puede cancelar un desafío BD
            
            setTimeout(() => {
                btnCancelarBusqueda.style.display = 'none';
                btnBuscarCarrera.style.display = 'inline-block';
                btnBuscarGeneral.style.display = 'inline-block';
                btnCancelarBusqueda.disabled = false;
                statusText.textContent = 'Compite en tu área de especialidad o en cultura general.';
            }, 5000);
        } else {
            throw new Error(data.message || 'Respuesta inválida');
        }
        
    } catch (error) {
        console.error('[BD DESAFÍO ERROR]:', error);
        
        let mensajeError = error.message;
        
        if (error.message.includes('Ya tienes un desafío pendiente')) {
            mensajeError = '⏱️ Ya enviaste un desafío. Espera 5 minutos.';
        } else if (error.message.includes('Usuario no encontrado')) {
            mensajeError = '❌ Usuario no encontrado';
        }
        
        if (window.mostrarNotificacionTemporal) {
            window.mostrarNotificacionTemporal(mensajeError, 'error');
        }
        
        statusText.innerHTML = `<i class="fas fa-exclamation-circle"></i> ${mensajeError}`;
        
    } finally {
        if (btnElement) {
            btnElement.disabled = false;
            btnElement.textContent = 'Invitar Notif 📧';
        }
    }
}

