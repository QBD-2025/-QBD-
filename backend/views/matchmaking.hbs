async function aceptarNotificacion(idNotificacion, salaId) {
    console.log('[NOTIF]: Aceptando notificación', idNotificacion, 'sala:', salaId);
    
    try {
        const response = await fetch(`/invitaciones/aceptar/${idNotificacion}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        
        const data = await response.json();
        console.log('[NOTIF]: Respuesta de aceptar:', data);
        
        if (data.success) {
            if (window.mostrarNotificacionTemporal) {
                window.mostrarNotificacionTemporal('✅ ' + data.message, 'success');
            }
            
            await cargarNotificaciones();
            togglePanelNotificaciones();
            
            // ✅ MANEJO ESPECÍFICO PARA DESAFÍO BD
            if (data.tipo === 'desafio_duelo') {
                const salaIdRecibida = data.salaId;
                
                console.log(`[DUELO BD ACCEPTED]: salaId: ${salaIdRecibida}`);
                
                if (!salaIdRecibida) {
                    throw new Error('No se recibió ID de sala válido');
                }
                
                // Mostrar mensaje de carga
                if (window.mostrarNotificacionTemporal) {
                    window.mostrarNotificacionTemporal('¡Desafío aceptado! Preparando arena...', 'success');
                }
                
                if (globalSocket && globalSocket.connected) {
                    console.log(`[SOCKET EMIT]: Emitiendo duelo:aceptarDesafioBD con salaId: ${salaIdRecibida}`);
                    
                    // ✅ EMITIR EVENTO AL SOCKET PARA QUE UNA A AMBOS USUARIOS
                    globalSocket.emit('duelo:aceptarDesafioBD', {
                        salaId: salaIdRecibida,
                        idRetado: user.id_usuario
                    });
                    
                    console.log(`[SOCKET EMIT]: Evento enviado, esperando respuesta...`);
                    
                    // Esperar 1.5 segundos para que el servidor procese
                    await new Promise(resolve => setTimeout(resolve, 1500));
                    
                    // El servidor emitirá duelo:redirigirASala, que ya está escuchado arriba
                    // Si no llega en 3 segundos, redirigir manualmente
                    setTimeout(() => {
                        if (window.location.pathname !== `/competitivo/sala/${salaIdRecibida}`) {
                            console.log(`[REDIRECT MANUAL]: Redirigiendo a sala ${salaIdRecibida}`);
                            window.location.href = `/competitivo/sala/${salaIdRecibida}`;
                        }
                    }, 3000);
                } else {
                    throw new Error('Socket no está conectado');
                }
            }
            // Manejo para invitaciones de minijuegos (código existente)
            else if (data.tipo === 'invitacion') {
                setTimeout(() => {
                    if (data.redirigir) {
                        console.log('[NOTIF]: Redirigiendo a:', data.redirigir);
                        window.location.href = data.redirigir;
                    } else if (salaId) {
                        console.log('[NOTIF]: Redirigiendo a sala:', salaId);
                        window.location.href = `/competitivo/sala/${salaId}`;
                    }
                }, 800);
            }
            // Otros tipos
            else {
                console.log('[NOTIF]: Tipo genérico procesado:', data.tipo);
            }
            
        } else {
            throw new Error(data.message || 'No se pudo aceptar la notificación.');
        }
    } catch (error) {
        console.error("[ACCEPT ERROR]:", error);
        const mensaje = error.message || 'Error al aceptar la invitación';
        if (window.mostrarNotificacionTemporal) {
            window.mostrarNotificacionTemporal('❌ ' + mensaje, 'error');
        }
    }
}

