<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mis Logros e Insignias - QueBuenDato</title>
  
  {{!-- TEMA - IGUAL QUE EN LAS OTRAS VISTAS --}}
  <script>
    const tema = localStorage.getItem('theme');
    if (tema) document.documentElement.setAttribute('data-theme', tema);
  </script>
  
  {{!-- GOOGLE FONTS --}}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  {{!-- FONT AWESOME --}}
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  {{!-- ESTILOS DE LOGROS --}}
  <link rel="stylesheet" href="/css/logros.css">
</head>
<body>
<div class="logros-container">

  <!-- Botón volver -->
  <a class="btn-volver" href="/usuario">
    <i class="fas fa-arrow-left"></i> Volver a mi perfil
  </a>

  <!-- Header con progreso - AHORA USA LA CLASE CORRECTA -->
  <div class="logros-header">  <!-- 👈 CAMBIADO DE "page-header" a "logros-header" -->
    <div class="header-content">
      <i class="fas fa-trophy header-icon"></i>
      <h1>Mis Logros e Insignias</h1>
    </div>
    
    <div class="progreso-general">
      <div class="progreso-label">
        <span>Progreso total</span>
        <span>{{stats.logros_desbloqueados}} / {{stats.total_logros}} ({{stats.porcentaje}}%)</span>
      </div>
      <div class="progreso-bar">
        <div class="progreso-fill" id="barraProgreso" style="width: 0%;"></div>
      </div>
    </div>
  </div>

  <!-- Stats rápidos -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-valor">{{stats.logros_desbloqueados}}</div>
      <div class="stat-label">Logros</div>
    </div>
    <div class="stat-card">
      <div class="stat-valor">{{stats.total_logros}}</div>
      <div class="stat-label">Disponibles</div>
    </div>
    <div class="stat-card">
      <div class="stat-valor">{{stats.insignias_desbloqueadas}}</div>
      <div class="stat-label">Insignias</div>
    </div>
    <div class="stat-card">
      <div class="stat-valor">{{stats.total_insignias}}</div>
      <div class="stat-label">Totales</div>
    </div>
  </div>

  <!-- Sección de Insignias -->
  <div class="seccion">
    <h2 class="seccion-titulo">
      <i class="fas fa-medal"></i>
      Mis Insignias
    </h2>

    {{#if insignias}}
      <div class="insignias-grid">
        {{#each insignias}}
          <div class="insignia-card {{this.rareza}} {{#unless this.desbloqueada}}bloqueada{{/unless}}"
               title="{{this.nombre}}: {{this.descripcion}}">
            {{#if this.equipada}}
              <span class="equipada-badge">Equipada</span>
            {{/if}}
            <img src="{{this.imagen}}" alt="{{this.nombre}}" class="insignia-imagen">
            <div class="insignia-nombre">{{this.nombre}}</div>
            <div class="insignia-rareza">{{this.rareza}}</div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="sin-items">
        <i class="fas fa-medal"></i>
        <p>No hay insignias disponibles</p>
      </div>
    {{/if}}
  </div>

  <!-- Sección de Logros -->
  <div class="seccion">
    <h2 class="seccion-titulo">
      <i class="fas fa-trophy"></i>
      Todos los Logros
    </h2>

    {{#if logros}}
      <div class="logros-lista">
        {{#each logros}}
          <div class="logro-item {{#if this.desbloqueado}}desbloqueado{{else}}bloqueado{{/if}}">
            <div class="logro-icono">{{{this.icono}}}</div>
            
            <div class="logro-info">
              <div class="logro-nombre">{{this.nombre}}</div>
              <div class="logro-descripcion">{{this.descripcion}}</div>
              
              <div class="logro-metadata">
                <span class="logro-categoria">{{this.categoria}}</span>
                {{#if this.puntos_bonus}}
                  <span class="logro-bonus">
                    <i class="fas fa-star"></i> +{{this.puntos_bonus}} pts
                  </span>
                {{/if}}
              </div>
            </div>
            
            <div class="logro-estado">
              {{#if this.desbloqueado}}
                <span class="logro-fecha">{{formatDate this.fecha_desbloqueo}}</span>
                <span class="logro-check">✅</span>
              {{else}}
                <span class="logro-check">🔒</span>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="sin-items">
        <i class="fas fa-trophy"></i>
        <p>Aún no hay logros. ¡Sigue jugando!</p>
      </div>
    {{/if}}
  </div>

</div>

<script>
  // Solo la animación de la barra de progreso
  document.addEventListener('DOMContentLoaded', () => {
    const pct = {{stats.porcentaje}};
    setTimeout(() => {
      const barra = document.getElementById('barraProgreso');
      if (barra) barra.style.width = pct + '%';
    }, 200);
  });
</script>
</body>
</html>