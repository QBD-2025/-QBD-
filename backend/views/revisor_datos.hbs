<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Revisión de Datos Curiosos</title>
    <link rel="stylesheet" href="/css/revisor.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <div class="dashboard-container">
        <div class="table-container">
            <div class="table-header">
                <h3 class="table-title">
                    <i class="fas fa-database"></i> Datos Curiosos Pendientes de Revisión
                </h3>
                <p style="color: #666; margin-top: 10px;">
                    Total: <strong>{{datos.length}}</strong> datos esperando revisión
                </p>
            </div>
            
            {{#if datos.length}}
            <div class="datos-revision-grid">
                {{#each datos}}
                <div class="dato-card">
                    <div class="dato-header">
                        <span class="dato-id">ID: {{id_dato}}</span>
                        <span class="dato-materia">{{nombre_materia}}</span>
                    </div>
                    
                    <div class="dato-contenido">
                        <div class="dato-texto">
                            <i class="fas fa-info-circle" style="color: #007bff; margin-right: 8px;"></i>
                            {{dato}}
                        </div>
                        
                        {{#if fuente}}
                        <div class="dato-fuente">
                            <strong>Fuente:</strong> {{fuente}}
                        </div>
                        {{/if}}
                        
                        {{#if imagen}}
                        <div class="dato-imagen">
                            <img src="/editor/datos/imagen/{{id_dato}}" alt="Imagen del dato" style="max-width: 100%; border-radius: 8px; margin-top: 10px;">
                        </div>
                        {{else}}
                        <div class="dato-sin-imagen">
                            <i class="fas fa-image" style="color: #ccc;"></i> Sin imagen
                        </div>
                        {{/if}}
                    </div>
                    
                    <div class="dato-acciones">
                        <button class="btn-action btn-aprobar" data-id="{{id_dato}}" data-tipo="dato">
                            <i class="fas fa-check"></i> Aprobar y Publicar
                        </button>
                        <button class="btn-action btn-rechazar" data-id="{{id_dato}}" data-tipo="dato">
                            <i class="fas fa-times"></i> Rechazar y Eliminar
                        </button>
                    </div>
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="empty-state">
                <div class="empty-state-icon">
                    <i class="fas fa-check-double"></i>
                </div>
                <h4 class="empty-state-title">¡Excelente trabajo!</h4>
                <p class="empty-state-description">No hay datos curiosos pendientes de revisión.</p>
                <a href="/revisor" class="revisor-btn" style="margin-top: 20px;">Volver al Panel</a>
            </div>
            {{/if}}
        </div>
    </div>

    <!-- Modal de confirmación -->
    <div id="modal-confirmacion" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 20px rgba(0,0,0,0.3); z-index: 1001; min-width: 400px;">
        <h3 id="modal-titulo" style="margin-bottom: 15px; color: #333;">¿Confirmar acción?</h3>
        <p id="modal-mensaje" style="color: #666; margin-bottom: 20px;"></p>
        <div style="display: flex; gap: 10px; justify-content: flex-end;">
            <button id="modal-cancelar" class="revisor-btn" style="background: #6c757d;">Cancelar</button>
            <button id="modal-confirmar" class="revisor-btn">Confirmar</button>
        </div>
    </div>
    <div id="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000;"></div>

    <script src="/public/js/revisor.controller.js"></script>
</body>
</html>